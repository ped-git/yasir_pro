<!DOCTYPE html>
<html lang="ar" dir="rtl"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>البقرة</title>
    <link rel="stylesheet" href="../fonts.css">
    <link rel="stylesheet" href="Style_CSS/002_CSS.css">
  </head>

  <body>

    <div style="font-size:9.0mm;
      margin-top:-4mm;
      margin-right:10mm;
      margin-bottom:4.5mm;
      margin-left:10mm;
      text-align:center;
      background-color: rgb(220,220,220);
      font-weight: bold;
      line-height:150%;">
      البقرة
    </div>

    <p style="margin-top:0mm;margin-right:10mm;margin-bottom:0.0mm;margin-left:10mm;text-align:center;">
      بِسْمِ اللَّهِ الرَّحْمَـٰنِ الرَّحِيمِ
    </p>

    <div class="container">
      <div class="diamond-marker top-2"></div>
      <div class="vertical-line-2"></div>
      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <!-- Aya 1 -->
        <div class="ordinary-far">
          الم<sup>۱</sup>
          ذَٰلِكَ الْكِتَابُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًى لِّلْمُتَّقِينَ<sup>۲</sup>

          <div class="inner-paragraph-1">
            <!-- Aya 3 -->
            <p class="zero-margin">
              الَّذِينَ <span style="margin-right: 10mm;"></span><span class="boxed underline-black-1">يُؤْمِنُونَ بِالْغَيْبِ</span> وَ<span class="boxed underline-black-1">يُقِيمُونَ الصَّلَاةَ</span> وَ<span class="boxed underline-black-1">مِمَّا رَزَقْنَاهُمْ يُنفِقُونَ</span><sup>۳</sup>
            </p>

            <!-- Aya 4 -->
            <p class="zero-margin">
              وَالَّذِينَ <span style="margin-right: 8.1mm;"></span><span class="boxed underline-black-far">يُؤْمِنُونَ بِ<span class="boxed underline-black-3">مَا أُنزِلَ إِلَيْكَ</span> وَ<span class="boxed underline-black-3">مَا أُنزِلَ مِن قَبْلِكَ</span></span> وَ<span class="boxed underline-black-far">بِ<span class="highlight6">الْآخِرَةِ</span> هُمْ يُوقِنُونَ</span><sup>۴</sup>
            </p>

            <p class="zero-margin">
              أُولَـٰئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْ ۖ
            </p>

            <!-- Aya 5 -->
            <p class="zero-margin">
              وَأُولَـٰئِكَ هُمُ الْمُفْلِحُونَ<sup>۵</sup>
            </p>
          </div>
        </div>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <!-- Aya 6 -->
        <p class="ordinary-far">
          إِنَّ الَّذِينَ كَفَرُوا سَوَاءٌ عَلَيْهِمْ أَ<span class="boxed underline-blackdashed2">أَنذَرْتَهُمْ</span> أَمْ <span class="boxed underline-blackdashed2">لَمْ تُنذِرْهُمْ</span> لَا يُؤْمِنُونَ<sup>۶</sup>
          <span class="boxed underline-blackdotted-far">خَتَمَ اللَّهُ <span class="boxed underline-blackdotted">عَلَىٰ قُلُوبِهِمْ</span> وَ<span class="boxed underline-blackdotted">عَلَىٰ سَمْعِهِمْ</span></span> ۖ وَ<span class="boxed underline-blackdotted">عَلَىٰ أَبْصَارِهِمْ غِشَاوَةٌ</span> ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ<sup>۷</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <!-- Aya 8 -->
        <p class="ordinary-near">
          وَمِنَ النَّاسِ مَن يَقُولُ <speech open="" red=""></speech>آمَنَّا <span class="boxed underline-black-2">بِاللَّهِ</span> وَ<span class="boxed underline-black-2">بِالْيَوْمِ الْآخِرِ</span><speech close="" red=""></speech> وَمَا هُم بِمُؤْمِنِينَ<sup>۸</sup>
          يُخَادِعُونَ <span class="boxed underline-black-3">اللَّهَ</span> وَ<span class="boxed underline-black-3">الَّذِينَ آمَنُوا</span> وَمَا يَخْدَعُونَ إِلَّا أَنفُسَهُمْ وَمَا يَشْعُرُونَ<sup>۹</sup>
          فِي قُلُوبِهِم مَّرَضٌ فَزَادَهُمُ اللَّهُ مَرَضًا ۖ وَلَهُمْ عَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْذِبُونَ<sup>۱۰</sup>
        </p>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
              وَإِذَا قِيلَ لَهُمْ <speech open="" green=""></speech>لَا تُفْسِدُوا فِي الْأَرْضِ<speech close="" green=""></speech>
            </p>

            <!-- Aya 11 -->
            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
              قَالُوا <speech open="" red=""></speech>إِنَّمَا نَحْنُ مُصْلِحُونَ<speech close="" red=""></speech><sup>۱۱</sup>
            </p>

            <!-- Aya 12 -->
            <p class="zero-margin">
              أَلَا إِنَّهُمْ هُمُ الْمُفْسِدُونَ وَلَـٰكِن لَّا يَشْعُرُونَ<sup>۱۲</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
              وَإِذَا قِيلَ لَهُمْ <speech open="" green=""></speech>آمِنُوا كَمَا آمَنَ النَّاسُ<speech close="" green=""></speech>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
              قَالُوا <speech open="" red=""></speech>أَنُؤْمِنُ كَمَا آمَنَ السُّفَهَاءُ<speech close="" red=""></speech> ۗ
            </p>

            <!-- Aya 13 -->
            <p class="zero-margin">
              أَلَا إِنَّهُمْ هُمُ السُّفَهَاءُ وَلَـٰكِن لَّا يَعْلَمُونَ<sup>۱۳</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin">
              وَإِذَا لَقُوا الَّذِينَ آمَنُوا
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
              قَالُوا <speech open="" red=""></speech>آمَنَّا<speech close="" red=""></speech>
            </p>

            <p class="zero-margin">
              وَإِذَا خَلَوْا إِلَىٰ شَيَاطِينِهِمْ
            </p>

            <!-- Aya 14 -->
            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
              قَالُوا <speech open="" red=""></speech>إِنَّا مَعَكُمْ إِنَّمَا نَحْنُ مُسْتَهْزِئُونَ<speech close="" red=""></speech><sup>۱۴</sup>
            </p>

            <!-- Aya 15 -->
            <p class="zero-margin">
              اللَّهُ <span class="boxed underline-blackdashed2">يَسْتَهْزِئُ بِهِمْ</span> وَ<span class="boxed underline-blackdashed2">يَمُدُّهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ</span><sup>۱۵</sup>
            </p>
          </div>
        </div>

        <!-- Aya 16 -->
        <p class="ordinary-near">
          أُولَـٰئِكَ الَّذِينَ اشْتَرَوُا الضَّلَالَةَ بِالْهُدَىٰ فَ<span class="boxed underline-blackdotted">مَا رَبِحَت تِّجَارَتُهُمْ</span> وَ<span class="boxed underline-blackdotted">مَا كَانُوا مُهْتَدِينَ</span><sup>۱۶</sup>
        </p>

        <div class="ordinary-far">
          مَثَلُهُمْ
          <span style="margin-right: 8.0mm;"></span>

          <div class="inner-paragraph-2">
            <!-- Aya 17 -->
            <p class="zero-margin6">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              كَمَثَلِ الَّذِي اسْتَوْقَدَ نَارًا فَلَمَّا أَضَاءَتْ مَا حَوْلَهُ ذَهَبَ اللَّهُ بِنُورِهِمْ وَتَرَكَهُمْ فِي ظُلُمَاتٍ لَّا يُبْصِرُونَ<sup>۱۷</sup>
              <span class="boxed underline-blackdotted">صُمٌّ</span>
              <span class="boxed underline-blackdotted">بُكْمٌ</span>
              <span class="boxed underline-blackdotted">عُمْيٌ</span> فَهُمْ لَا يَرْجِعُونَ<sup>۱۸</sup>
            </p>

            <!-- Aya 19 -->
            <p class="zero-margin6">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              أَوْ كَصَيِّبٍ مِّنَ السَّمَاءِ فِيهِ <span class="boxed underline-blackdashed2">ظُلُمَاتٌ</span> وَ<span class="boxed underline-blackdashed2">رَعْدٌ</span> وَ<span class="boxed underline-blackdashed2">بَرْقٌ</span> يَجْعَلُونَ أَصَابِعَهُمْ فِي آذَانِهِم مِّنَ الصَّوَاعِقِ حَذَرَ الْمَوْتِ ۚ وَاللَّهُ مُحِيطٌ بِالْكَافِرِينَ<sup>۱۹</sup>
              يَكَادُ الْبَرْقُ يَخْطَفُ أَبْصَارَهُمْ ۖ <span class="boxed underline-blackdashed">كُلَّمَا أَضَاءَ لَهُم مَّشَوْا فِيهِ</span> وَ<span class="boxed underline-blackdashed">إِذَا أَظْلَمَ عَلَيْهِمْ قَامُوا</span> ۚ وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِ<span class="boxed underline-blackdotted">سَمْعِهِمْ</span> وَ<span class="boxed underline-blackdotted">أَبْصَارِهِمْ</span> ۚ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<sup>۲۰</sup>
            </p>
          </div>
        </div>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="big-bullet-far">
        <span style="font-size:5.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">H </span><span> </span>
        يَا أَيُّهَا النَّاسُ

        <div class="inner-paragraph-3">
          <div class="container">
            <div class="vertical-line-inside"></div>
            <div class="zero-margin3">
              اعْبُدُوا رَبَّكُمُ

              <div class="inner-paragraph-4">
                <!-- Aya 21 -->
                <p class="zero-margin2">
                  الَّذِي خَلَقَكُمْ وَالَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ<sup>۲۱</sup>
                </p>

                <!-- Aya 22 -->
                <p class="zero-margin2">
                  الَّذِي جَعَلَ لَكُمُ الْأَرْضَ فِرَاشًا وَالسَّمَاءَ بِنَاءً وَأَنزَلَ مِنَ السَّمَاءِ مَاءً فَأَخْرَجَ بِهِ مِنَ الثَّمَرَاتِ رِزْقًا لَّكُمْ ۖ فَلَا تَجْعَلُوا لِلَّهِ أَندَادًا وَأَنتُمْ تَعْلَمُونَ<sup>۲۲</sup>
                </p>
              </div>
            </div>

            <div class="zero-margin3">
              وَإِن كُنتُمْ فِي رَيْبٍ مِّمَّا نَزَّلْنَا عَلَىٰ عَبْدِنَا فَأْتُوا بِسُورَةٍ مِّن مِّثْلِهِ وَادْعُوا شُهَدَاءَكُم مِّن دُونِ اللَّهِ إِن كُنتُمْ صَادِقِينَ<sup>۲۳</sup>
              فَإِن لَّمْ تَفْعَلُوا وَلَن تَفْعَلُوا <span class="boxed underline-solidred">فَاتَّقُوا النَّارَ الَّتِي وَقُودُهَا النَّاسُ وَالْحِجَارَةُ ۖ أُعِدَّتْ لِلْكَافِرِينَ</span><sup>۲۴</sup>
              <span class="boxed underline-solidgreen">وَبَشِّرِ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أَنَّ لَهُمْ جَنَّاتٍ تَجْرِي مِن تَحْتِهَا الْأَنْهَارُ ۖ كُلَّمَا رُزِقُوا مِنْهَا مِن ثَمَرَةٍ رِّزْقًا ۙ
                قَالُوا <speech open="" green=""></speech>هَـٰذَا الَّذِي رُزِقْنَا مِن قَبْلُ<speech close="" green=""></speech> ۖ
                وَأُتُوا بِهِ مُتَشَابِهًا ۖ وَلَهُمْ فِيهَا أَزْوَاجٌ مُّطَهَّرَةٌ ۖ وَهُمْ فِيهَا خَالِدُونَ<sup>۲۵</sup></span>

              <div class="zero-margin">
                إِنَّ اللَّهَ لَا يَسْتَحْيِي أَن يَضْرِبَ مَثَلًا مَّا بَعُوضَةً فَمَا فَوْقَهَا ۚ

                <p class="zero-margin4">
                  <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
                  <span class="boxed underline-green">
                  فَأَمَّا الَّذِينَ آمَنُوا <span style="margin-left: 20mm;"></span>فَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِن رَّبِّهِمْ ۖ
                  </span>
                </p>

                <p class="zero-margin4">
                  <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
                  <span class="boxed underline-red">وَأَمَّا الَّذِينَ كَفَرُوا <span style="margin-left: 16mm;"></span>فَيَقُولُونَ <speech open="" red=""></speech>مَاذَا أَرَادَ اللَّهُ بِهَـٰذَا مَثَلًا<speech close="" red=""></speech> ۘ </span>
                </p>
              </div>

              <!-- Aya 26 -->
              <p class="zero-margin">
                <span class="boxed underline-blackdashed">يُضِلُّ بِهِ كَثِيرًا</span>
                وَ<span class="boxed underline-blackdashed">يَهْدِي بِهِ كَثِيرًا</span> ۚ وَمَا يُضِلُّ بِهِ إِلَّا الْفَاسِقِينَ<sup>۲۶</sup>
                الَّذِينَ <span class="boxed underline-blackdotted">يَنقُضُونَ عَهْدَ اللَّهِ مِن بَعْدِ مِيثَاقِهِ</span> وَ<span class="boxed underline-blackdotted">يَقْطَعُونَ مَا أَمَرَ اللَّهُ بِهِ أَن يُوصَلَ</span> وَ<span class="boxed underline-blackdotted">يُفْسِدُونَ فِي الْأَرْضِ</span> ۚ أُولَـٰئِكَ هُمُ الْخَاسِرُونَ<sup>۲۷</sup>
              </p>
            </div>

            <!-- Aya 28 -->
            <p class="zero-margin3">
              كَيْفَ تَكْفُرُونَ بِاللَّهِ وَكُنتُمْ أَمْوَاتًا فَ<span class="boxed underline-gradient">أَحْيَاكُمْ</span> ۖ ثُمَّ <span class="boxed underline-gradient">يُمِيتُكُمْ</span> ثُمَّ <span class="boxed underline-gradient">يُحْيِيكُمْ</span> ثُمَّ <span class="boxed underline-gradient">إِلَيْهِ تُرْجَعُونَ</span><sup>۲۸</sup>
            </p>
          </div>
        </div>
      </div>

      <div class="diamond-marker bottom-2"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-2"></div>
      <div class="vertical-line-2"></div>
      <!-- Aya 29 -->
      <p class="ordinary-far">
        هُوَ الَّذِي خَلَقَ لَكُم مَّا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ ۚ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ<sup>۲۹</sup>
      </p>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
              وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ <speech open="" blue=""></speech>إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً<speech close="" blue=""></speech> ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">v </span>
              قَالُوا <speech open="" blue=""></speech>أَتَجْعَلُ فِيهَا مَن <span class="boxed underline-blackdotted">يُفْسِدُ فِيهَا</span> وَ<span class="boxed underline-blackdotted">يَسْفِكُ الدِّمَاءَ</span> وَنَحْنُ <span class="boxed underline-black-3">نُسَبِّحُ بِحَمْدِكَ</span> وَ<span class="boxed underline-black-3">نُقَدِّسُ لَكَ</span><speech close="" blue=""></speech> ۖ
            </p>

            <!-- Aya 30 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span>
              قَالَ <speech open="" blue=""></speech>إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ<speech close="" blue=""></speech><sup>۳۰</sup>
            </p>

            <p class="zero-margin">
              وَعَلَّمَ آدَمَ الْأَسْمَاءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى الْمَلَائِكَةِ
            </p>

            <!-- Aya 31 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span>
              فَقَالَ <speech open="" blue=""></speech>أَنبِئُونِي بِأَسْمَاءِ هَـٰؤُلَاءِ إِن كُنتُمْ صَادِقِينَ<speech close="" blue=""></speech><sup>۳۱</sup>
            </p>

            <!-- Aya 32 -->
            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">v </span>
              قَالُوا <speech open="" blue=""></speech>سُبْحَانَكَ لَا عِلْمَ لَنَا إِلَّا مَا عَلَّمْتَنَا ۖ إِنَّكَ أَنتَ الْعَلِيمُ الْحَكِيمُ<speech close="" blue=""></speech><sup>۳۲</sup>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span>
              قَالَ <speech open="" blue=""></speech>يَا آدَمُ أَنبِئْهُم بِأَسْمَائِهِمْ<speech close="" blue=""></speech> ۖ
            </p>

            <p class="zero-margin">
              فَلَمَّا أَنبَأَهُم بِأَسْمَائِهِمْ
            </p>

            <!-- Aya 33 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span>
              قَالَ <speech open="" blue=""></speech>أَلَمْ أَقُل لَّكُمْ <speech open="" blue=""></speech>إِنِّي <span class="boxed underline-gradient">أَعْلَمُ</span> غَيْبَ <span class="boxed underline-black-3">السَّمَاوَاتِ</span> وَ<span class="boxed underline-black-3">الْأَرْضِ</span> وَ<span class="boxed underline-gradient">أَعْلَمُ</span> <span class="boxed underline-black-3">مَا تُبْدُونَ</span> وَ<span class="boxed underline-black-3">مَا كُنتُمْ تَكْتُمُونَ</span><speech close="" blue=""></speech><speech close="" blue=""></speech><sup>۳۳</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-far">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              وَإِذْ قُلْنَا لِلْمَلَائِكَةِ <speech open="" blue=""></speech>اسْجُدُوا لِآدَمَ<speech close="" blue=""></speech>
            </p>

            <!-- Aya 34 -->
            <p class="zero-margin">
              فَسَجَدُوا إِلَّا إِبْلِيسَ <span class="boxed underline-blackdotted">أَبَىٰ</span> وَ<span class="boxed underline-blackdotted">اسْتَكْبَرَ</span> وَ<span class="boxed underline-blackdotted">كَانَ مِنَ الْكَافِرِينَ</span><sup>۳۴</sup>
            </p>

            <!-- Aya 35 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              وَقُلْنَا <speech open="" blue=""></speech>يَا آدَمُ <span class="boxed underline-gradient">اسْكُنْ</span> <span class="boxed underline-black-3">أَنتَ</span> وَ<span class="boxed underline-black-3">زَوْجُكَ</span> الْجَنَّةَ وَ<span class="boxed underline-gradient">كُلَا</span> مِنْهَا رَغَدًا حَيْثُ شِئْتُمَا وَ<span class="boxed underline-gradient">لَا تَقْرَبَا</span> هَـٰذِهِ الشَّجَرَةَ فَتَكُونَا مِنَ الظَّالِمِينَ<speech close="" blue=""></speech><sup>۳۵</sup>
            </p>

            <p class="zero-margin">
              فَأَزَلَّهُمَا الشَّيْطَانُ عَنْهَا فَأَخْرَجَهُمَا مِمَّا كَانَا فِيهِ ۖ
            </p>

            <!-- Aya 36 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              وَقُلْنَا <speech open="" blue=""></speech>اهْبِطُوا بَعْضُكُمْ لِبَعْضٍ عَدُوٌّ ۖ وَلَكُمْ فِي الْأَرْضِ <span class="boxed underline-blackdashed">مُسْتَقَرٌّ</span> وَ<span class="boxed underline-blackdashed">مَتَاعٌ <span class="boxed underline-notsure">إِلَىٰ حِينٍ</span></span><speech close="" blue=""></speech><sup>۳۶</sup>
            </p>

            <!-- Aya 37 -->
            <p class="zero-margin">
              فَتَلَقَّىٰ آدَمُ مِن رَّبِّهِ كَلِمَاتٍ فَتَابَ عَلَيْهِ ۚ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ<sup>۳۷</sup>
            </p>

            <!-- Aya 38 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              قُلْنَا <speech open="" blue=""></speech>اهْبِطُوا مِنْهَا جَمِيعًا ۖ فَإِمَّا يَأْتِيَنَّكُم مِّنِّي هُدًى فَ<span class="boxed underline-solidgreen-far">مَن تَبِعَ هُدَايَ فَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span></span><sup>۳۸</sup>
              <span class="boxed underline-solidred-far">وَالَّذِينَ <span class="boxed underline-blackdotted">كَفَرُوا</span> وَ<span class="boxed underline-blackdotted">كَذَّبُوا</span> بِآيَاتِنَا أُولَـٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ</span><speech close="" blue=""></speech><sup>۳۹</sup>
            </p>
          </div>
        </div>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="diamond-marker bottom-2"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-2"></div>
      <div class="vertical-line-2"></div>
      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <div class="big-bullet-far">
          <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">f </span><span> </span>
          يَا بَنِي إِسْرَائِيلَ

          <div class="inner-paragraph-6">
            <div class="container">
              <div class="vertical-line-inside"></div>
              <!-- Aya 40 -->
              <p class="zero-margin5">
                <span class="boxed underline-gradient">اذْكُرُوا</span> نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَ<span class="boxed underline-gradient">أَوْفُوا</span> بِعَهْدِي أُوفِ بِعَهْدِكُمْ وَإِيَّايَ <span class="boxed underline-gradientrev">فَارْهَبُونِ</span><sup>۴۰</sup>
              </p>

              <!-- Aya 41 -->
              <p class="zero-margin5">
                وَ<span class="boxed underline-gradient">آمِنُوا</span> بِمَا أَنزَلْتُ مُصَدِّقًا لِّمَا مَعَكُمْ وَ<span class="boxed underline-gradient">لَا تَكُونُوا</span> أَوَّلَ كَافِرٍ بِهِ ۖ وَ<span class="boxed underline-gradient">لَا تَشْتَرُوا</span> بِآيَاتِي ثَمَنًا قَلِيلًا وَإِيَّايَ <span class="boxed underline-gradientrev">فَاتَّقُونِ</span><sup>۴۱</sup>
                وَ<span class="boxed underline-gradient">لَا تَلْبِسُوا</span> الْحَقَّ بِالْبَاطِلِ وَتَكْتُمُوا الْحَقَّ وَأَنتُمْ تَعْلَمُونَ<sup>۴۲</sup>
              </p>

              <!-- Aya 43 -->
              <p class="zero-margin5">
                <span class="highlight12">وَ<span class="boxed underline-gradient">أَقِيمُوا</span> الصَّلَاةَ وَ<span class="boxed underline-gradient">آتُوا</span> الزَّكَاةَ</span> وَ<span class="boxed underline-gradient">ارْكَعُوا</span> مَعَ الرَّاكِعِينَ<sup>۴۳</sup>
                أَتَأْمُرُونَ النَّاسَ بِالْبِرِّ وَتَنسَوْنَ أَنفُسَكُمْ وَأَنتُمْ تَتْلُونَ الْكِتَابَ ۚ أَفَلَا تَعْقِلُونَ<sup>۴۴</sup>
              </p>

              <!-- Aya 45 -->
              <p class="zero-margin5">
                <span class="highlight1">وَ<span class="boxed underline-gradient">اسْتَعِينُوا</span> بِ<span class="boxed underline-black-2">الصَّبْرِ</span> وَ<span class="boxed underline-black-2">الصَّلَاةِ</span></span> ۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى الْخَاشِعِينَ<sup>۴۵</sup>
                الَّذِينَ يَظُنُّونَ <span class="boxed underline-gradientsym">أَنَّهُم</span> <span class="boxed underline-black-3">مُّلَاقُو رَبِّهِمْ</span> وَ<span class="boxed underline-gradientsym">أَنَّهُمْ</span> <span class="boxed underline-black-3">إِلَيْهِ رَاجِعُونَ</span><sup>۴۶</sup>
              </p>
            </div>
          </div>
        </div>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <!-- Aya 47 -->
        <p class="big-bullet-far">
          <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">f </span><span> </span>
          <span style="filter: invert(60%);">يَا بَنِي إِسْرَائِيلَ</span> <span class="boxed underline-gradient"><span style="filter: invert(60%);">اذْكُرُوا</span></span> <span style="filter: invert(60%);">نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَنِّي فَضَّلْتُكُمْ عَلَى الْعَالَمِينَ<sup>۴۷</sup>
          وَ</span><span class="boxed underline-gradient"><span style="filter: invert(60%);">اتَّقُوا</span></span> <span style="filter: invert(60%);">يَوْمًا</span> <span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَّا تَجْزِي نَفْسٌ عَن نَّفْسٍ شَيْئًا</span></span> 
          <span style="filter: invert(60%);">وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا يُقْبَلُ مِنْهَا شَفَاعَةٌ</span></span> <span style="filter: invert(60%);">وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا يُؤْخَذُ مِنْهَا عَدْلٌ</span></span> 
          <span style="filter: invert(60%);">وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا هُمْ يُنصَرُونَ</span></span><sup><span style="filter: invert(60%);">۴۸</span></sup>
        </p>

        <!-- Aya 49 -->
        <p class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
          وَإِذْ نَجَّيْنَاكُم مِّنْ آلِ فِرْعَوْنَ يَسُومُونَكُمْ سُوءَ الْعَذَابِ <span class="boxed underline-blackdotted">يُذَبِّحُونَ أَبْنَاءَكُمْ</span> وَ<span class="boxed underline-blackdotted">يَسْتَحْيُونَ نِسَاءَكُمْ</span> ۚ وَفِي ذَٰلِكُم بَلَاءٌ مِّن رَّبِّكُمْ عَظِيمٌ<sup>۴۹</sup>
        </p>

        <!-- Aya 50 -->
        <p class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
          وَإِذْ فَرَقْنَا بِكُمُ الْبَحْرَ فَ<span class="boxed underline-blackdashed">أَنجَيْنَاكُمْ</span> وَ<span class="boxed underline-blackdashed">أَغْرَقْنَا آلَ فِرْعَوْنَ</span> وَأَنتُمْ تَنظُرُونَ<sup>۵۰</sup>
        </p>

        <!-- Aya 51 -->
        <p class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
          وَإِذْ وَاعَدْنَا مُوسَىٰ أَرْبَعِينَ لَيْلَةً ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِن بَعْدِهِ وَأَنتُمْ ظَالِمُونَ<sup>۵۱</sup>
          ثُمَّ عَفَوْنَا عَنكُم مِّن بَعْدِ ذَٰلِكَ لَعَلَّكُمْ تَشْكُرُونَ<sup>۵۲</sup>
        </p>

        <!-- Aya 53 -->
        <p class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
          وَإِذْ آتَيْنَا مُوسَى <span class="boxed underline-black-2">الْكِتَابَ</span> وَ<span class="boxed underline-black-2">الْفُرْقَانَ</span> لَعَلَّكُمْ تَهْتَدُونَ<sup>۵۳</sup>
        </p>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <!-- Aya 54 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ <speech open="" green=""></speech>يَا قَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنفُسَكُم بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَىٰ بَارِئِكُمْ فَاقْتُلُوا أَنفُسَكُمْ ذَٰلِكُمْ خَيْرٌ لَّكُمْ عِندَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْ ۚ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ<speech close="" green=""></speech><sup>۵۴</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">q </span><span> </span>
              وَإِذْ قُلْتُمْ <speech open="" red=""></speech>يَا مُوسَىٰ لَن نُّؤْمِنَ لَكَ حَتَّىٰ نَرَى اللَّهَ جَهْرَةً<speech close="" red=""></speech>
            </p>

            <!-- Aya 55 -->
            <p class="zero-margin">
              فَأَخَذَتْكُمُ الصَّاعِقَةُ وَأَنتُمْ تَنظُرُونَ<sup>۵۵</sup>
              ثُمَّ بَعَثْنَاكُم مِّن بَعْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُرُونَ<sup>۵۶</sup>
              وَ<span class="boxed underline-gradient">ظَلَّلْنَا</span> عَلَيْكُمُ الْغَمَامَ وَ<span class="boxed underline-gradient">أَنزَلْنَا</span> عَلَيْكُمُ <span class="boxed underline-blackdashed">الْمَنَّ</span> وَ<span class="boxed underline-blackdashed">السَّلْوَىٰ</span> ۖ <speech open="" blue="" underline=""></speech>كُلُوا مِن طَيِّبَاتِ مَا رَزَقْنَاكُمْ<speech close="" blue="" underline=""></speech> ۖ وَمَا ظَلَمُونَا وَلَـٰكِن كَانُوا أَنفُسَهُمْ يَظْلِمُونَ<sup>۵۷</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <!-- Aya 58 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              وَإِذْ قُلْنَا <speech open="" blue=""></speech>ادْخُلُوا هَـٰذِهِ الْقَرْيَةَ فَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ رَغَدًا وَ<span class="boxed underline-gradient">ادْخُلُوا</span> الْبَابَ سُجَّدًا وَ<span class="boxed underline-gradient">قُولُوا</span> حِطَّةٌ <span class="boxed underline-gradientrev">نَّغْفِرْ</span> لَكُمْ خَطَايَاكُمْ ۚ وَ<span class="boxed underline-gradientrev">سَنَزِيدُ</span> الْمُحْسِنِينَ<speech close="" blue=""></speech><sup>۵۸</sup>
            </p>

            <!-- Aya 59 -->
            <p class="zero-margin">
              فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَنزَلْنَا عَلَى الَّذِينَ ظَلَمُوا رِجْزًا مِّنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ<sup>۵۹</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin">
              وَإِذِ اسْتَسْقَىٰ مُوسَىٰ لِقَوْمِهِ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              فَقُلْنَا <speech open="" blue=""></speech>اضْرِب بِّعَصَاكَ الْحَجَرَ<speech close="" blue=""></speech> ۖ
            </p>

            <!-- Aya 60 -->
            <p class="zero-margin">
              فَانفَجَرَتْ مِنْهُ اثْنَتَا عَشْرَةَ عَيْنًا ۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَّشْرَبَهُمْ ۖ <speech open="" blue="" underline=""></speech><span class="boxed underline-gradient-far"><span class="boxed underline-gradient">كُلُوا</span> وَ<span class="boxed underline-gradient">اشْرَبُوا</span></span> مِن رِّزْقِ اللَّهِ وَ<span class="boxed underline-gradient-far">لَا تَعْثَوْا</span> فِي الْأَرْضِ مُفْسِدِينَ<speech close="" blue="" underline=""></speech><sup>۶۰</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">q </span><span> </span>
              وَإِذْ قُلْتُمْ <speech open="" red=""></speech>يَا مُوسَىٰ لَن نَّصْبِرَ عَلَىٰ طَعَامٍ وَاحِدٍ فَادْعُ لَنَا رَبَّكَ يُخْرِجْ لَنَا مِمَّا تُنبِتُ الْأَرْضُ مِن <span class="boxed underline-blackdashed2">بَقْلِهَا</span> وَ<span class="boxed underline-blackdashed2">قِثَّائِهَا</span> وَ<span class="boxed underline-blackdashed2">فُومِهَا</span> وَ<span class="boxed underline-blackdashed2">عَدَسِهَا</span> وَ<span class="boxed underline-blackdashed2">بَصَلِهَا</span><speech close="" red=""></speech> ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَىٰ بِالَّذِي هُوَ خَيْرٌ ۚ اهْبِطُوا مِصْرًا فَإِنَّ لَكُم مَّا سَأَلْتُمْ<speech close="" green=""></speech> ۗ
            </p>

            <!-- Aya 61 -->
            <p class="zero-margin">
              وَ<span class="boxed underline-gradient">ضُرِبَتْ</span> عَلَيْهِمُ <span class="boxed underline-blackdashed">الذِّلَّةُ</span> وَ<span class="boxed underline-blackdashed">الْمَسْكَنَةُ</span> وَ<span class="boxed underline-gradient">بَاءُوا</span> بِغَضَبٍ مِّنَ اللَّهِ ۗ ذَٰلِكَ بِأَنَّهُمْ كَانُوا <span class="boxed underline-blackdotted2">يَكْفُرُونَ بِآيَاتِ اللَّهِ</span> وَ<span class="boxed underline-blackdotted2">يَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ الْحَقِّ</span> ۗ ذَٰلِكَ بِمَا <span class="boxed underline-blackdotted">عَصَوا</span> وَّ<span class="boxed underline-blackdotted">كَانُوا يَعْتَدُونَ</span><sup>۶۱</sup>
            </p>

            <!-- Aya 62 -->
            <p style="text-align: left; margin-right: 65mm;margin-top: 0mm;margin-bottom: 0mm;margin-left: 0mm;">
              إِنَّ <span class="boxed underline-blackdashed-far">الَّذِينَ <span class="boxed underline-blackdashed">آمَنُوا</span></span> وَ<span class="boxed underline-blackdashed-far">الَّذِينَ <span class="boxed underline-blackdashed">هَادُوا</span> وَ<span class="boxed underline-blackdashed">النَّصَارَىٰ</span> وَ<span class="boxed underline-blackdashed">الصَّابِئِينَ</span></span><span class="boxed underline-blackdashed"></span> مَنْ<span class="boxed underline-black-far"> آمَنَ بِ<span class="boxed underline-black-1">اللَّهِ</span> وَ<span class="boxed underline-black-1">الْيَوْمِ الْآخِرِ</span></span><span class="boxed underline-black-1"></span> وَ<span class="boxed underline-black-far">عَمِلَ صَالِحًا</span> فَ<span class="boxed underline-black-2">لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ</span> وَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span><sup>۶۲</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin">
              وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا فَوْقَكُمُ الطُّورَ
            </p>

            <!-- Aya 63 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed square">l</span> </span><span> </span>
              <speech open="" blue="" underline=""></speech><span class="boxed underline-gradient">خُذُوا</span> مَا آتَيْنَاكُم بِقُوَّةٍ وَ<span class="boxed underline-gradient">اذْكُرُوا</span> مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ<speech close="" blue="" underline=""></speech><sup>۶۳</sup>
            </p>

            <!-- Aya 64 -->
            <p class="zero-margin">
              ثُمَّ تَوَلَّيْتُم مِّن بَعْدِ ذَٰلِكَ ۖ فَلَوْلَا <span class="boxed underline-black-3">فَضْلُ اللَّهِ عَلَيْكُمْ</span> وَ<span class="boxed underline-black-3">رَحْمَتُهُ</span> لَكُنتُم مِّنَ الْخَاسِرِينَ<sup>۶۴</sup>
              وَلَقَدْ عَلِمْتُمُ الَّذِينَ اعْتَدَوْا مِنكُمْ فِي السَّبْتِ
            </p>

            <!-- Aya 65 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              فَقُلْنَا لَهُمْ <speech open="" blue=""></speech>كُونُوا قِرَدَةً خَاسِئِينَ<speech close="" blue=""></speech><sup>۶۵</sup>
            </p>

            <!-- Aya 66 -->
            <p class="zero-margin">
              فَجَعَلْنَاهَا <span class="boxed underline-blackdashed-far">نَكَالًا لِّ<span class="boxed underline-blackdashed2">مَا بَيْنَ يَدَيْهَا</span> وَ<span class="boxed underline-blackdashed2">مَا خَلْفَهَا</span></span> وَ<span class="boxed underline-blackdashed-far">مَوْعِظَةً لِّلْمُتَّقِينَ</span><sup>۶۶</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ <speech open="" green=""></speech>إِنَّ اللَّهَ يَأْمُرُكُمْ أَن تَذْبَحُوا بَقَرَةً<speech close="" green=""></speech> ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">p </span><span> </span>
              قَالُوا <speech open="" red=""></speech>أَتَتَّخِذُنَا هُزُوًا<speech close="" red=""></speech> ۖ
            </p>

            <!-- Aya 67 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>أَعُوذُ بِاللَّهِ أَنْ أَكُونَ مِنَ الْجَاهِلِينَ<speech close="" green=""></speech><sup>۶۷</sup>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">p </span><span> </span>
              قَالُوا <speech open="" red=""></speech>ادْعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِيَ<speech close="" red=""></speech> ۚ
            </p>

            <!-- Aya 68 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>إِنَّهُ يَقُولُ <speech open="" blue=""></speech>إِنَّهَا بَقَرَةٌ <span class="boxed underline-blackdashed2">لَّا فَارِضٌ</span> وَ<span class="boxed underline-blackdashed2">لَا بِكْرٌ</span> عَوَانٌ بَيْنَ ذَٰلِكَ<speech close="" blue=""></speech> ۖ <span class="boxed underline-notsure">فَافْعَلُوا مَا تُؤْمَرُونَ</span><speech close="" green=""></speech><sup>۶۸</sup>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">p </span><span> </span>
              قَالُوا <speech open="" red=""></speech>ادْعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا لَوْنُهَا<speech close="" red=""></speech> ۚ
            </p>

            <!-- Aya 69 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>إِنَّهُ يَقُولُ <speech open="" blue=""></speech>إِنَّهَا بَقَرَةٌ صَفْرَاءُ فَاقِعٌ لَّوْنُهَا تَسُرُّ النَّاظِرِينَ<speech close="" blue=""></speech><speech close="" green=""></speech><sup>۶۹</sup>
            </p>

            <!-- Aya 70 -->
            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">p </span><span> </span>
              قَالُوا <speech open="" red=""></speech>ادْعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِيَ إِنَّ الْبَقَرَ تَشَابَهَ عَلَيْنَا وَإِنَّا إِن شَاءَ اللَّهُ لَمُهْتَدُونَ<speech close="" red=""></speech><sup>۷۰</sup>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>إِنَّهُ يَقُولُ <speech open="" blue=""></speech>إِنَّهَا بَقَرَةٌ <span class="boxed underline-blackdashed2">لَّا ذَلُولٌ تُثِيرُ الْأَرْضَ</span> وَ<span class="boxed underline-blackdashed2">لَا تَسْقِي الْحَرْثَ</span> مُسَلَّمَةٌ لَّا شِيَةَ فِيهَا<speech close="" blue=""></speech><speech close="" green=""></speech> ۚ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">p </span><span> </span>
              قَالُوا <speech open="" red=""></speech>الْآنَ جِئْتَ بِالْحَقِّ<speech close="" red=""></speech> ۚ
            </p>

            <!-- Aya 71 -->
            <p class="zero-margin">
              فَذَبَحُوهَا وَمَا كَادُوا يَفْعَلُونَ<sup>۷۱</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-far">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

          <div class="inner-paragraph-7">
            <!-- Aya 72 -->
            <p class="zero-margin">
              وَإِذْ قَتَلْتُمْ نَفْسًا فَادَّارَأْتُمْ فِيهَا ۖ وَاللَّهُ مُخْرِجٌ مَّا كُنتُمْ تَكْتُمُونَ<sup>۷۲</sup>
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
              فَقُلْنَا <speech open="" blue="" underline=""></speech>اضْرِبُوهُ بِبَعْضِهَا<speech close="" blue="" underline=""></speech> ۚ
            </p>

            <!-- Aya 73 -->
            <p class="zero-margin">
              كَذَٰلِكَ يُحْيِي اللَّهُ الْمَوْتَىٰ وَيُرِيكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ<sup>۷۳</sup>
            </p>
          </div>
        </div>

        <!-- Aya 74 -->
        <p class="ordinary-far">
          ثُمَّ قَسَتْ قُلُوبُكُم مِّن بَعْدِ ذَٰلِكَ فَهِيَ <span class="boxed underline-blackdashed2">كَالْحِجَارَةِ</span> أَوْ <span class="boxed underline-blackdashed2">أَشَدُّ قَسْوَةً</span> ۚ وَإِنَّ مِنَ الْحِجَارَةِ لَمَا يَتَفَجَّرُ مِنْهُ الْأَنْهَارُ ۚ وَ<span class="boxed underline-blackdashed">إِنَّ مِنْهَا لَمَا يَشَّقَّقُ فَيَخْرُجُ مِنْهُ الْمَاءُ</span> ۚ وَ<span class="boxed underline-blackdashed">إِنَّ مِنْهَا لَمَا يَهْبِطُ مِنْ خَشْيَةِ اللَّهِ</span> ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ<sup>۷۴</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <!-- Aya 75 -->
      <p class="ordinary-far">
        أَفَتَطْمَعُونَ أَن يُؤْمِنُوا لَكُمْ وَقَدْ كَانَ فَرِيقٌ مِّنْهُمْ يَسْمَعُونَ كَلَامَ اللَّهِ ثُمَّ يُحَرِّفُونَهُ مِن بَعْدِ مَا عَقَلُوهُ وَهُمْ يَعْلَمُونَ<sup>۷۵</sup>
      </p>

      <div class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>

        <div class="inner-paragraph-7">
          <p class="zero-margin">
            وَإِذَا لَقُوا الَّذِينَ آمَنُوا
          </p>

          <p class="zero-margin2">
            <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
            قَالُوا <speech open="" red=""></speech>آمَنَّا<speech close="" red=""></speech>
          </p>

          <p class="zero-margin">
            وَإِذَا خَلَا بَعْضُهُمْ إِلَىٰ بَعْضٍ
          </p>

          <!-- Aya 76 -->
          <p class="zero-margin2">
            <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
            قَالُوا <speech open="" red=""></speech>أَتُحَدِّثُونَهُم بِمَا فَتَحَ اللَّهُ عَلَيْكُمْ لِيُحَاجُّوكُم بِهِ عِندَ رَبِّكُمْ ۚ أَفَلَا تَعْقِلُونَ<speech close="" red=""></speech><sup>۷۶</sup>
          </p>

          <!-- Aya 77 -->
          <p class="zero-margin">
            أَوَلَا يَعْلَمُونَ أَنَّ اللَّهَ يَعْلَمُ <span class="boxed underline-blackdashed2">مَا يُسِرُّونَ</span> وَ<span class="boxed underline-blackdashed2">مَا يُعْلِنُونَ</span><sup>۷۷</sup>
          </p>
        </div>
      </div>

      <!-- Aya 78 -->
      <p class="ordinary-far">
        وَمِنْهُمْ أُمِّيُّونَ <span class="boxed underline-blackdashed">لَا يَعْلَمُونَ الْكِتَابَ إِلَّا أَمَانِيَّ</span> وَ<span class="boxed underline-blackdashed">إِنْ هُمْ إِلَّا يَظُنُّونَ</span><sup>۷۸</sup>
        فَوَيْلٌ لِّلَّذِينَ يَكْتُبُونَ الْكِتَابَ بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ <speech open="" red=""></speech>هَـٰذَا مِنْ عِندِ اللَّهِ<speech close="" red=""></speech> لِيَشْتَرُوا بِهِ ثَمَنًا قَلِيلًا ۖ فَ<span class="boxed underline-blackdotted">وَيْلٌ لَّهُم مِّمَّا كَتَبَتْ أَيْدِيهِمْ</span> وَ<span class="boxed underline-blackdotted">وَيْلٌ لَّهُم مِّمَّا يَكْسِبُونَ</span><sup>۷۹</sup>
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
        وَقَالُوا <speech open="" red=""></speech>لَن تَمَسَّنَا النَّارُ إِلَّا أَيَّامًا مَّعْدُودَةً<speech close="" red=""></speech> ۚ
      </p>

      <!-- Aya 80 -->
      <p class="small-bullet-near">
        <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
        قُلْ <speech open="" green=""></speech><span class="boxed underline-blackdashed">أَتَّخَذْتُمْ عِندَ اللَّهِ عَهْدًا فَلَن يُخْلِفَ اللَّهُ عَهْدَهُ</span> ۖ أَمْ <span class="boxed underline-blackdashed">تَقُولُونَ عَلَى اللَّهِ مَا لَا تَعْلَمُونَ</span><speech close="" green=""></speech><sup>۸۰</sup>
      </p>

      <!-- Aya 81 -->
      <p class="ordinary-far">
        بَلَىٰ <span class="boxed underline-solidred-far">مَن <span class="boxed underline-solidred">كَسَبَ سَيِّئَةً</span> وَ<span class="boxed underline-solidred">أَحَاطَتْ بِهِ خَطِيئَتُهُ</span> فَأُولَـٰئِكَ أَصْحَابُ النَّارِ</span> ۖ <span class="boxed underline-gradientredrev">هُمْ فِيهَا خَالِدُونَ</span><sup>۸۱</sup>
        وَ<span class="boxed underline-solidgreen-far">الَّذِينَ <span class="boxed underline-solidgreen">آمَنُوا</span> وَ<span class="boxed underline-solidgreen">عَمِلُوا الصَّالِحَاتِ</span> أُولَـٰئِكَ أَصْحَابُ الْجَنَّةِ</span> ۖ <span class="boxed underline-gradientgreenrev">هُمْ فِيهَا خَالِدُونَ</span><sup>۸۲</sup>
      </p>

      <!-- Aya 83 -->
      <p class="big-bullet-near">
        <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
        وَإِذْ أَخَذْنَا مِيثَاقَ بَنِي إِسْرَائِيلَ <span class="underline-black-far"><span class="boxed underline-black-far"><span class="underline-black-2">لَا تَعْبُدُونَ إِلَّا اللَّهَ</span></span></span> وَ<span class="boxed underline-black-far">بِ<span class="boxed underline-blackdashed">الْوَالِدَيْنِ</span> إِحْسَانًا وَ<span class="boxed underline-blackdashed">ذِي الْقُرْبَىٰ</span> وَ<span class="boxed underline-blackdashed">الْيَتَامَىٰ</span> وَ<span class="boxed underline-blackdashed">الْمَسَاكِينِ</span></span> وَ<span class="boxed underline-black-far">قُولُوا لِلنَّاسِ حُسْنًا</span> وَ<span class="boxed underline-black-far">أَقِيمُوا الصَّلَاةَ</span> وَ<span class="boxed underline-black-far">آتُوا الزَّكَاةَ</span> ثُمَّ تَوَلَّيْتُمْ إِلَّا قَلِيلًا مِّنكُمْ وَأَنتُم مُّعْرِضُونَ<sup>۸۳</sup>
      </p>

      <!-- Aya 84 -->
      <p class="big-bullet-near">
        <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span><span> </span>
        وَإِذْ أَخَذْنَا مِيثَاقَكُمْ <span class="boxed underline-black-2">لَا تَسْفِكُونَ دِمَاءَكُمْ</span> وَ<span class="boxed underline-black-2">لَا تُخْرِجُونَ أَنفُسَكُم</span> مِّن دِيَارِكُمْ ثُمَّ أَقْرَرْتُمْ وَأَنتُمْ تَشْهَدُونَ<sup>۸۴</sup>
        ثُمَّ أَنتُمْ هَـٰؤُلَاءِ <span class="boxed underline-blackdotted">تَقْتُلُونَ أَنفُسَكُمْ</span> وَ<span class="boxed underline-blackdotted">تُخْرِجُونَ فَرِيقًا مِّنكُم مِّن دِيَارِهِمْ</span> تَظَاهَرُونَ عَلَيْهِم <span class="boxed underline-blackdotted2">بِالْإِثْمِ</span> وَ<span class="boxed underline-blackdotted2">الْعُدْوَانِ</span> وَ<span class="boxed underline-blackdotted">إِن يَأْتُوكُمْ أُسَارَىٰ تُفَادُوهُمْ</span> وَهُوَ مُحَرَّمٌ عَلَيْكُمْ إِخْرَاجُهُمْ ۚ أَفَ<span class="boxed underline-blackdashed2">تُؤْمِنُونَ بِبَعْضِ الْكِتَابِ</span> وَ<span class="boxed underline-blackdashed2">تَكْفُرُونَ بِبَعْضٍ</span> ۚ فَمَا جَزَاءُ مَن يَفْعَلُ ذَٰلِكَ مِنكُمْ إِلَّا <span class="boxed underline-blackdotted"><span class="boxed underline-blackdotted-far">خِزْيٌ فِي الْحَيَاةِ <span class="highlight5">الدُّنْيَا</span></span></span> ۖ وَ<span class="boxed underline-blackdotted-far"><span class="boxed underline-blackdotted">يَوْمَ الْقِيَامَةِ يُرَدُّونَ إِلَىٰ أَشَدِّ الْعَذَابِ</span></span> ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ<sup>۸۵</sup>
      </p>

      <!-- Aya 86 -->
      <p class="ordinary-far">
        أُولَـٰئِكَ الَّذِينَ اشْتَرَوُا الْحَيَاةَ <span class="highlight5">الدُّنْيَا</span> بِ<span class="highlight6">الْآخِرَةِ</span> ۖ فَ<span class="boxed underline-blackdotted2">لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ</span> وَ<span class="boxed underline-blackdotted2">لَا هُمْ يُنصَرُونَ</span><sup>۸۶</sup>
      </p>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <!-- Aya 87 -->
        <p class="ordinary-near">
          وَلَقَدْ <span class="boxed underline-black-3">آتَيْنَا مُوسَى الْكِتَابَ</span> وَ<span class="boxed underline-black-3">قَفَّيْنَا مِن بَعْدِهِ بِالرُّسُلِ</span> ۖ وَ<span class="boxed underline-black-3">آتَيْنَا عِيسَى ابْنَ مَرْيَمَ الْبَيِّنَاتِ</span> وَ<span class="boxed underline-black-3">أَيَّدْنَاهُ بِرُوحِ الْقُدُسِ</span> ۗ أَفَكُلَّمَا جَاءَكُمْ رَسُولٌ بِمَا لَا تَهْوَىٰ أَنفُسُكُمُ اسْتَكْبَرْتُمْ فَ<span class="boxed underline-blackdotted">فَرِيقًا كَذَّبْتُمْ</span> وَ<span class="boxed underline-blackdotted">فَرِيقًا تَقْتُلُونَ</span><sup>۸۷</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          وَقَالُوا <speech open="" red=""></speech>قُلُوبُنَا غُلْفٌ<speech close="" red=""></speech> ۚ
        </p>

        <!-- Aya 88 -->
        <p class="ordinary-far">
          بَل لَّعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَقَلِيلًا مَّا يُؤْمِنُونَ<sup>۸۸</sup>
        </p>

        <!-- Aya 89 -->
        <p class="ordinary-far">
          وَلَمَّا جَاءَهُمْ كِتَابٌ مِّنْ عِندِ اللَّهِ مُصَدِّقٌ لِّمَا مَعَهُمْ وَكَانُوا مِن قَبْلُ يَسْتَفْتِحُونَ عَلَى الَّذِينَ كَفَرُوا فَلَمَّا جَاءَهُم مَّا عَرَفُوا كَفَرُوا بِهِ ۚ فَلَعْنَةُ اللَّهِ عَلَى الْكَافِرِينَ<sup>۸۹</sup>
          بِئْسَمَا اشْتَرَوْا بِهِ أَنفُسَهُمْ أَن يَكْفُرُوا بِمَا أَنزَلَ اللَّهُ بَغْيًا أَن يُنَزِّلَ اللَّهُ مِن فَضْلِهِ عَلَىٰ مَن يَشَاءُ مِنْ عِبَادِهِ ۖ فَبَاءُوا بِغَضَبٍ عَلَىٰ غَضَبٍ ۚ وَلِلْكَافِرِينَ عَذَابٌ مُّهِينٌ<sup>۹۰</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
          وَإِذَا قِيلَ لَهُمْ <speech open="" green=""></speech>آمِنُوا بِمَا أَنزَلَ اللَّهُ<speech close="" green=""></speech>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          قَالُوا <speech open="" red=""></speech>نُؤْمِنُ بِمَا أُنزِلَ عَلَيْنَا<speech close="" red=""></speech>
        </p>

        <p class="ordinary-near" style="margin-bottom: 2.5mm;">
          وَيَكْفُرُونَ بِمَا وَرَاءَهُ وَهُوَ الْحَقُّ مُصَدِّقًا لِّمَا مَعَهُمْ ۗ
        </p>

        <div class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>

          <div class="inner-paragraph-8">
            <!-- Aya 91 -->
            <p class="zero-margin">
              قُلْ <speech open="" green=""></speech>فَلِمَ تَقْتُلُونَ أَنبِيَاءَ اللَّهِ مِن قَبْلُ إِن كُنتُم مُّؤْمِنِينَ<sup>۹۱</sup>
              وَلَقَدْ جَاءَكُم مُّوسَىٰ بِالْبَيِّنَاتِ ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِن بَعْدِهِ وَأَنتُمْ ظَالِمُونَ<sup>۹۲</sup>
              وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا فَوْقَكُمُ الطُّورَ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;"><span class="boxed square">l</span> </span><span> </span>
              <speech open="" blue="" underline=""></speech>خُذُوا مَا آتَيْنَاكُم بِقُوَّةٍ وَاسْمَعُوا<speech close="" blue="" underline=""></speech> ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings&quot;;">o </span><span> </span>
              قَالُوا <speech open="" red=""></speech><span class="boxed underline-blackdashed2">سَمِعْنَا</span> وَ<span class="boxed underline-blackdashed2">عَصَيْنَا</span><speech close="" red=""></speech>
            </p>

            <p class="zero-margin">
              وَأُشْرِبُوا فِي قُلُوبِهِمُ الْعِجْلَ بِكُفْرِهِمْ<speech close="" green=""></speech> ۚ
            </p>
          </div>
        </div>

        <!-- Aya 93 -->
        <p class="small-bullet-far">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>بِئْسَمَا يَأْمُرُكُم بِهِ إِيمَانُكُمْ إِن كُنتُم مُّؤْمِنِينَ<speech close="" green=""></speech><sup>۹۳</sup>
        </p>

        <!-- Aya 94 -->
        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>إِن كَانَتْ لَكُمُ الدَّارُ <span class="highlight6">الْآخِرَةُ</span> عِندَ اللَّهِ خَالِصَةً مِّن دُونِ النَّاسِ فَتَمَنَّوُا الْمَوْتَ إِن كُنتُمْ صَادِقِينَ<speech close="" green=""></speech><sup>۹۴</sup>
        </p>

        <!-- Aya 95 -->
        <p class="ordinary-far">
          وَلَن يَتَمَنَّوْهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۗ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ<sup>۹۵</sup>
          وَلَتَجِدَنَّهُمْ أَحْرَصَ النَّاسِ عَلَىٰ حَيَاةٍ وَمِنَ الَّذِينَ أَشْرَكُوا ۚ يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ أَن يُعَمَّرَ ۗ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ<sup>۹۶</sup>
        </p>

        <!-- Aya 97 -->
        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>مَن كَانَ عَدُوًّا لِّجِبْرِيلَ فَإِنَّهُ نَزَّلَهُ عَلَىٰ قَلْبِكَ بِإِذْنِ اللَّهِ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ<sup>۹۷</sup>
          <span class="boxed underline-notsure">مَن كَانَ عَدُوًّا <span class="boxed underline-black-2">لِّلَّهِ</span> وَ<span class="boxed underline-black-2">مَلَائِكَتِهِ</span> وَ<span class="boxed underline-black-2">رُسُلِهِ</span> وَ<span class="boxed underline-black-2">جِبْرِيلَ</span> وَ<span class="boxed underline-black-2">مِيكَالَ</span> فَإِنَّ اللَّهَ عَدُوٌّ لِّلْكَافِرِينَ<sup>۹۸</sup></span><speech close="" green=""></speech>
        </p>

        <!-- Aya 99 -->
        <div class="ordinary-far">
          وَلَقَدْ أَنزَلْنَا إِلَيْكَ آيَاتٍ بَيِّنَاتٍ ۖ وَمَا يَكْفُرُ بِهَا إِلَّا الْفَاسِقُونَ<sup>۹۹</sup>
          أَوَكُلَّمَا عَاهَدُوا عَهْدًا نَّبَذَهُ فَرِيقٌ مِّنْهُم ۚ بَلْ أَكْثَرُهُمْ لَا يُؤْمِنُونَ<sup>۱۰۰</sup>
          وَلَمَّا جَاءَهُمْ رَسُولٌ مِّنْ عِندِ اللَّهِ مُصَدِّقٌ لِّمَا مَعَهُمْ نَبَذَ فَرِيقٌ مِّنَ الَّذِينَ أُوتُوا الْكِتَابَ كِتَابَ اللَّهِ وَرَاءَ ظُهُورِهِمْ كَأَنَّهُمْ <span class="highlight4">لَا يَعْلَمُونَ</span><sup>۱۰۱</sup>
          وَاتَّبَعُوا

          <div class="inner-paragraph-9">
            <p class="zero-margin6">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              مَا تَتْلُو الشَّيَاطِينُ عَلَىٰ مُلْكِ سُلَيْمَانَ ۖ وَمَا كَفَرَ سُلَيْمَانُ وَلَـٰكِنَّ الشَّيَاطِينَ كَفَرُوا <span class="highlight4">يُعَلِّمُونَ</span> النَّاسَ السِّحْرَ
            </p>

            <!-- Aya 102 -->
            <p class="zero-margin6">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              وَمَا أُنزِلَ عَلَى الْمَلَكَيْنِ بِبَابِلَ هَارُوتَ وَمَارُوتَ ۚ وَمَا <span class="highlight4">يُعَلِّمَانِ</span> مِنْ أَحَدٍ حَتَّىٰ يَقُولَا <speech open="" blue=""></speech>إِنَّمَا نَحْنُ فِتْنَةٌ فَلَا تَكْفُرْ<speech close="" blue=""></speech> ۖ فَ<span class="highlight4">يَتَعَلَّمُونَ</span> مِنْهُمَا مَا يُفَرِّقُونَ بِهِ بَيْنَ <span class="boxed underline-blackdashed2">الْمَرْءِ</span> وَ<span class="boxed underline-blackdashed2">زَوْجِهِ</span> ۚ وَمَا هُم بِضَارِّينَ بِهِ مِنْ أَحَدٍ إِلَّا بِإِذْنِ اللَّهِ ۚ
            </p>
          </div>
          وَ<span class="highlight4">يَتَعَلَّمُونَ</span> مَا <span class="boxed underline-blackdotted">يَضُرُّهُمْ</span> وَ<span class="boxed underline-blackdotted">لَا يَنفَعُهُمْ</span> ۚ وَلَقَدْ <span class="highlight4">عَلِمُوا</span> لَمَنِ اشْتَرَاهُ مَا لَهُ فِي <span class="highlight6">الْآخِرَةِ</span> مِنْ خَلَاقٍ ۚ وَلَبِئْسَ مَا شَرَوْا بِهِ أَنفُسَهُمْ ۚ <span class="boxed underline-gradientrev">لَوْ كَانُوا <span class="highlight4">يَعْلَمُونَ</span></span><sup>۱۰۲</sup>
          وَلَوْ أَنَّهُمْ<span class="underline-black-2"> <span class="boxed underline-black-2">آمَنُوا</span></span> وَ<span class="boxed underline-black-2">اتَّقَوْا</span> لَمَثُوبَةٌ مِّنْ عِندِ اللَّهِ خَيْرٌ ۖ <span class="boxed underline-gradientrev">لَّوْ كَانُوا <span class="highlight4">يَعْلَمُونَ</span></span><sup>۱۰۳</sup>

        </div>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
        يَا أَيُّهَا الَّذِينَ آمَنُوا

        <div class="inner-paragraph-11">
          <div class="container">
            <div class="vertical-line-inside"></div>
            <!-- Aya 104 -->
            <p class="zero-margin5">
              <span class="boxed underline-gradient">لَا تَقُولُوا</span> <speech open="" gray=""></speech>رَاعِنَا<speech close="" gray=""></speech> وَ<span class="boxed underline-gradient">قُولُوا</span> <speech open="" green=""></speech>انظُرْنَا<speech close="" green=""></speech> وَ<span class="boxed underline-gradient">اسْمَعُوا</span> ۗ وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ<sup>۱۰۴</sup>
            </p>

            <!-- Aya 105 -->
            <p class="zero-margin5">
              مَّا يَوَدُّ <span class="boxed underline-blackdotted">الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ</span> وَلَا <span class="boxed underline-blackdotted">الْمُشْرِكِينَ</span> أَن يُنَزَّلَ عَلَيْكُم مِّنْ خَيْرٍ مِّن رَّبِّكُمْ ۗ وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَن يَشَاءُ ۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ<sup>۱۰۵</sup>
            </p>

            <!-- Aya 106 -->
            <p class="zero-margin5">
              مَا نَنسَخْ مِنْ آيَةٍ أَوْ نُنسِهَا نَأْتِ <span class="boxed underline-blackdashed">بِخَيْرٍ مِّنْهَا</span> أَوْ <span class="boxed underline-blackdashed">مِثْلِهَا</span> ۗ <span class="boxed underline-gradient">أَلَمْ تَعْلَمْ</span> أَنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<sup>۱۰۶</sup>
              <span class="boxed underline-gradient">أَلَمْ تَعْلَمْ</span> أَنَّ اللَّهَ لَهُ مُلْكُ <span class="boxed underline-blackdashed2">السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضِ</span> ۗ وَمَا لَكُم مِّن دُونِ اللَّهِ مِن <span class="boxed underline-blackdashed">وَلِيٍّ</span> وَلَا <span class="boxed underline-blackdashed">نَصِيرٍ</span><sup>۱۰۷</sup>
            </p>

            <!-- Aya 108 -->
            <p class="zero-margin5">
              أَمْ تُرِيدُونَ أَن تَسْأَلُوا رَسُولَكُمْ كَمَا سُئِلَ مُوسَىٰ مِن قَبْلُ ۗ وَمَن يَتَبَدَّلِ الْكُفْرَ بِالْإِيمَانِ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ<sup>۱۰۸</sup>
            </p>

            <!-- Aya 109 -->
            <p class="zero-margin5">
              وَدَّ كَثِيرٌ مِّنْ أَهْلِ الْكِتَابِ لَوْ يَرُدُّونَكُم مِّن بَعْدِ إِيمَانِكُمْ كُفَّارًا حَسَدًا مِّنْ عِندِ أَنفُسِهِم مِّن بَعْدِ مَا تَبَيَّنَ لَهُمُ الْحَقُّ ۖ فَ<span class="boxed underline-blackdashed">اعْفُوا</span> وَ<span class="boxed underline-blackdashed">اصْفَحُوا</span> حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ ۗ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<sup>۱۰۹</sup>
            </p>

            <!-- Aya 110 -->
            <p class="zero-margin5">
              <span class="highlight12">وَ<span class="boxed underline-black-2">أَقِيمُوا الصَّلَاةَ</span> وَ<span class="boxed underline-black-2">آتُوا الزَّكَاةَ</span></span> ۚ وَمَا تُقَدِّمُوا لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ اللَّهِ ۗ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ<sup>۱۱۰</sup>
            </p>
          </div>
        </div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          وَقَالُوا <speech open="" red=""></speech>لَن يَدْخُلَ الْجَنَّةَ إِلَّا مَن كَانَ <span class="boxed underline-blackdashed">هُودًا</span> أَوْ <span class="boxed underline-blackdashed">نَصَارَىٰ</span><speech close="" red=""></speech> ۗ
        </p>

        <p class="ordinary-near">
          تِلْكَ أَمَانِيُّهُمْ ۗ
        </p>

        <!-- Aya 111 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>هَاتُوا بُرْهَانَكُمْ إِن كُنتُمْ صَادِقِينَ<speech close="" green=""></speech><sup>۱۱۱</sup>
        </p>

        <!-- Aya 112 -->
        <p class="ordinary-far">
          <span class="underline-notsure">بَلَىٰ مَنْ <span class="boxed underline-black-1">أَسْلَمَ وَجْهَهُ لِلَّهِ</span> وَ<span class="boxed underline-black-1">هُوَ مُحْسِنٌ</span> فَ<span class="boxed underline-black-2">لَهُ أَجْرُهُ عِندَ رَبِّهِ</span> وَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span><sup>۱۱۲</sup></span>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">q </span><span> </span>
          وَقَالَتِ الْيَهُودُ <speech open="" red=""></speech>لَيْسَتِ النَّصَارَىٰ عَلَىٰ شَيْءٍ<speech close="" red=""></speech>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">r </span><span> </span>
          وَقَالَتِ النَّصَارَىٰ <speech open="" red=""></speech>لَيْسَتِ الْيَهُودُ عَلَىٰ شَيْءٍ<speech close="" red=""></speech>
        </p>

        <!-- Aya 113 -->
        <p class="ordinary-far">
          وَهُمْ يَتْلُونَ الْكِتَابَ ۗ كَذَٰلِكَ قَالَ الَّذِينَ لَا يَعْلَمُونَ مِثْلَ قَوْلِهِمْ ۚ فَاللَّهُ يَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ<sup>۱۱۳</sup>
        </p>

        <!-- Aya 114 -->
        <p class="ordinary-far">
          وَمَنْ أَظْلَمُ مِمَّن <span class="boxed underline-blackdotted2">مَّنَعَ مَسَاجِدَ اللَّهِ أَن يُذْكَرَ فِيهَا اسْمُهُ</span> وَ<span class="boxed underline-blackdotted2">سَعَىٰ فِي خَرَابِهَا</span> ۚ أُولَـٰئِكَ مَا كَانَ لَهُمْ أَن يَدْخُلُوهَا إِلَّا خَائِفِينَ ۚ <span class="boxed underline-blackdotted">لَهُمْ فِي <span class="highlight5">الدُّنْيَا</span> خِزْيٌ</span> وَ<span class="boxed underline-blackdotted">لَهُمْ فِي <span class="highlight6">الْآخِرَةِ</span> عَذَابٌ عَظِيمٌ</span><sup>۱۱۴</sup>
        </p>

        <!-- Aya 115 -->
        <p class="ordinary-far">
          وَلِلَّهِ <span class="boxed underline-blackdashed2">الْمَشْرِقُ</span> وَ<span class="boxed underline-blackdashed2">الْمَغْرِبُ</span> ۚ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ ۚ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ<sup>۱۱۵</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          وَقَالُوا <speech open="" red=""></speech>اتَّخَذَ اللَّهُ وَلَدًا<speech close="" red=""></speech> ۗ
        </p>

        <!-- Aya 116 -->
        <p class="ordinary-far">
          سُبْحَانَهُ ۖ بَل لَّهُ مَا فِي <span class="boxed underline-blackdashed2">السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضِ</span> ۖ كُلٌّ لَّهُ قَانِتُونَ<sup>۱۱۶</sup>
          بَدِيعُ <span class="boxed underline-blackdashed2">السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضِ</span> ۖ وَإِذَا قَضَىٰ أَمْرًا فَإِنَّمَا يَقُولُ لَهُ <speech open="" blue=""></speech>كُن<speech close="" blue=""></speech> فَيَكُونُ<sup>۱۱۷</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          وَقَالَ الَّذِينَ لَا يَعْلَمُونَ <speech open="" red=""></speech>لَوْلَا <span class="boxed underline-blackdashed">يُكَلِّمُنَا اللَّهُ</span> أَوْ <span class="boxed underline-blackdashed">تَأْتِينَا آيَةٌ</span><speech close="" red=""></speech> ۗ
        </p>

        <!-- Aya 118 -->
        <p class="ordinary-far">
          كَذَٰلِكَ قَالَ الَّذِينَ مِن قَبْلِهِم مِّثْلَ قَوْلِهِمْ ۘ تَشَابَهَتْ قُلُوبُهُمْ ۗ قَدْ بَيَّنَّا الْآيَاتِ لِقَوْمٍ يُوقِنُونَ<sup>۱۱۸</sup>
        </p>

        <!-- Aya 119 -->
        <p class="ordinary-far">
          إِنَّا أَرْسَلْنَاكَ بِالْحَقِّ <span class="boxed underline-black-3">بَشِيرًا</span> وَ<span class="boxed underline-black-3">نَذِيرًا</span> ۖ وَلَا تُسْأَلُ عَنْ أَصْحَابِ الْجَحِيمِ<sup>۱۱۹</sup>
        </p>

        <p class="ordinary-near">
          وَلَن تَرْضَىٰ عَنكَ <span class="boxed underline-blackdashed">الْيَهُودُ</span> وَلَا <span class="boxed underline-blackdashed">النَّصَارَىٰ</span> حَتَّىٰ تَتَّبِعَ مِلَّتَهُمْ ۗ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>إِنَّ هُدَى اللَّهِ هُوَ الْهُدَىٰ<speech close="" green=""></speech> ۗ
        </p>

        <!-- Aya 120 -->
        <p class="ordinary-far">
          وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُم بَعْدَ الَّذِي جَاءَكَ مِنَ الْعِلْمِ ۙ مَا لَكَ مِنَ اللَّهِ مِن <span class="boxed underline-blackdashed">وَلِيٍّ</span> وَلَا <span class="boxed underline-blackdashed">نَصِيرٍ</span><sup>۱۲۰</sup>
        </p>

        <!-- Aya 121 -->
        <p class="ordinary-far">
          <span class="boxed underline-solidgreen">الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَتْلُونَهُ حَقَّ تِلَاوَتِهِ أُولَـٰئِكَ يُؤْمِنُونَ بِهِ</span> ۗ وَ<span class="boxed underline-solidred">مَن يَكْفُرْ بِهِ فَأُولَـٰئِكَ هُمُ الْخَاسِرُونَ</span><sup>۱۲۱</sup>
        </p>

        <!-- Aya 122 -->
        <p class="big-bullet-far">
          <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">f </span><span> </span>
          <span style="filter: invert(60%);">يَا بَنِي إِسْرَائِيلَ </span><span class="boxed underline-gradient"><span style="filter: invert(60%);">اذْكُرُوا</span></span><span style="filter: invert(60%);"> نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَنِّي فَضَّلْتُكُمْ عَلَى الْعَالَمِينَ<sup>۱۲۲</sup>
          وَ</span><span class="boxed underline-gradient"><span style="filter: invert(60%);">اتَّقُوا</span></span><span style="filter: invert(60%);"> يَوْمًا </span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَّا تَجْزِي نَفْسٌ عَن نَّفْسٍ شَيْئًا</span></span><span style="filter: invert(60%);"> وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا يُقْبَلُ مِنْهَا عَدْلٌ</span></span><span style="filter: invert(60%);"> وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا تَنفَعُهَا شَفَاعَةٌ</span></span><span style="filter: invert(60%);"> وَ</span><span class="boxed underline-blackdashed2"><span style="filter: invert(60%);">لَا هُمْ يُنصَرُونَ</span></span><span style="filter: invert(60%);"><sup>۱۲۳</sup></span>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin">
              وَإِذِ ابْتَلَىٰ إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
              قَالَ <speech open="" blue=""></speech>إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامًا<speech close="" blue=""></speech> ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>وَمِن ذُرِّيَّتِي<speech close="" green=""></speech> ۖ
            </p>

            <!-- Aya 124 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
              قَالَ <speech open="" blue=""></speech>لَا يَنَالُ عَهْدِي الظَّالِمِينَ<speech close="" blue=""></speech><sup>۱۲۴</sup>
            </p>
          </div>
        </div>

        <!-- Aya 125 -->
        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>
          <div class="inner-paragraph-7">
            <p class="zero-margin">
          وَإِذْ جَعَلْنَا الْبَيْتَ <span class="boxed underline-black-3">مَثَابَةً لِّلنَّاسِ</span> وَ<span class="boxed underline-black-3">أَمْنًا</span> 
            </p>
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed square">l</span> </span><span> </span>
          <speech open="" blue="" underline=""></speech>وَاتَّخِذُوا مِن مَّقَامِ إِبْرَاهِيمَ مُصَلًّى<speech close="" blue="" underline=""></speech> ۖ 
            </p>
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">l</span> </span><span> </span>
          وَعَهِدْنَا إِلَىٰ <span class="boxed underline-black-2">إِبْرَاهِيمَ</span> <span class="boxed underline-black-2">وَإِسْمَاعِيلَ</span> أَن <speech open="" blue="" underline=""></speech><span class="boxed underline-gradient">طَهِّرَا</span> بَيْتِيَ لِ<span class="boxed underline-black-1">لطَّائِفِينَ</span> وَ<span class="boxed underline-black-1">الْعَاكِفِينَ</span> وَ<span class="boxed underline-gradient">الرُّكَّعِ</span> السُّجُودِ<speech close="" blue="" underline=""></speech><sup>۱۲۵</sup>
            </p>
        </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              وَإِذْ قَالَ <speech open="" green=""></speech>إِبْرَاهِيمُ رَبِّ <span class="boxed underline-gradient">اجْعَلْ</span> هَـٰذَا بَلَدًا آمِنًا وَ<span class="boxed underline-gradient">ارْزُقْ</span> أَهْلَهُ مِنَ الثَّمَرَاتِ مَنْ آمَنَ مِنْهُم بِ<span class="boxed underline-black-1">اللَّهِ</span> وَ<span class="boxed underline-black-1">الْيَوْمِ الْآخِرِ</span><speech close="" green=""></speech> ۖ
            </p>

            <!-- Aya 126 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
              قَالَ <speech open="" blue=""></speech>وَمَن كَفَرَ فَأُمَتِّعُهُ قَلِيلًا ثُمَّ أَضْطَرُّهُ إِلَىٰ عَذَابِ النَّارِ ۖ وَبِئْسَ الْمَصِيرُ<speech close="" blue=""></speech><sup>۱۲۶</sup>
            </p>
          </div>
        </div>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin">
              وَإِذْ يَرْفَعُ <span class="boxed underline-black-2">إِبْرَاهِيمُ</span> الْقَوَاعِدَ مِنَ الْبَيْتِ وَ<span class="boxed underline-black-2">إِسْمَاعِيلُ</span>
            </p>

            <!-- Aya 127 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
              <speech open="" green="" underline=""></speech>رَبَّنَا تَقَبَّلْ مِنَّا ۖ إِنَّكَ أَنتَ السَّمِيعُ الْعَلِيمُ<speech close="" green="" underline=""></speech><sup>۱۲۷</sup>
            </p>

            <!-- Aya 128 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
              <speech open="" green="" underline=""></speech>رَبَّنَا وَ<span class="boxed underline-gradient">اجْعَلْنَا</span> <span class="boxed underline-black-2">مُسْلِمَيْنِ لَكَ</span> وَ<span class="boxed underline-black-2">مِن ذُرِّيَّتِنَا أُمَّةً مُّسْلِمَةً لَّكَ</span> وَ<span class="boxed underline-gradient">أَرِنَا</span> مَنَاسِكَنَا وَ<span class="boxed underline-gradient">تُبْ</span> عَلَيْنَا ۖ إِنَّكَ أَنتَ التَّوَّابُ الرَّحِيمُ<speech close="" green="" underline=""></speech><sup>۱۲۸</sup>
            </p>

            <!-- Aya 129 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
              <speech open="" green="" underline=""></speech>رَبَّنَا وَ<span class="boxed underline-gradient">ابْعَثْ</span> فِيهِمْ رَسُولًا مِّنْهُمْ <span class="boxed underline-black-far">يَتْلُو عَلَيْهِمْ آيَاتِكَ</span> وَ<span class="boxed underline-black-far">يُعَلِّمُهُمُ <span class="boxed underline-black-2">الْكِتَابَ</span> وَ<span class="boxed underline-black-2">الْحِكْمَةَ</span></span> وَ<span class="boxed underline-black-far">يُزَكِّيهِمْ</span> ۚ إِنَّكَ أَنتَ الْعَزِيزُ الْحَكِيمُ<speech close="" green="" underline=""></speech><sup>۱۲۹</sup>
            </p>
          </div>
        </div>

        <!-- Aya 130 -->
        <p class="ordinary-near">
          وَمَن يَرْغَبُ عَن مِّلَّةِ إِبْرَاهِيمَ إِلَّا مَن سَفِهَ نَفْسَهُ ۚ وَ<span class="boxed underline-black-3">لَقَدِ اصْطَفَيْنَاهُ فِي <span class="highlight5">الدُّنْيَا</span></span> ۖ وَ<span class="boxed underline-black-3">إِنَّهُ فِي <span class="highlight6">الْآخِرَةِ</span> لَمِنَ الصَّالِحِينَ</span><sup>۱۳۰</sup>
        </p>

        <div class="big-bullet-near">
          <span style="font-size:4.5mm;line-height:240%;font-family:Wingdings;">— </span>

          <div class="inner-paragraph-7">
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
              إِذْ قَالَ لَهُ رَبُّهُ <speech open="" blue=""></speech>أَسْلِمْ<speech close="" blue=""></speech> ۖ
            </p>

            <!-- Aya 131 -->
            <p class="zero-margin2">
              <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
              قَالَ <speech open="" green=""></speech>أَسْلَمْتُ لِرَبِّ الْعَالَمِينَ<speech close="" green=""></speech><sup>۱۳۱</sup>
            </p>
          </div>
        </div>

        <!-- Aya 132 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">u </span><span> </span>
          وَوَصَّىٰ بِهَا <span class="boxed underline-black-2">إِبْرَاهِيمُ</span> بَنِيهِ وَ<span class="boxed underline-black-2">يَعْقُوبُ</span> <speech open="" green=""></speech>يَا بَنِيَّ إِنَّ اللَّهَ اصْطَفَىٰ لَكُمُ الدِّينَ فَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسْلِمُونَ<speech close="" green=""></speech><sup>۱۳۲</sup>
        </p>

        <p class="ordinary-near">
          أَمْ كُنتُمْ شُهَدَاءَ إِذْ حَضَرَ يَعْقُوبَ الْمَوْتُ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          إِذْ قَالَ لِبَنِيهِ <speech open="" green=""></speech>مَا تَعْبُدُونَ مِن بَعْدِي<speech close="" green=""></speech>
        </p>

        <!-- Aya 133 -->
        <p class="small-bullet-far">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Webdings&quot;;">. </span><span> </span>
          قَالُوا <speech open="" green=""></speech>نَعْبُدُ <span class="boxed underline-black-1">إِلَـٰهَكَ</span> وَ<span class="boxed underline-black-1">إِلَـٰهَ آبَائِكَ</span> <span class="boxed underline-black-2">إِبْرَاهِيمَ</span> وَ<span class="boxed underline-black-2">إِسْمَاعِيلَ</span> وَ<span class="boxed underline-black-2">إِسْحَاقَ</span> إِلَـٰهًا وَاحِدًا وَنَحْنُ لَهُ مُسْلِمُونَ<speech close="" green=""></speech><sup>۱۳۳</sup>
        </p>

        <!-- Aya 134 -->
        <p class="ordinary-far">
          <span class="boxed underline-black-wavy-far">تِلْكَ أُمَّةٌ قَدْ خَلَتْ ۖ <span class="boxed underline-blackdashed2">لَهَا مَا كَسَبَتْ</span> وَ<span class="boxed underline-blackdashed2">لَكُم مَّا كَسَبْتُمْ</span> ۖ وَ<span class="boxed underline-blackdashed2">لَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ</span></span><sup>۱۳۴</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          وَقَالُوا <speech open="" red=""></speech>كُونُوا <span class="boxed underline-blackdashed">هُودًا</span> أَوْ <span class="boxed underline-blackdashed">نَصَارَىٰ</span> تَهْتَدُوا<speech close="" red=""></speech> ۗ
        </p>

        <!-- Aya 135 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>بَلْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا ۖ وَمَا كَانَ مِنَ الْمُشْرِكِينَ<speech close="" green=""></speech><sup>۱۳۵</sup>
        </p>

        <div class="small-bullet-near">
          <span style="font-size:4.0mm;line-height:240%;font-family:&quot;Webdings&quot;;">7 </span><span> </span>

          <div class="inner-paragraph-10">
            <!-- Aya 136 -->
            <p class="zero-margin">
              قُولُوا <speech open="" green=""></speech>آمَنَّا بِ<span class="boxed underline-black-far">اللَّهِ</span> وَ<span class="boxed underline-black-far">مَا أُنزِلَ إِلَيْنَا</span> وَ<span class="boxed underline-black-far">مَا أُنزِلَ إِلَىٰ <span class="boxed underline-black-2">إِبْرَاهِيمَ</span> وَ<span class="boxed underline-black-2">إِسْمَاعِيلَ</span> وَ<span class="boxed underline-black-2">إِسْحَاقَ</span> وَ<span class="boxed underline-black-2">يَعْقُوبَ</span> وَ<span class="boxed underline-black-2">الْأَسْبَاطِ</span></span> وَ<span class="boxed underline-black-far">مَا أُوتِيَ <span class="boxed underline-black-2">مُوسَىٰ</span> وَ<span class="boxed underline-black-2">عِيسَىٰ</span></span> وَ<span class="boxed underline-black-far">مَا أُوتِيَ النَّبِيُّونَ</span> مِن رَّبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّنْهُمْ وَنَحْنُ لَهُ مُسْلِمُونَ<speech close="" green=""></speech><sup>۱۳۶</sup>
            </p>

            <!-- Aya 137 -->
            <p style="text-align: left; margin-right: 91mm;margin-top: 0mm;margin-bottom: 0mm;margin-left: 0mm;">
              فَ<span class="boxed underline-solidgreen">إِنْ آمَنُوا بِمِثْلِ مَا آمَنتُم بِهِ فَقَدِ اهْتَدَوا</span> ۖ وَّ<span class="boxed underline-solidred">إِن تَوَلَّوْا فَإِنَّمَا هُمْ فِي شِقَاقٍ</span> ۖ فَسَيَكْفِيكَهُمُ اللَّهُ ۚ وَهُوَ السَّمِيعُ الْعَلِيمُ<sup>۱۳۷</sup>
            </p>

            <!-- Aya 138 -->
            <p class="zero-margin">
              صِبْغَةَ اللَّهِ ۖ وَمَنْ أَحْسَنُ مِنَ اللَّهِ صِبْغَةً ۖ وَنَحْنُ لَهُ عَابِدُونَ<sup>۱۳۸</sup>
            </p>
          </div>
        </div>

        <!-- Aya 139 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>أَتُحَاجُّونَنَا فِي اللَّهِ وَهُوَ <span class="boxed underline-black-2">رَبُّنَا</span> وَ<span class="boxed underline-black-2">رَبُّكُمْ</span> وَ<span class="boxed underline-blackdashed">لَنَا أَعْمَالُنَا</span> وَ<span class="boxed underline-blackdashed">لَكُمْ أَعْمَالُكُمْ</span> وَنَحْنُ لَهُ مُخْلِصُونَ<speech close="" green=""></speech><sup>۱۳۹</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          أَمْ تَقُولُونَ <speech open="" red=""></speech>إِنَّ <span class="boxed underline-black-2">إِبْرَاهِيمَ</span> وَ<span class="boxed underline-black-2">إِسْمَاعِيلَ</span> وَ<span class="boxed underline-black-2">إِسْحَاقَ</span> وَ<span class="boxed underline-black-2">يَعْقُوبَ</span> وَ<span class="boxed underline-black-2">الْأَسْبَاطَ</span> كَانُوا <span class="boxed underline-blackdashed">هُودًا</span> أَوْ <span class="boxed underline-blackdashed">نَصَارَىٰ</span><speech close="" red=""></speech> ۗ
        </p>

        <!-- Aya 140 -->
        <p class="small-bullet-far">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
          قُلْ <speech open="" green=""></speech>أَ<span class="boxed underline-blackdashed2">أَنتُمْ</span> أَعْلَمُ أَمِ <span class="boxed underline-blackdashed2">اللَّهُ</span> ۗ وَمَنْ أَظْلَمُ مِمَّن كَتَمَ شَهَادَةً عِندَهُ مِنَ اللَّهِ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ<speech close="" green=""></speech><sup>۱۴۰</sup>
        </p>

        <!-- Aya 141 -->
        <p class="ordinary-far">
          <span class="boxed underline-black-wavy-far">تِلْكَ أُمَّةٌ قَدْ خَلَتْ ۖ <span class="boxed underline-blackdashed2">لَهَا مَا كَسَبَتْ</span> وَ<span class="boxed underline-blackdashed2">لَكُم مَّا كَسَبْتُمْ</span> ۖ وَ<span class="boxed underline-blackdashed2">لَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ</span></span><sup>۱۴۱</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="diamond-marker bottom-2"></div>
    </div>

    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 2&quot;;">S </span><span> </span>
      سَيَقُولُ السُّفَهَاءُ مِنَ النَّاسِ <speech open="" red=""></speech>مَا وَلَّاهُمْ عَن <span class="highlight3">قِبْلَتِ</span>هِمُ الَّتِي كَانُوا عَلَيْهَا<speech close="" red=""></speech> ۚ
    </p>

    <!-- Aya 142 -->
    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُل <speech open="" green=""></speech>لِّلَّهِ <span class="boxed underline-blackdashed2">الْمَشْرِقُ</span> وَ<span class="boxed underline-blackdashed2">الْمَغْرِبُ</span> ۚ يَهْدِي مَن يَشَاءُ إِلَىٰ صِرَاطٍ مُّسْتَقِيمٍ<speech close="" green=""></speech><sup>۱۴۲</sup>
    </p>

    <!-- Aya 143 -->
    <p class="ordinary-far">
      وَكَذَٰلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِّ<span class="boxed underline-black-3">تَكُونُوا شُهَدَاءَ عَلَى النَّاسِ</span> وَ<span class="boxed underline-black-3">يَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا</span> ۗ وَمَا جَعَلْنَا <span class="highlight3">الْقِبْلَةَ</span> الَّتِي كُنتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَن يَتَّبِعُ الرَّسُولَ مِمَّن يَنقَلِبُ عَلَىٰ عَقِبَيْهِ ۚ وَإِن كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ ۗ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ ۚ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَّحِيمٌ<sup>۱۴۳</sup>
      قَدْ نَرَىٰ تَقَلُّبَ وَجْهِكَ فِي السَّمَاءِ ۖ فَلَنُوَلِّيَنَّكَ <span class="highlight3">قِبْلَةً</span> تَرْضَاهَا ۚ <span class="boxed underline-blackdashed-thick">فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ</span> ۚ وَحَيْثُ مَا كُنتُمْ <span class="boxed underline-blackdashed-thick">فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ</span> ۗ وَإِنَّ الَّذِينَ أُوتُوا الْكِتَابَ لَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِن رَّبِّهِمْ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا يَعْمَلُونَ<sup>۱۴۴</sup>
      وَلَئِنْ أَتَيْتَ الَّذِينَ أُوتُوا الْكِتَابَ بِكُلِّ آيَةٍ <span class="boxed underline-gradientrev">مَّا تَبِعُوا <span class="highlight3">قِبْلَتَ</span>كَ</span> ۚ وَ<span class="boxed underline-gradientrev">مَا أَنتَ بِتَابِعٍ <span class="highlight3">قِبْلَتَ</span>هُمْ</span> ۚ وَ<span class="boxed underline-gradientrev">مَا بَعْضُهُم بِتَابِعٍ <span class="highlight3">قِبْلَةَ</span> بَعْضٍ</span> ۚ وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُم مِّن بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ ۙ إِنَّكَ إِذًا لَّمِنَ الظَّالِمِينَ<sup>۱۴۵</sup>
      الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمْ ۖ وَإِنَّ فَرِيقًا مِّنْهُمْ لَيَكْتُمُونَ الْحَقَّ وَهُمْ يَعْلَمُونَ<sup>۱۴۶</sup>
      الْحَقُّ مِن رَّبِّكَ ۖ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ<sup>۱۴۷</sup>
      وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا ۖ فَاسْتَبِقُوا الْخَيْرَاتِ ۚ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا ۚ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<sup>۱۴۸</sup>
      وَمِنْ حَيْثُ خَرَجْتَ <span class="boxed underline-blackdashed-thick">فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ</span> ۖ وَإِنَّهُ لَلْحَقُّ مِن رَّبِّكَ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ<sup>۱۴۹</sup>
      وَمِنْ حَيْثُ خَرَجْتَ <span class="boxed underline-blackdashed-thick">فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ</span> ۚ وَحَيْثُ مَا كُنتُمْ <span class="boxed underline-blackdashed-thick">فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ</span> <span class="boxed underline-gradient-far"><span class="boxed underline-gradient">لِئَلَّا يَكُونَ</span></span> لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا الَّذِينَ ظَلَمُوا مِنْهُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِي وَ<span class="boxed underline-gradient-far"><span class="boxed underline-gradient">لِأُتِمَّ</span></span> نِعْمَتِي عَلَيْكُمْ وَ<span class="boxed underline-gradient">لَعَلَّكُمْ</span> تَهْتَدُونَ<sup>۱۵۰</sup>
      كَمَا أَرْسَلْنَا فِيكُمْ رَسُولًا مِّنكُمْ <span class="boxed underline-black-far">يَتْلُو عَلَيْكُمْ آيَاتِنَا</span> وَ<span class="boxed underline-black-far">يُزَكِّيكُمْ</span> وَ<span class="boxed underline-black-far">يُعَلِّمُكُمُ <span class="boxed underline-black-2">الْكِتَابَ</span> وَ<span class="boxed underline-black-2">الْحِكْمَةَ</span></span> وَ<span class="boxed underline-black-far">يُعَلِّمُكُم مَّا لَمْ تَكُونُوا تَعْلَمُونَ</span><sup>۱۵۱</sup>
      فَ<span class="boxed underline-gradientsym">اذْكُرُونِي</span> أَذْكُرْكُمْ وَ<span class="boxed underline-gradientsym">اشْكُرُوا لِي</span> وَ<span class="boxed underline-gradientsym">لَا تَكْفُرُونِ</span><sup>۱۵۲</sup>
    </p>

    <div class="big-bullet-far">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
      يَا أَيُّهَا الَّذِينَ آمَنُوا

      <div class="inner-paragraph-11">
        <div class="container">
          <div class="vertical-line-inside"></div>
          <!-- Aya 153 -->
          <p class="zero-margin5">
            <span class="highlight1">اسْتَعِينُوا بِ<span class="boxed underline-black-2">الصَّبْرِ</span> وَ<span class="boxed underline-black-2">الصَّلَاةِ</span></span> ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ<sup>۱۵۳</sup>
          </p>

          <!-- Aya 154 -->
          <p class="zero-margin5">
            وَلَا تَقُولُوا لِمَن يُقْتَلُ فِي سَبِيلِ اللَّهِ أَمْوَاتٌ ۚ بَلْ أَحْيَاءٌ وَلَـٰكِن لَّا تَشْعُرُونَ<sup>۱۵۴</sup>
          </p>

          <!-- Aya 155 -->
          <p class="zero-margin5">
            وَلَنَبْلُوَنَّكُم بِشَيْءٍ مِّنَ <span class="boxed underline-blackdashed-far">الْخَوْفِ</span> وَ<span class="boxed underline-blackdashed-far">الْجُوعِ</span> وَ<span class="underline-blackdashed-far"><span class="boxed underline-blackdashed-far">نَقْصٍ مِّنَ <span class="boxed underline-blackdashed2">الْأَمْوَالِ</span> وَ<span class="boxed underline-blackdashed2">الْأَنفُسِ</span> وَ<span class="boxed underline-blackdashed2">الثَّمَرَاتِ</span></span></span> ۗ وَبَشِّرِ الصَّابِرِينَ<sup>۱۵۵</sup>
            الَّذِينَ إِذَا أَصَابَتْهُم مُّصِيبَةٌ
          </p>

          <!-- Aya 156 -->
          <p class="zero-margin5">
            <span style="margin-right: 5mm;">
            <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">n </span><span> </span>
            قَالُوا <speech open="" green=""></speech><span class="boxed underline-black-3">إِنَّا لِلَّهِ</span> وَ<span class="boxed underline-black-3">إِنَّا إِلَيْهِ رَاجِعُونَ</span><speech close="" green=""></speech><sup>۱۵۶</sup></span>
          </p>

          <!-- Aya 157 -->
          <p class="zero-margin5">
            <span style="margin-right: 5mm;">
            <span class="boxed underline-gradient">أُولَـٰئِكَ</span> عَلَيْهِمْ <span class="boxed underline-black-2">صَلَوَاتٌ مِّن رَّبِّهِمْ</span> وَ<span class="boxed underline-black-2">رَحْمَةٌ</span> ۖ وَ<span class="boxed underline-gradient">أُولَـٰئِكَ</span> هُمُ الْمُهْتَدُونَ<sup>۱۵۷</sup></span>
          </p>
        </div>
      </div>
    </div>

    <!-- Aya 158 -->
    <p class="ordinary-far">
      إِنَّ <span class="boxed underline-blackdashed">الصَّفَا</span> وَ<span class="boxed underline-blackdashed">الْمَرْوَةَ</span> مِن شَعَائِرِ اللَّهِ ۖ فَمَنْ <span class="boxed underline-black-3">حَجَّ الْبَيْتَ</span> أَوِ <span class="boxed underline-black-3">اعْتَمَرَ</span> فَلَا جُنَاحَ عَلَيْهِ أَن يَطَّوَّفَ بِهِمَا ۚ وَمَن تَطَوَّعَ خَيْرًا فَإِنَّ اللَّهَ شَاكِرٌ عَلِيمٌ<sup>۱۵۸</sup>
    </p>

    <!-- Aya 159 -->
    <p class="ordinary-far">
      إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنزَلْنَا مِنَ <span class="boxed underline-black-2">الْبَيِّنَاتِ</span> وَ<span class="boxed underline-black-2">الْهُدَىٰ</span> مِن بَعْدِ مَا بَيَّنَّاهُ لِلنَّاسِ فِي الْكِتَابِ ۙ أُولَـٰئِكَ <span class="boxed underline-blackdotted2">يَلْعَنُهُمُ اللَّهُ</span> وَ<span class="boxed underline-blackdotted2">يَلْعَنُهُمُ اللَّاعِنُونَ</span><sup>۱۵۹</sup>
      إِلَّا الَّذِينَ <span class="boxed underline-black-2">تَابُوا</span> وَ<span class="boxed underline-black-2">أَصْلَحُوا</span> وَ<span class="boxed underline-black-2">بَيَّنُوا</span> فَأُولَـٰئِكَ أَتُوبُ عَلَيْهِمْ ۚ وَأَنَا التَّوَّابُ الرَّحِيمُ<sup>۱۶۰</sup>
      إِنَّ الَّذِينَ <span class="boxed underline-blackdotted">كَفَرُوا</span> وَ<span class="boxed underline-blackdotted">مَاتُوا وَهُمْ كُفَّارٌ</span> أُولَـٰئِكَ عَلَيْهِمْ لَعْنَةُ <span class="boxed underline-blackdashed">اللَّهِ</span> وَ<span class="boxed underline-blackdashed">الْمَلَائِكَةِ</span> وَ<span class="boxed underline-blackdashed">النَّاسِ أَجْمَعِينَ</span><sup>۱۶۱</sup>
      خَالِدِينَ فِيهَا ۖ <span class="boxed underline-blackdotted2">لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ</span> وَلَ<span class="boxed underline-blackdotted2">ا هُمْ يُنظَرُونَ</span><sup>۱۶۲</sup>
    </p>

    <!-- Aya 163 -->
    <p class="ordinary-near">
      وَإِلَـٰهُكُمْ إِلَـٰهٌ وَاحِدٌ ۖ لَّا إِلَـٰهَ إِلَّا هُوَ الرَّحْمَـٰنُ الرَّحِيمُ<sup>۱۶۳</sup>
      إِنَّ فِي <span class="boxed underline-blackdashed-far">خَلْقِ <span class="boxed underline-blackdashed2">السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضِ</span></span>
      وَ<span class="boxed underline-blackdashed-far">اخْتِلَافِ <span class="boxed underline-blackdashed2">اللَّيْلِ</span> وَ<span class="boxed underline-blackdashed2">النَّهَارِ</span></span>
      وَ<span class="boxed underline-blackdashed-far">الْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ</span>
      وَ<span class="boxed underline-blackdashed-far">مَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا</span>
      وَ<span class="boxed underline-blackdashed-far">بَثَّ فِيهَا مِن كُلِّ دَابَّةٍ</span>
      وَ<span class="boxed underline-blackdashed-far">تَصْرِيفِ الرِّيَاحِ</span>
      وَ<span class="boxed underline-blackdashed-far">السَّحَابِ الْمُسَخَّرِ بَيْنَ <span class="boxed underline-blackdashed2">السَّمَاءِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضِ</span></span>
      لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ<sup>۱۶۴</sup>
      وَ<span class="boxed underline-solidred">مِنَ النَّاسِ مَن يَتَّخِذُ مِن دُونِ اللَّهِ أَندَادًا يُحِبُّونَهُمْ كَحُبِّ اللَّهِ</span> ۖ وَ<span class="boxed underline-solidgreen">الَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِّلَّهِ</span> ۗ وَلَوْ يَرَى الَّذِينَ ظَلَمُوا إِذْ يَرَوْنَ الْعَذَابَ <span class="boxed underline-black-3">أَنَّ الْقُوَّةَ لِلَّهِ جَمِيعًا</span> وَ<span class="boxed underline-black-3">أَنَّ اللَّهَ شَدِيدُ الْعَذَابِ</span><sup>۱۶۵</sup>
      إِذْ <span class="boxed underline-blackdotted">تَبَرَّأَ الَّذِينَ اتُّبِعُوا مِنَ الَّذِينَ اتَّبَعُوا</span> وَ<span class="boxed underline-blackdotted">رَأَوُا الْعَذَابَ</span> وَ<span class="boxed underline-blackdotted">تَقَطَّعَتْ بِهِمُ الْأَسْبَابُ</span><sup>۱۶۶</sup>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
      وَقَالَ الَّذِينَ اتَّبَعُوا <speech open="" red=""></speech>لَوْ أَنَّ لَنَا كَرَّةً فَنَتَبَرَّأَ مِنْهُمْ كَمَا تَبَرَّءُوا مِنَّا<speech close="" red=""></speech> ۗ
    </p>

    <!-- Aya 167 -->
    <p class="ordinary-far">
      كَذَٰلِكَ يُرِيهِمُ اللَّهُ أَعْمَالَهُمْ حَسَرَاتٍ عَلَيْهِمْ ۖ وَمَا هُم بِخَارِجِينَ مِنَ النَّارِ<sup>۱۶۷</sup>
    </p>

    <!-- Aya 168 -->
    <p class="big-bullet-far">
      <span style="font-size:5.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">H </span><span> </span>
      يَا أَيُّهَا النَّاسُ <span class="boxed underline-black-3">كُلُوا مِمَّا فِي الْأَرْضِ حَلَالًا طَيِّبًا</span> وَ<span class="boxed underline-black-3">لَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ</span> ۚ إِنَّهُ لَكُمْ عَدُوٌّ مُّبِينٌ<sup>۱۶۸</sup>
      إِنَّمَا يَأْمُرُكُم بِ<span class="boxed underline-blackdotted">السُّوءِ</span>
      وَ<span class="boxed underline-blackdotted">الْفَحْشَاءِ</span>
      وَ<span class="boxed underline-blackdotted">أَن تَقُولُوا عَلَى اللَّهِ مَا لَا تَعْلَمُونَ</span><sup>۱۶۹</sup>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
      وَإِذَا قِيلَ لَهُمُ <speech open="" green=""></speech>اتَّبِعُوا مَا أَنزَلَ اللَّهُ<speech close="" green=""></speech>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
      قَالُوا <speech open="" red=""></speech>بَلْ نَتَّبِعُ مَا أَلْفَيْنَا عَلَيْهِ آبَاءَنَا<speech close="" red=""></speech> ۗ
    </p>

    <!-- Aya 170 -->
    <p class="ordinary-near">
      أَوَلَوْ كَانَ آبَاؤُهُمْ لَا يَعْقِلُونَ شَيْئًا وَلَا يَهْتَدُونَ<sup>۱۷۰</sup>
    </p>

    <!-- Aya 171 -->
    <p class="ordinary-far">
      وَمَثَلُ الَّذِينَ كَفَرُوا كَمَثَلِ الَّذِي يَنْعِقُ بِمَا لَا يَسْمَعُ إِلَّا <span class="boxed underline-blackdashed2">دُعَاءً</span> وَ<span class="boxed underline-blackdashed2">نِدَاءً</span> ۚ <span class="boxed underline-blackdotted2">صُمٌّ</span> <span class="boxed underline-blackdotted2">بُكْمٌ</span> <span class="boxed underline-blackdotted2">عُمْيٌ</span> فَهُمْ لَا يَعْقِلُونَ<sup>۱۷۱</sup>
    </p>

    <!-- Aya 172 -->
    <p class="big-bullet-far">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
      يَا أَيُّهَا الَّذِينَ آمَنُوا <span class="boxed underline-black-3">كُلُوا مِن طَيِّبَاتِ مَا رَزَقْنَاكُمْ</span> وَ<span class="boxed underline-black-3">اشْكُرُوا لِلَّهِ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ</span><sup>۱۷۲</sup>
      إِنَّمَا حَرَّمَ عَلَيْكُمُ <span class="boxed underline-blackdashed">الْمَيْتَةَ</span> وَ<span class="boxed underline-blackdashed">الدَّمَ</span> وَ<span class="boxed underline-blackdashed">لَحْمَ الْخِنزِيرِ</span> وَ<span class="boxed underline-blackdashed">مَا أُهِلَّ بِهِ لِغَيْرِ اللَّهِ</span> ۖ فَمَنِ اضْطُرَّ غَيْرَ<span class="boxed underline-blackdotted"> بَاغٍ</span> وَلَا <span class="boxed underline-blackdotted">عَادٍ</span> فَلَا إِثْمَ عَلَيْهِ ۚ إِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ<sup>۱۷۳</sup>
    </p>

    <div class="ordinary-far">
      إِنَّ الَّذِينَ <span class="boxed underline-blackdotted2">يَكْتُمُونَ مَا أَنزَلَ اللَّهُ مِنَ الْكِتَابِ</span> وَ<span class="boxed underline-blackdotted2">يَشْتَرُونَ بِهِ ثَمَنًا قَلِيلًا</span> ۙ

      <div class="inner-paragraph-16">
        <!-- Aya 174 -->
        <p class="zero-margin2">
          <span class="boxed underline-gradient">أُولَـٰئِكَ</span>
          <span class="boxed underline-blackdotted-far">مَا يَأْكُلُونَ فِي بُطُونِهِمْ إِلَّا النَّارَ</span>
          وَ<span class="boxed underline-blackdotted-far">
          <span class="boxed underline-blackdotted">لَا يُكَلِّمُهُمُ اللَّهُ</span>
          يَوْمَ الْقِيَامَةِ
          وَ<span class="boxed underline-blackdotted">لَا يُزَكِّيهِمْ</span>
          وَ<span class="boxed underline-blackdotted">لَهُمْ عَذَابٌ أَلِيمٌ</span></span><sup>۱۷۴</sup>
        </p>

        <!-- Aya 175 -->
        <p class="zero-margin2">
          <span class="boxed underline-gradient">أُولَـٰئِكَ</span> الَّذِينَ اشْتَرَوُا <span class="boxed underline-blackdotted-far">الضَّلَالَةَ بِالْهُدَىٰ</span>
          وَ<span class="boxed underline-blackdotted-far">الْعَذَابَ بِالْمَغْفِرَةِ</span> ۚ فَمَا أَصْبَرَهُمْ عَلَى النَّارِ<sup>۱۷۵</sup>
        </p>
      </div>
      ذَٰلِكَ بِأَنَّ اللَّهَ نَزَّلَ الْكِتَابَ بِالْحَقِّ ۗ وَإِنَّ الَّذِينَ اخْتَلَفُوا فِي الْكِتَابِ لَفِي شِقَاقٍ بَعِيدٍ<sup>۱۷۶</sup>

    </div>

    <!-- Aya 177 -->
    <p class="ordinary-far">
      لَّيْسَ الْبِرَّ أَن تُوَلُّوا وُجُوهَكُمْ قِبَلَ <span class="boxed underline-blackdashed2">الْمَشْرِقِ</span> وَ<span class="boxed underline-blackdashed2">الْمَغْرِبِ</span> وَلَـٰكِنَّ الْبِرَّ مَنْ
      <span class="boxed underline-black-far2">آمَنَ بِ<span class="boxed underline-black-far">اللَّهِ</span> وَ
      <span class="boxed underline-black-far">الْيَوْمِ الْآخِرِ</span> وَ
      <span class="boxed underline-black-far">الْمَلَائِكَةِ</span> وَ
      <span class="boxed underline-black-far">الْكِتَابِ</span> وَ
      <span class="boxed underline-black-far">النَّبِيِّينَ</span></span>
      وَ<span class="boxed underline-black-far2">آتَى الْمَالَ عَلَىٰ حُبِّهِ
      <span class="boxed underline-blackdashed-far">ذَوِي الْقُرْبَىٰ</span> وَ
      <span class="boxed underline-blackdashed-far">الْيَتَامَىٰ</span> وَ
      <span class="boxed underline-blackdashed-far">الْمَسَاكِينَ</span> وَ
      <span class="boxed underline-blackdashed-far">ابْنَ السَّبِيلِ</span> وَ
      <span class="boxed underline-blackdashed-far">السَّائِلِينَ</span> وَ
      <span class="boxed underline-blackdashed-far">فِي الرِّقَابِ</span></span>
      وَ<span class="boxed underline-black-far2">أَقَامَ الصَّلَاةَ</span>
      وَ<span class="boxed underline-black-far2">آتَى الزَّكَاةَ</span>
      وَ<span class="boxed underline-black-far2">الْمُوفُونَ بِعَهْدِهِمْ إِذَا عَاهَدُوا</span> ۖ
      وَ<span class="boxed underline-black-far2">الصَّابِرِينَ
      فِي <span class="boxed underline-blackdashed-far"><span class="boxed underline-blackdashed2">الْبَأْسَاءِ</span> وَ<span class="boxed underline-blackdashed2">الضَّرَّاءِ</span></span> وَ
      <span class="boxed underline-blackdashed-far">حِينَ الْبَأْسِ</span></span> ۗ
      <span class="boxed underline-gradient">أُولَـٰئِكَ</span> الَّذِينَ صَدَقُوا ۖ وَ
      <span class="boxed underline-gradient">أُولَـٰئِكَ</span> هُمُ الْمُتَّقُونَ<sup>۱۷۷</sup>
    </p>

    <div class="big-bullet-far">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
      يَا أَيُّهَا الَّذِينَ آمَنُوا

      <div class="inner-paragraph-11" style="margin-top: 0.5mm;">
        <div class="container">
          <div class="vertical-line-inside"></div>
          <!-- Aya 178 -->
          <p class="zero-margin3">
            <span class="boxed">كُتِبَ عَلَيْكُمُ</span> الْقِصَاصُ فِي الْقَتْلَى ۖ <span class="boxed underline-blackdashed">الْحُرُّ بِالْحُرِّ</span> وَ<span class="boxed underline-blackdashed">الْعَبْدُ بِالْعَبْدِ</span> وَ<span class="boxed underline-blackdashed">الْأُنثَىٰ بِالْأُنثَىٰ</span> ۚ فَمَنْ عُفِيَ لَهُ مِنْ أَخِيهِ شَيْءٌ فَ<span class="boxed underline-black-3">اتِّبَاعٌ بِالْمَعْرُوفِ</span> وَ<span class="boxed underline-black-3">أَدَاءٌ إِلَيْهِ بِإِحْسَانٍ</span> ۗ ذَٰلِكَ <span class="boxed underline-black-2">تَخْفِيفٌ مِّن رَّبِّكُمْ</span> وَ<span class="boxed underline-black-2">رَحْمَةٌ</span> ۗ فَمَنِ اعْتَدَىٰ بَعْدَ ذَٰلِكَ فَلَهُ عَذَابٌ أَلِيمٌ<sup>۱۷۸</sup>
            وَلَكُمْ فِي الْقِصَاصِ حَيَاةٌ يَا أُولِي الْأَلْبَابِ لَعَلَّكُمْ تَتَّقُونَ<sup>۱۷۹</sup>
          </p>

          <!-- Aya 180 -->
          <p class="zero-margin5">
            <span class="boxed">كُتِبَ عَلَيْكُمْ</span> إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ إِن تَرَكَ خَيْرًا الْوَصِيَّةُ لِ<span class="boxed underline-blackdashed">لْوَالِدَيْنِ</span> وَ<span class="boxed underline-blackdashed">الْأَقْرَبِينَ</span> بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُتَّقِينَ<sup>۱۸۰</sup>
            فَمَن بَدَّلَهُ بَعْدَ مَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ ۚ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ<sup>۱۸۱</sup>
            فَمَنْ خَافَ مِن مُّوصٍ <span class="boxed underline-blackdotted">جَنَفًا</span> أَوْ <span class="boxed underline-blackdotted">إِثْمًا</span> فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ ۚ إِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ<sup>۱۸۲</sup>
          </p>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <!-- Aya 183 -->
      <p class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
        يَا أَيُّهَا الَّذِينَ آمَنُوا <span class="boxed">كُتِبَ عَلَيْكُمُ</span> الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ<sup>۱۸۳</sup>
        أَيَّامًا مَّعْدُودَاتٍ ۚ فَمَن كَانَ مِنكُم <span class="boxed underline-blackdashed">مَّرِيضًا</span> أَوْ <span class="boxed underline-blackdashed">عَلَىٰ سَفَرٍ</span> فَعِدَّةٌ مِّنْ أَيَّامٍ أُخَرَ ۚ وَعَلَى الَّذِينَ يُطِيقُونَهُ فِدْيَةٌ طَعَامُ مِسْكِينٍ ۖ فَمَن تَطَوَّعَ خَيْرًا فَهُوَ خَيْرٌ لَّهُ ۚ وَأَن تَصُومُوا خَيْرٌ لَّكُمْ ۖ إِن كُنتُمْ تَعْلَمُونَ<sup>۱۸۴</sup>
      </p>

      <!-- Aya 185 -->
      <p class="ordinary-far">
        شَهْرُ رَمَضَانَ الَّذِي أُنزِلَ فِيهِ الْقُرْآنُ <span class="boxed underline-black-2">هُدًى لِّلنَّاسِ</span> وَ<span class="boxed underline-black-2">بَيِّنَاتٍ مِّنَ الْهُدَىٰ</span> وَ<span class="boxed underline-black-2">الْفُرْقَانِ</span> ۚ فَمَن شَهِدَ مِنكُمُ الشَّهْرَ فَلْيَصُمْهُ ۖ وَمَن كَانَ <span class="boxed underline-blackdashed">مَرِيضًا</span> أَوْ <span class="boxed underline-blackdashed">عَلَىٰ سَفَرٍ</span> فَعِدَّةٌ مِّنْ أَيَّامٍ أُخَرَ ۗ <span class="boxed underline-black-3">يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ</span> وَ<span class="boxed underline-black-3">لَا يُرِيدُ بِكُمُ الْعُسْرَ</span> وَ<span class="boxed underline-black-3">لِتُكْمِلُوا الْعِدَّةَ</span> وَ<span class="boxed underline-black-3">لِتُكَبِّرُوا اللَّهَ عَلَىٰ مَا هَدَاكُمْ</span> وَ<span class="boxed underline-black-3">لَعَلَّكُمْ تَشْكُرُونَ</span><sup>۱۸۵</sup>
      </p>

      <!-- Aya 186 -->
      <p class="ordinary-far">
        وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ ۖ فَ<span class="boxed underline-black-2">لْيَسْتَجِيبُوا لِي</span> وَ<span class="boxed underline-black-2">لْيُؤْمِنُوا بِي</span> لَعَلَّهُمْ يَرْشُدُونَ<sup>۱۸۶</sup>
      </p>

      <!-- Aya 187 -->
      <p class="ordinary-far">
        أُحِلَّ لَكُمْ لَيْلَةَ الصِّيَامِ الرَّفَثُ إِلَىٰ نِسَائِكُمْ ۚ <span class="boxed underline-black-3">هُنَّ لِبَاسٌ لَّكُمْ</span> وَ<span class="boxed underline-black-3">أَنتُمْ لِبَاسٌ لَّهُنَّ</span> ۗ عَلِمَ اللَّهُ أَنَّكُمْ كُنتُمْ تَخْتَانُونَ أَنفُسَكُمْ فَ<span class="boxed underline-black-2">تَابَ عَلَيْكُمْ</span> وَ<span class="boxed underline-black-2">عَفَا عَنكُمْ</span> ۖ فَ<span class="boxed underline-blackdashed">الْآنَ بَاشِرُوهُنَّ</span> وَ<span class="boxed underline-blackdashed">ابْتَغُوا مَا كَتَبَ اللَّهُ لَكُمْ</span> ۚ وَ<span class="boxed underline-blackdashed2">كُلُوا</span> وَ<span class="boxed underline-blackdashed2">اشْرَبُوا</span> حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ مِنَ الْخَيْطِ الْأَسْوَدِ مِنَ الْفَجْرِ ۖ ثُمَّ أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ ۚ وَلَا تُبَاشِرُوهُنَّ وَأَنتُمْ عَاكِفُونَ فِي الْمَسَاجِدِ ۗ تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ<sup>۱۸۷</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <!-- Aya 188 -->
    <p class="ordinary-far">
      وَلَا <span class="boxed underline-blackdotted">تَأْكُلُوا أَمْوَالَكُم بَيْنَكُم بِالْبَاطِلِ</span> وَ<span class="boxed underline-blackdotted">تُدْلُوا بِهَا إِلَى الْحُكَّامِ لِتَأْكُلُوا فَرِيقًا مِّنْ أَمْوَالِ النَّاسِ بِالْإِثْمِ وَأَنتُمْ تَعْلَمُونَ</span><sup>۱۸۸</sup>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      يَسْأَلُونَكَ عَنِ الْأَهِلَّةِ ۖ
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلْ <speech open="" green=""></speech>هِيَ <span class="boxed underline-blackdashed">مَوَاقِيتُ لِلنَّاسِ</span> وَ<span class="boxed underline-blackdashed">الْحَجِّ</span><speech close="" green=""></speech> ۗ
    </p>

    <!-- Aya 189 -->
    <p class="ordinary-far">
      وَلَيْسَ الْبِرُّ بِأَن تَأْتُوا الْبُيُوتَ مِن ظُهُورِهَا وَلَـٰكِنَّ الْبِرَّ مَنِ اتَّقَىٰ ۗ وَ<span class="boxed underline-gradient">أْتُوا</span> الْبُيُوتَ مِنْ أَبْوَابِهَا ۚ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ<sup>۱۸۹</sup>
    </p>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <!-- Aya 190 -->
      <p class="ordinary-far">
        وَ<span class="boxed underline-gradient">قَاتِلُوا</span> فِي سَبِيلِ اللَّهِ الَّذِينَ يُقَاتِلُونَكُمْ <span class="boxed underline-gradient">وَلَا تَعْتَدُوا</span> ۚ إِنَّ اللَّهَ لَا يُحِبُّ الْمُعْتَدِينَ<sup>۱۹۰</sup>
        وَ<span class="boxed underline-gradientrev">اقْتُلُوهُمْ</span> حَيْثُ ثَقِفْتُمُوهُمْ وَ<span class="boxed underline-gradientrev">أَخْرِجُوهُم</span> مِّنْ حَيْثُ أَخْرَجُوكُمْ ۚ وَالْفِتْنَةُ أَشَدُّ مِنَ الْقَتْلِ ۚ وَلَا تُقَاتِلُوهُمْ عِندَ الْمَسْجِدِ الْحَرَامِ حَتَّىٰ يُقَاتِلُوكُمْ فِيهِ ۖ فَإِن قَاتَلُوكُمْ فَاقْتُلُوهُمْ ۗ كَذَٰلِكَ جَزَاءُ الْكَافِرِينَ<sup>۱۹۱</sup>
        فَإِنِ انتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ<sup>۱۹۲</sup>
        وَقَاتِلُوهُمْ حَتَّىٰ <span class="boxed underline-black-3">لَا تَكُونَ فِتْنَةٌ</span> وَ<span class="boxed underline-black-3">يَكُونَ الدِّينُ لِلَّهِ</span> ۖ فَإِنِ انتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ<sup>۱۹۳</sup>
        <span class="boxed underline-blackdashed">الشَّهْرُ الْحَرَامُ بِالشَّهْرِ الْحَرَامِ</span> وَ<span class="boxed underline-blackdashed">الْحُرُمَاتُ قِصَاصٌ</span> ۚ فَمَنِ اعْتَدَىٰ عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَىٰ عَلَيْكُمْ ۚ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ<sup>۱۹۴</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <!-- Aya 195 -->
    <p class="ordinary-far">
      وَ<span class="boxed underline-gradient">أَنفِقُوا</span> فِي سَبِيلِ اللَّهِ وَ<span class="boxed underline-gradient">لَا تُلْقُوا</span> بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ ۛ وَ<span class="boxed underline-gradient">أَحْسِنُوا</span> ۛ إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ<sup>۱۹۵</sup>
    </p>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <!-- Aya 196 -->
      <p class="ordinary-near">
        وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلَّهِ ۚ فَإِنْ أُحْصِرْتُمْ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ ۖ وَلَا تَحْلِقُوا رُءُوسَكُمْ حَتَّىٰ يَبْلُغَ الْهَدْيُ مَحِلَّهُ ۚ فَمَن كَانَ مِنكُم <span class="boxed underline-blackdashed">مَّرِيضًا</span> أَوْ <span class="boxed underline-blackdashed">بِهِ أَذًى مِّن رَّأْسِهِ</span> فَفِدْيَةٌ مِّن <span class="boxed underline-blackdashed-thick">صِيَامٍ</span> أَوْ <span class="boxed underline-blackdashed-thick">صَدَقَةٍ</span> أَوْ <span class="boxed underline-blackdashed-thick">نُسُكٍ</span> ۚ فَإِذَا أَمِنتُمْ فَمَن تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ ۚ فَمَن لَّمْ يَجِدْ فَصِيَامُ <span class="boxed underline-blackdashed2">ثَلَاثَةِ أَيَّامٍ فِي الْحَجِّ</span> وَ<span class="boxed underline-blackdashed2">سَبْعَةٍ إِذَا رَجَعْتُمْ</span> ۗ تِلْكَ عَشَرَةٌ كَامِلَةٌ ۗ ذَٰلِكَ لِمَن لَّمْ يَكُنْ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ ۚ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ<sup>۱۹۶</sup>
        الْحَجُّ أَشْهُرٌ مَّعْلُومَاتٌ ۚ فَمَن فَرَضَ فِيهِنَّ الْحَجَّ فَ<span class="boxed underline-blackdashed">لَا رَفَثَ</span> وَ<span class="boxed underline-blackdashed">لَا فُسُوقَ</span> وَ<span class="boxed underline-blackdashed">لَا جِدَالَ</span> فِي الْحَجِّ ۗ وَمَا تَفْعَلُوا مِنْ خَيْرٍ يَعْلَمْهُ اللَّهُ ۗ وَ<span class="boxed underline-gradientrev">تَزَوَّدُوا</span> فَإِنَّ خَيْرَ الزَّادِ التَّقْوَىٰ ۚ وَ<span class="boxed underline-gradientrev">اتَّقُونِ</span> يَا أُولِي الْأَلْبَابِ<sup>۱۹۷</sup>
        لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَبْتَغُوا فَضْلًا مِّن رَّبِّكُمْ ۚ فَإِذَا أَفَضْتُم مِّنْ عَرَفَاتٍ فَ<span class="highlight3">اذْكُرُوا</span> اللَّهَ عِندَ الْمَشْعَرِ الْحَرَامِ ۖ وَ<span class="highlight3">اذْكُرُو</span>هُ كَمَا هَدَاكُمْ وَإِن كُنتُم مِّن قَبْلِهِ لَمِنَ الضَّالِّينَ<sup>۱۹۸</sup>
        ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ ۚ إِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ<sup>۱۹۹</sup>
        فَإِذَا قَضَيْتُم مَّنَاسِكَكُمْ فَ<span class="highlight3">اذْكُرُوا</span> اللَّهَ كَ<span class="highlight3">ذِكْرِ</span>كُمْ آبَاءَكُمْ أَوْ أَشَدَّ <span class="highlight3">ذِكْرًا</span> ۗ
      </p>

      <!-- Aya 200 -->
      <p class="big-bullet-near">
        <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">r </span><span> </span>
        <span class="boxed underline-solidred-far">فَمِنَ النَّاسِ مَن يَقُولُ <speech open="" red=""></speech>رَبَّنَا آتِنَا فِي <span class="highlight5">الدُّنْيَا</span><speech close="" red=""></speech> <span style="margin-right:69.0mm"></span>وَمَا لَهُ فِي <span class="highlight6">الْآخِرَةِ</span> مِنْ خَلَاقٍ</span><sup>۲۰۰</sup>
      </p>

      <!-- Aya 201 -->
      <p class="big-bullet-near">
        <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">p </span><span> </span>
        <span class="boxed underline-solidgreen-far">وَمِنْهُم مَّن يَقُولُ <speech open="" green=""></speech>رَبَّنَا آتِنَا <span class="boxed underline-solidgreen">فِي <span class="highlight5">الدُّنْيَا</span> حَسَنَةً</span> وَ<span class="boxed underline-solidgreen">فِي <span class="highlight6">الْآخِرَةِ</span> حَسَنَةً</span> وَ<span class="boxed underline-solidgreen">قِنَا عَذَابَ النَّارِ</span><speech close="" green=""></speech><sup>۲۰۱</sup>
       <span style="margin-right:12.0mm"></span> أُولَـٰئِكَ لَهُمْ نَصِيبٌ مِّمَّا كَسَبُوا</span> ۚ
      </p>

      <!-- Aya 202 -->
      <p class="ordinary-far">
        وَاللَّهُ سَرِيعُ الْحِسَابِ<sup>۲۰۲</sup>
        وَ<span class="highlight3">اذْكُرُوا</span> اللَّهَ فِي أَيَّامٍ مَّعْدُودَاتٍ ۚ فَ<span class="boxed underline-blackdashed2">مَن تَعَجَّلَ فِي يَوْمَيْنِ فَلَا إِثْمَ عَلَيْهِ</span> وَ<span class="boxed underline-blackdashed2">مَن تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ</span> ۚ لِمَنِ اتَّقَىٰ ۗ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّكُمْ إِلَيْهِ تُحْشَرُونَ<sup>۲۰۳</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <!-- Aya 204 -->
    <p class="small-bullet-near-2">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
      <span class="underline-solidred-far2"><span class="boxed underline-solidred-far2">وَمِنَ النَّاسِ مَن <span class="boxed underline-red-far">يُعْجِبُكَ قَوْلُهُ فِي الْحَيَاةِ <span class="highlight5">الدُّنْيَا</span></span> وَ<span class="boxed underline-red-far">يُشْهِدُ اللَّهَ عَلَىٰ مَا فِي قَلْبِهِ وَهُوَ أَلَدُّ الْخِصَامِ</span><sup>۲۰۴</sup>
      وَإِذَا تَوَلَّىٰ سَعَىٰ فِي الْأَرْضِ لِ<span class="boxed underline-solidred-far">يُفْسِدَ فِيهَا</span> وَ<span class="boxed underline-solidred-far">يُهْلِكَ <span class="boxed underline-red">الْحَرْثَ</span> وَ<span class="boxed underline-red">النَّسْلَ</span></span> ۗ وَاللَّهُ لَا يُحِبُّ الْفَسَادَ<sup>۲۰۵</sup>
      وَإِذَا قِيلَ لَهُ <speech open="" green=""></speech>اتَّقِ اللَّهَ<speech close="" green=""></speech> أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ ۚ فَحَسْبُهُ جَهَنَّمُ ۚ وَلَبِئْسَ الْمِهَادُ</span></span><sup>۲۰۶</sup>
    </p>

    <!-- Aya 207 -->
    <p class="small-bullet-far-2">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
      <span class="boxed underline-solidgreen-far2">وَمِنَ النَّاسِ مَن يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ ۗ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ</span><sup>۲۰۷</sup>
    </p>

    <!-- Aya 208 -->
    <p class="big-bullet-far">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
      يَا أَيُّهَا الَّذِينَ آمَنُوا <span class="boxed underline-gradient">ادْخُلُوا</span> فِي السِّلْمِ كَافَّةً وَ<span class="boxed underline-gradient">لَا تَتَّبِعُوا</span> خُطُوَاتِ الشَّيْطَانِ ۚ إِنَّهُ لَكُمْ عَدُوٌّ مُّبِينٌ<sup>۲۰۸</sup>
      فَإِن زَلَلْتُم مِّن بَعْدِ مَا جَاءَتْكُمُ الْبَيِّنَاتُ فَاعْلَمُوا أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ<sup>۲۰۹</sup>
    </p>

    <!-- Aya 210 -->
    <p class="ordinary-far">
      هَلْ يَنظُرُونَ إِلَّا أَن يَأْتِيَهُمُ <span class="boxed underline-blackdashed">اللَّهُ فِي ظُلَلٍ مِّنَ الْغَمَامِ</span> وَ<span class="boxed underline-blackdashed">الْمَلَائِكَةُ</span> وَ<span class="boxed underline-blackdashed">قُضِيَ الْأَمْرُ</span> ۚ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ<sup>۲۱۰</sup>
      سَلْ بَنِي إِسْرَائِيلَ كَمْ آتَيْنَاهُم مِّنْ آيَةٍ بَيِّنَةٍ ۗ وَمَن يُبَدِّلْ نِعْمَةَ اللَّهِ مِن بَعْدِ مَا جَاءَتْهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ<sup>۲۱۱</sup>
      <span class="boxed underline-notsure">
      <span class="boxed underline-blackdotted">زُيِّنَ لِلَّذِينَ كَفَرُوا الْحَيَاةُ <span class="highlight5">الدُّنْيَا</span></span> وَ<span class="boxed underline-blackdotted">يَسْخَرُونَ مِنَ الَّذِينَ آمَنُوا</span> ۘ وَالَّذِينَ اتَّقَوْا فَوْقَهُمْ يَوْمَ الْقِيَامَةِ ۗ وَاللَّهُ يَرْزُقُ مَن يَشَاءُ بِغَيْرِ حِسَابٍ<sup>۲۱۲</sup>
      </span>
    </p>

    <!-- Aya 213 -->
    <p class="ordinary-far">
      كَانَ النَّاسُ أُمَّةً وَاحِدَةً فَ<span class="boxed underline-gradient">بَعَثَ</span> اللَّهُ النَّبِيِّينَ <span class="boxed underline-blackdashed2">مُبَشِّرِينَ</span> وَ<span class="boxed underline-blackdashed2">مُنذِرِينَ</span> وَ<span class="boxed underline-gradient">أَنزَلَ</span> مَعَهُمُ الْكِتَابَ بِالْحَقِّ لِيَحْكُمَ بَيْنَ النَّاسِ فِيمَا اخْتَلَفُوا فِيهِ ۚ وَمَا اخْتَلَفَ فِيهِ إِلَّا الَّذِينَ أُوتُوهُ مِن بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ بَغْيًا بَيْنَهُمْ ۖ فَهَدَى اللَّهُ الَّذِينَ آمَنُوا لِمَا اخْتَلَفُوا فِيهِ مِنَ الْحَقِّ بِإِذْنِهِ ۗ وَاللَّهُ يَهْدِي مَن يَشَاءُ إِلَىٰ صِرَاطٍ مُّسْتَقِيمٍ<sup>۲۱۳</sup>
      <span class="underline-notsure">
      أَمْ حَسِبْتُمْ أَن تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَأْتِكُم مَّثَلُ الَّذِينَ خَلَوْا مِن قَبْلِكُم ۖ <span class="boxed underline-blackdashed-far">مَّسَّتْهُمُ <span class="boxed underline-blackdashed">الْبَأْسَاءُ</span> وَ<span class="boxed underline-blackdashed">الضَّرَّاءُ</span></span> وَ<span class="boxed underline-blackdashed-far">زُلْزِلُوا</span> حَتَّىٰ يَقُولَ <span class="boxed underline-black-3">الرَّسُولُ</span> وَ<span class="boxed underline-black-3">الَّذِينَ آمَنُوا مَعَهُ</span> <speech open="" green=""></speech>مَتَىٰ نَصْرُ اللَّهِ<speech close="" green=""></speech> ۗ أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ<sup>۲۱۴</sup>
      </span>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      يَسْأَلُونَكَ مَاذَا يُنفِقُونَ ۖ
    </p>

    <!-- Aya 215 -->
    <p class="small-bullet-far">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلْ <speech open="" green=""></speech>مَا أَنفَقْتُم مِّنْ خَيْرٍ فَلِ<span class="boxed underline-blackdashed">لْوَالِدَيْنِ</span>
      وَ<span class="boxed underline-blackdashed">الْأَقْرَبِينَ</span>
      وَ<span class="boxed underline-blackdashed">الْيَتَامَىٰ</span>
      وَ<span class="boxed underline-blackdashed">الْمَسَاكِينِ</span>
      وَ<span class="boxed underline-blackdashed">ابْنِ السَّبِيلِ</span> ۗ
      وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ<speech close="" green=""></speech><sup>۲۱۵</sup>
    </p>

    <div class="ordinary-far">
      <span class="boxed">كُتِبَ عَلَيْكُمُ</span> الْقِتَالُ وَهُوَ كُرْهٌ لَّكُمْ ۖ
      <span style="margin-left: 12mm;"></span>

      <div class="inner-paragraph-12">
        <p class="zero-margin">
          وَعَسَىٰ أَن تَكْرَهُوا شَيْئًا وَهُوَ خَيْرٌ لَّكُمْ ۖ
        </p>

        <!-- Aya 216 -->
        <p class="zero-margin">
          وَعَسَىٰ أَن تُحِبُّوا شَيْئًا وَهُوَ شَرٌّ لَّكُمْ ۗ
        </p>
      </div>
      <span style="vertical-align: bottom; margin-top:1.5mm;">
      وَ<span class="boxed underline-blackdashed2">اللَّهُ يَعْلَمُ</span> وَ<span class="boxed underline-blackdashed2">أَنتُمْ لَا تَعْلَمُونَ</span><sup>۲۱۶</sup>
      </span>
    </div>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ ۖ
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلْ <speech open="" green=""></speech>قِتَالٌ فِيهِ كَبِيرٌ ۖ وَ<span class="boxed underline-blackdotted">صَدٌّ عَن سَبِيلِ اللَّهِ</span> وَ<span class="boxed underline-blackdotted">كُفْرٌ بِهِ</span> وَ<span class="boxed underline-blackdotted">الْمَسْجِدِ الْحَرَامِ</span> وَ<span class="boxed underline-blackdotted">إِخْرَاجُ أَهْلِهِ مِنْهُ</span> أَكْبَرُ عِندَ اللَّهِ ۚ وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ<speech close="" green=""></speech> ۗ
    </p>

    <!-- Aya 217 -->
    <p class="ordinary-far">
      <span class="underline-notsure">
      وَلَا يَزَالُونَ يُقَاتِلُونَكُمْ حَتَّىٰ يَرُدُّوكُمْ عَن دِينِكُمْ إِنِ اسْتَطَاعُوا ۚ وَ<span class="boxed underline-solidred-far">مَن يَرْتَدِدْ مِنكُمْ عَن دِينِهِ فَيَمُتْ وَهُوَ كَافِرٌ فَ<span class="boxed underline-gradientred">أُولَـٰئِكَ</span> حَبِطَتْ أَعْمَالُهُمْ فِي <span class="boxed underline-blackdashed2"><span class="highlight5">الدُّنْيَا</span></span> وَ<span class="boxed underline-blackdashed2"><span class="highlight6">الْآخِرَةِ</span></span> ۖ وَ<span class="boxed underline-gradientred">أُولَـٰئِكَ</span> أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ</span><sup>۲۱۷</sup><span class="underline-solidgreen-far">
      <span class="boxed underline-solidgreen-far2">إِنَّ <span class="boxed underline-solidgreen-far">الَّذِينَ آمَنُوا</span> وَ<span class="boxed underline-solidgreen-far">الَّذِينَ <span class="boxed underline-solidgreen">هَاجَرُوا</span> وَ<span class="boxed underline-solidgreen">جَاهَدُوا فِي سَبِيلِ اللَّهِ</span></span> <span class="boxed underline-gradientgreen">أُولَـٰئِكَ</span> يَرْجُونَ رَحْمَتَ اللَّهِ ۚ وَاللَّهُ غَفُورٌ رَّحِيمٌ</span></span><sup>۲۱۸</sup>
      </span>
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      يَسْأَلُونَكَ عَنِ <span class="boxed underline-blackdotted">الْخَمْرِ</span> وَ<span class="boxed underline-blackdotted">الْمَيْسِرِ</span> ۖ
    </p>

    <p class="small-bullet-far">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلْ <speech open="" green=""></speech>فِيهِمَا <span class="boxed underline-blackdashed2">إِثْمٌ كَبِيرٌ</span> وَ<span class="boxed underline-blackdashed2">مَنَافِعُ لِلنَّاسِ</span> وَإِثْمُهُمَا أَكْبَرُ مِن نَّفْعِهِمَا<speech close="" green=""></speech> ۗ
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      وَيَسْأَلُونَكَ مَاذَا يُنفِقُونَ
    </p>

    <p class="small-bullet-far">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلِ <speech open="" green=""></speech>الْعَفْوَ<speech close="" green=""></speech> ۗ
    </p>

    <!-- Aya 219 -->
    <p class="ordinary-far">
      كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ<sup>۲۱۹</sup>
      فِي <span class="boxed underline-blackdashed2"><span class="highlight5">الدُّنْيَا</span></span> وَ<span class="boxed underline-blackdashed2"><span class="highlight6">الْآخِرَةِ</span></span> ۗ
    </p>

    <p class="small-bullet-near">
      <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
      وَيَسْأَلُونَكَ عَنِ الْيَتَامَىٰ ۖ
    </p>

    <!-- Aya 220 -->
    <p class="small-bullet-far">
      <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
      قُلْ <speech open="" green=""></speech>إِصْلَاحٌ لَّهُمْ خَيْرٌ ۖ وَإِن تُخَالِطُوهُمْ فَإِخْوَانُكُمْ ۚ
      وَاللَّهُ يَعْلَمُ الْمُفْسِدَ مِنَ الْمُصْلِحِ ۚ وَلَوْ شَاءَ اللَّهُ لَأَعْنَتَكُمْ ۚ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ<speech close="" green=""></speech><sup>۲۲۰</sup>
    </p>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <p class="ordinary-near">
        <span class="boxed underline-gradient">وَلَا تَنكِحُوا</span> الْمُشْرِكَاتِ حَتَّىٰ يُؤْمِنَّ ۚ وَلَأَمَةٌ مُّؤْمِنَةٌ خَيْرٌ مِّن مُّشْرِكَةٍ وَلَوْ أَعْجَبَتْكُمْ ۗ
      </p>

      <p class="ordinary-near">
        <span class="boxed underline-gradient">وَلَا تُنكِحُوا</span> الْمُشْرِكِينَ حَتَّىٰ يُؤْمِنُوا ۚ وَلَعَبْدٌ مُّؤْمِنٌ خَيْرٌ مِّن مُّشْرِكٍ وَلَوْ أَعْجَبَكُمْ ۗ
      </p>

      <!-- Aya 221 -->
      <p class="ordinary-far">
        <span class="boxed underline-solidred-far">أُولَـٰئِكَ يَدْعُونَ إِلَى النَّارِ</span> ۖ وَ<span class="boxed underline-solidgreen-far">اللَّهُ يَدْعُو إِلَى <span class="boxed underline-black-3">الْجَنَّةِ</span> وَ<span class="boxed underline-black-3">الْمَغْفِرَةِ</span> بِإِذْنِهِ</span> ۖ وَيُبَيِّنُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ<sup>۲۲۱</sup>
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Wingdings&quot;;">h </span><span> </span>
        وَيَسْأَلُونَكَ عَنِ الْمَحِيضِ ۖ
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">t </span><span> </span>
        قُلْ <speech open="" green=""></speech>هُوَ أَذًى فَاعْتَزِلُوا النِّسَاءَ فِي الْمَحِيضِ ۖ وَلَا تَقْرَبُوهُنَّ حَتَّىٰ يَطْهُرْنَ ۖ فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ حَيْثُ أَمَرَكُمُ اللَّهُ<speech close="" green=""></speech> ۚ
      </p>

      <!-- Aya 222 -->
      <p class="ordinary-near">
        <span class="boxed underline-notsure">
        إِنَّ اللَّهَ <span class="boxed underline-black-3">يُحِبُّ التَّوَّابِينَ</span> وَ<span class="boxed underline-black-3">يُحِبُّ الْمُتَطَهِّرِينَ</span><sup>۲۲۲</sup></span>
      </p>

      <!-- Aya 223 -->
      <p class="ordinary-far">
        نِسَاؤُكُمْ حَرْثٌ لَّكُمْ فَ<span class="boxed underline-gradientrev">أْتُوا</span> حَرْثَكُمْ أَنَّىٰ شِئْتُمْ ۖ وَ<span class="boxed underline-gradientrev">قَدِّمُوا</span> لِأَنفُسِكُمْ ۚ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّكُم مُّلَاقُوهُ ۗ وَبَشِّرِ الْمُؤْمِنِينَ<sup>۲۲۳</sup>
      </p>

      <!-- Aya 224 -->
      <p class="ordinary-far">
        وَلَا تَجْعَلُوا اللَّهَ عُرْضَةً لِّأَيْمَانِكُمْ أَن <span class="boxed underline-black-3">تَبَرُّوا</span> وَ<span class="boxed underline-black-3">تَتَّقُوا</span> وَ<span class="boxed underline-black-3">تُصْلِحُوا بَيْنَ النَّاسِ</span> ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ<sup>۲۲۴</sup>
        لَّا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَـٰكِن يُؤَاخِذُكُم بِمَا كَسَبَتْ قُلُوبُكُمْ ۗ وَاللَّهُ غَفُورٌ حَلِيمٌ<sup>۲۲۵</sup>
      </p>

      <!-- Aya 226 -->
      <p class="ordinary-far">
        لِّلَّذِينَ يُؤْلُونَ مِن نِّسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ ۖ فَإِن فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ<sup>۲۲۶</sup>
        وَإِنْ عَزَمُوا <span class="highlight2">الطَّلَاقَ</span> فَإِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ<sup>۲۲۷</sup>
      </p>

      <!-- Aya 228 -->
      <p class="ordinary-near">
        وَ<span class="highlight2">الْمُطَلَّقَاتُ</span> يَتَرَبَّصْنَ بِأَنفُسِهِنَّ ثَلَاثَةَ قُرُوءٍ ۚ وَلَا يَحِلُّ لَهُنَّ أَن يَكْتُمْنَ مَا خَلَقَ اللَّهُ فِي أَرْحَامِهِنَّ إِن كُنَّ يُؤْمِنَّ بِ<span class="boxed underline-black-2">اللَّهِ</span> وَ<span class="boxed underline-black-2">الْيَوْمِ الْآخِرِ</span> ۚ وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ فِي ذَٰلِكَ إِنْ أَرَادُوا إِصْلَاحًا ۚ وَلَهُنَّ مِثْلُ الَّذِي عَلَيْهِنَّ بِالْمَعْرُوفِ ۚ وَلِلرِّجَالِ عَلَيْهِنَّ دَرَجَةٌ ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ<sup>۲۲۸</sup>
        <span class="highlight2">الطَّلَاقُ</span> مَرَّتَانِ ۖ فَ<span class="boxed underline-blackdashed2">إِمْسَاكٌ بِمَعْرُوفٍ</span> أَوْ <span class="boxed underline-blackdashed2">تَسْرِيحٌ بِإِحْسَانٍ</span> ۗ وَلَا يَحِلُّ لَكُمْ أَن تَأْخُذُوا مِمَّا آتَيْتُمُوهُنَّ شَيْئًا إِلَّا أَن يَخَافَا أَلَّا يُقِيمَا حُدُودَ اللَّهِ ۖ فَإِنْ خِفْتُمْ أَلَّا يُقِيمَا حُدُودَ اللَّهِ فَلَا جُنَاحَ عَلَيْهِمَا فِيمَا افْتَدَتْ بِهِ ۗ تِلْكَ حُدُودُ اللَّهِ فَلَا تَعْتَدُوهَا ۚ وَمَن يَتَعَدَّ حُدُودَ اللَّهِ فَأُولَـٰئِكَ هُمُ الظَّالِمُونَ<sup>۲۲۹</sup>
        فَإِن <span class="highlight2">طَلَّقَ</span>هَا فَلَا تَحِلُّ لَهُ مِن بَعْدُ حَتَّىٰ تَنكِحَ زَوْجًا غَيْرَهُ ۗ فَإِن <span class="highlight2">طَلَّقَ</span>هَا فَلَا جُنَاحَ عَلَيْهِمَا أَن يَتَرَاجَعَا إِن ظَنَّا أَن يُقِيمَا حُدُودَ اللَّهِ ۗ وَتِلْكَ حُدُودُ اللَّهِ يُبَيِّنُهَا لِقَوْمٍ يَعْلَمُونَ<sup>۲۳۰</sup>
      </p>

      <!-- Aya 231 -->
      <p class="small-bullet-near-2">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
        <span class="boxed underline-three">وَإِذَا <span class="highlight2">طَلَّقْتُمُ</span> النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ</span> فَ<span class="boxed underline-blackdashed2">أَمْسِكُوهُنَّ بِمَعْرُوفٍ</span> أَوْ <span class="boxed underline-blackdashed2">سَرِّحُوهُنَّ بِمَعْرُوفٍ</span> ۚ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِّتَعْتَدُوا ۚ وَمَن يَفْعَلْ ذَٰلِكَ فَقَدْ ظَلَمَ نَفْسَهُ ۚ وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا ۚ وَاذْكُرُوا <span class="boxed underline-black-far">نِعْمَتَ اللَّهِ عَلَيْكُمْ</span> وَ<span class="boxed underline-black-far">مَا أَنزَلَ عَلَيْكُم مِّنَ <span class="boxed underline-black-2">الْكِتَابِ</span> وَ<span class="boxed underline-black-2">الْحِكْمَةِ</span> يَعِظُكُم بِهِ</span> ۚ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ<sup>۲۳۱</sup>
      </p>

      <!-- Aya 232 -->
      <p class="small-bullet-far-2">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
        <span class="boxed underline-three">وَإِذَا <span class="highlight2">طَلَّقْتُمُ</span> النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ</span> فَلَا تَعْضُلُوهُنَّ أَن يَنكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُم بِالْمَعْرُوفِ ۗ ذَٰلِكَ يُوعَظُ بِهِ مَن كَانَ مِنكُمْ يُؤْمِنُ بِ<span class="boxed underline-black-2">اللَّهِ</span> وَ<span class="boxed underline-black-2">الْيَوْمِ الْآخِرِ</span> ۗ ذَٰلِكُمْ <span class="boxed underline-black-3">أَزْكَىٰ لَكُمْ</span> وَ<span class="boxed underline-black-3">أَطْهَرُ</span> ۗ وَ<span class="boxed underline-blackdashed2">اللَّهُ يَعْلَمُ</span> وَ<span class="boxed underline-blackdashed2">أَنتُمْ لَا تَعْلَمُونَ</span><sup>۲۳۲</sup>
      </p>

      <!-- Aya 233 -->
      <p class="ordinary-far">
        وَ<span class="highlight7">الْوَالِدَاتُ</span> يُرْضِعْنَ <span class="highlight7">أَوْلَادَهُنَّ</span> حَوْلَيْنِ كَامِلَيْنِ ۖ لِمَنْ أَرَادَ أَن يُتِمَّ الرَّضَاعَةَ ۚ وَعَلَى <span class="highlight7">الْمَوْلُودِ</span> لَهُ <span class="boxed underline-blackdashed2">رِزْقُهُنَّ</span> وَ<span class="boxed underline-blackdashed2">كِسْوَتُهُنَّ</span> بِالْمَعْرُوفِ ۚ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَا ۚ لَا <span class="boxed underline-blackdashed">تُضَارَّ <span class="highlight7">وَالِدَةٌ</span> بِ<span class="highlight7">وَلَدِ</span>هَا</span> وَلَا <span class="boxed underline-blackdashed"><span class="highlight7">مَوْلُودٌ</span> لَّهُ بِ<span class="highlight7">وَلَدِ</span>هِ</span> ۚ وَعَلَى الْوَارِثِ مِثْلُ ذَٰلِكَ ۗ فَإِنْ أَرَادَا فِصَالًا عَن<span class="boxed underline-blackdashed2"> تَرَاضٍ مِّنْهُمَا</span> وَ<span class="boxed underline-blackdashed2">تَشَاوُرٍ</span> فَلَا جُنَاحَ عَلَيْهِمَا ۗ وَإِنْ أَرَدتُّمْ أَن تَسْتَرْضِعُوا <span class="highlight7">أَوْلَادَ</span>كُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْتُم مَّا آتَيْتُم بِالْمَعْرُوفِ ۗ وَ<span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ<sup>۲۳۳</sup>
      </p>

      <!-- Aya 234 -->
      <p class="ordinary-far">
        <span class="boxed underline-three">وَالَّذِينَ <span class="highlight8">يُتَوَفَّوْنَ</span> مِنكُمْ وَيَذَرُونَ أَزْوَاجًا</span> يَتَرَبَّصْنَ بِأَنفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ۖ فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنفُسِهِنَّ بِالْمَعْرُوفِ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ<sup>۲۳۴</sup>
        وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا <span class="boxed underline-blackdashed2">عَرَّضْتُم بِهِ مِنْ خِطْبَةِ النِّسَاءِ</span> أَوْ <span class="boxed underline-blackdashed2">أَكْنَنتُمْ فِي أَنفُسِكُمْ</span> ۚ عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ وَلَـٰكِن لَّا تُوَاعِدُوهُنَّ سِرًّا إِلَّا أَن تَقُولُوا قَوْلًا مَّعْرُوفًا ۚ وَلَا تَعْزِمُوا عُقْدَةَ النِّكَاحِ حَتَّىٰ يَبْلُغَ الْكِتَابُ أَجَلَهُ ۚ وَاعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي أَنفُسِكُمْ فَاحْذَرُوهُ ۚ وَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ<sup>۲۳۵</sup>
      </p>

      <!-- Aya 236 -->
      <p class="ordinary-far">
        لَّا جُنَاحَ عَلَيْكُمْ إِن <span class="highlight2">طَلَّقْتُمُ</span> النِّسَاءَ <span class="boxed underline-blackdashed">مَا لَمْ تَمَسُّوهُنَّ أَوْ تَفْرِضُوا لَهُنَّ فَرِيضَةً</span> ۚ وَمَتِّعُوهُنَّ عَ<span class="boxed underline-blackdashed2">لَى الْمُوسِعِ قَدَرُهُ</span> وَ<span class="boxed underline-blackdashed2">عَلَى الْمُقْتِرِ قَدَرُهُ</span> مَتَاعًا بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُحْسِنِينَ<sup>۲۳۶</sup>
        وَإِن <span class="highlight2">طَلَّقْتُمُو</span>هُنَّ <span class="boxed underline-blackdashed">مِن قَبْلِ أَن تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ لَهُنَّ فَرِيضَةً</span> فَنِصْفُ مَا فَرَضْتُمْ إِلَّا أَن <span class="boxed underline-blackdashed2">يَعْفُونَ</span> أَوْ <span class="boxed underline-blackdashed2">يَعْفُوَ الَّذِي بِيَدِهِ عُقْدَةُ النِّكَاحِ</span> ۚ وَأَن تَعْفُوا أَقْرَبُ لِلتَّقْوَىٰ ۚ وَلَا تَنسَوُا الْفَضْلَ بَيْنَكُمْ ۚ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ<sup>۲۳۷</sup>
      </p>
    </div>

    <div class="container">
      <div class="vertical-line-dashed-1"></div>
      <!-- Aya 238 -->
      <p class="ordinary-far">
        <span class="boxed underline-gradient">حَافِظُوا</span> عَلَى <span class="boxed underline-black-2">الصَّلَوَاتِ</span> وَ<span class="boxed underline-black-2">الصَّلَاةِ الْوُسْطَىٰ</span> وَ<span class="boxed underline-gradient">قُومُوا</span> لِلَّهِ قَانِتِينَ<sup>۲۳۸</sup>
        فَإِنْ خِفْتُمْ فَ<span class="boxed underline-blackdashed">رِجَالًا</span> أَوْ <span class="boxed underline-blackdashed">رُكْبَانًا</span> ۖ فَإِذَا أَمِنتُمْ فَاذْكُرُوا اللَّهَ كَمَا عَلَّمَكُم مَّا لَمْ تَكُونُوا تَعْلَمُونَ<sup>۲۳۹</sup>
      </p>
    </div>

    <div class="container">
      <div class="vertical-line-1"></div>
      <!-- Aya 240 -->
      <p class="ordinary-far">
        <span class="boxed underline-three">وَالَّذِينَ <span class="highlight8">يُتَوَفَّوْنَ</span> مِنكُمْ وَيَذَرُونَ أَزْوَاجًا</span> وَصِيَّةً لِّأَزْوَاجِهِم مَّتَاعًا إِلَى الْحَوْلِ غَيْرَ إِخْرَاجٍ ۚ فَإِنْ خَرَجْنَ فَلَا جُنَاحَ عَلَيْكُمْ فِي مَا فَعَلْنَ فِي أَنفُسِهِنَّ مِن مَّعْرُوفٍ ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ<sup>۲۴۰</sup>
        وَلِ<span class="highlight2">لْمُطَلَّقَاتِ</span> مَتَاعٌ بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُتَّقِينَ<sup>۲۴۱</sup>
      </p>

      <!-- Aya 242 -->
      <p class="ordinary-far">
        كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ<sup>۲۴۲</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-2"></div>
      <div class="vertical-line-2"></div>
      <p class="ordinary-near">
        <span class="boxed underline-gradient">أَلَمْ تَرَ إِلَى</span> الَّذِينَ خَرَجُوا مِن دِيَارِهِمْ وَهُمْ أُلُوفٌ حَذَرَ الْمَوْتِ
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
        فَقَالَ لَهُمُ اللَّهُ <speech open="" blue=""></speech>مُوتُوا<speech close="" blue=""></speech>
      </p>

      <!-- Aya 243 -->
      <p class="ordinary-far">
        ثُمَّ أَحْيَاهُمْ ۚ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَـٰكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ<sup>۲۴۳</sup>
      </p>

      <!-- Aya 244 -->
      <p class="ordinary-near">
        وَ<span class="boxed underline-gradient">قَاتِلُوا</span> فِي سَبِيلِ اللَّهِ وَ<span class="boxed underline-gradient">اعْلَمُوا</span> أَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ<sup>۲۴۴</sup>
      </p>

      <!-- Aya 245 -->
      <p class="ordinary-far">
        مَّن ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً ۚ وَ<span class="boxed underline-blackdashed-far">اللَّهُ <span class="boxed underline-blackdashed2">يَقْبِضُ</span> وَ<span class="boxed underline-blackdashed2">يَبْسُطُ</span></span> وَ<span class="boxed underline-blackdashed-far">إِلَيْهِ تُرْجَعُونَ</span><sup>۲۴۵</sup>
      </p>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <p class="ordinary-near">
          <span class="boxed underline-gradient">أَلَمْ تَرَ إِلَى</span> الْمَلَإِ مِن بَنِي إِسْرَائِيلَ مِن بَعْدِ مُوسَىٰ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Webdings&quot;;">. </span><span> </span>
          إِذْ قَالُوا لِنَبِيٍّ لَّهُمُ <speech open="" mixed=""></speech>ابْعَثْ لَنَا مَلِكًا نُّقَاتِلْ فِي سَبِيلِ اللَّهِ<speech close="" mixed=""></speech> ۖ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          قَالَ <speech open="" green=""></speech>هَلْ عَسَيْتُمْ إِن كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا<speech close="" green=""></speech> ۖ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Webdings&quot;;">. </span><span> </span>
          قَالُوا <speech open="" mixed=""></speech>وَمَا لَنَا أَلَّا نُقَاتِلَ فِي سَبِيلِ اللَّهِ وَقَدْ أُخْرِجْنَا مِن <span class="boxed underline-blackdashed2">دِيَارِنَا</span> وَ<span class="boxed underline-blackdashed2">أَبْنَائِنَا</span><speech close="" mixed=""></speech> ۖ
        </p>

        <!-- Aya 246 -->
        <p class="small-bullet-near">
          فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ تَوَلَّوْا إِلَّا قَلِيلًا مِّنْهُمْ ۗ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ<sup>۲۴۶</sup>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          وَقَالَ <speech open="" green=""></speech>لَهُمْ نَبِيُّهُمْ إِنَّ اللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًا<speech close="" green=""></speech> ۚ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:&quot;Webdings&quot;;">. </span><span> </span>
          قَالُوا <speech open="" mixed=""></speech>أَنَّىٰ يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِالْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِّنَ الْمَالِ<speech close="" mixed=""></speech> ۚ
        </p>

        <!-- Aya 247 -->
        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          قَالَ <speech open="" green=""></speech>إِنَّ اللَّهَ <span class="boxed underline-blackdashed-far">اصْطَفَاهُ عَلَيْكُمْ</span> وَ<span class="boxed underline-blackdashed-far">زَادَهُ بَسْطَةً فِي <span class="boxed underline-blackdashed">الْعِلْمِ</span> وَ<span class="boxed underline-blackdashed">الْجِسْمِ</span></span> ۖ وَاللَّهُ يُؤْتِي مُلْكَهُ مَن يَشَاءُ ۚ وَاللَّهُ وَاسِعٌ عَلِيمٌ<speech close="" green=""></speech><sup>۲۴۷</sup>
        </p>

        <!-- Aya 248 -->
        <p class="small-bullet-far">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          وَقَالَ لَهُمْ نَبِيُّهُمْ <speech open="" green=""></speech>إِنَّ آيَةَ مُلْكِهِ أَن يَأْتِيَكُمُ التَّابُوتُ فِيهِ <span class="boxed underline-blackdashed-far">سَكِينَةٌ مِّن رَّبِّكُمْ</span> وَ<span class="boxed underline-blackdashed-far">بَقِيَّةٌ مِّمَّا تَرَكَ <span class="boxed underline-blackdashed">آلُ مُوسَىٰ</span> وَ<span class="boxed underline-blackdashed">آلُ هَارُونَ</span></span> تَحْمِلُهُ الْمَلَائِكَةُ ۚ إِنَّ فِي ذَٰلِكَ لَآيَةً لَّكُمْ إِن كُنتُم مُّؤْمِنِينَ<speech close="" green=""></speech><sup>۲۴۸</sup>
        </p>

        <p class="ordinary-near">
          فَلَمَّا فَصَلَ طَالُوتُ بِالْجُنُودِ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">u </span><span> </span>
          قَالَ <speech open="" green=""></speech>إِنَّ اللَّهَ مُبْتَلِيكُم بِنَهَرٍ فَ<span class="boxed underline-red">مَن شَرِبَ مِنْهُ فَلَيْسَ مِنِّي</span> وَ<span class="boxed underline-green">مَن لَّمْ يَطْعَمْهُ فَإِنَّهُ مِنِّي إِلَّا مَنِ اغْتَرَفَ غُرْفَةً بِيَدِهِ</span><speech close="" green=""></speech> ۚ
        </p>

        <p class="ordinary-near">
          فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِّنْهُمْ ۚ فَلَمَّا جَاوَزَهُ هُوَ وَالَّذِينَ آمَنُوا مَعَهُ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">sq </span><span> </span>
          قَالُوا <speech open="" mixed=""></speech>لَا طَاقَةَ لَنَا الْيَوْمَ بِ<span class="boxed underline-blackdotted">جَالُوتَ</span> وَ<span class="boxed underline-blackdotted">جُنُودِهِ</span><speech close="" mixed=""></speech> ۚ
        </p>

        <!-- Aya 249 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">q </span><span> </span>
          قَالَ الَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَاقُو اللَّهِ <speech open="" green=""></speech>كَم مِّن فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةً بِإِذْنِ اللَّهِ ۗ وَاللَّهُ مَعَ الصَّابِرِينَ<speech close="" green=""></speech><sup>۲۴۹</sup>
        </p>

        <p class="ordinary-near">
          وَلَمَّا بَرَزُوا لِ<span class="boxed underline-blackdotted">جَالُوتَ</span> وَ<span class="boxed underline-blackdotted">جُنُودِهِ</span>
        </p>

        <!-- Aya 250 -->
        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">q </span><span> </span>
          قَالُوا <speech open="" green=""></speech>رَبَّنَا <span class="boxed underline-black-3">أَفْرِغْ عَلَيْنَا صَبْرًا</span> وَ<span class="boxed underline-black-3">ثَبِّتْ أَقْدَامَنَا</span> وَ<span class="boxed underline-black-3">انصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ</span><speech close="" green=""></speech><sup>۲۵۰</sup>
        </p>

        <!-- Aya 251 -->
        <p class="ordinary-far">
          فَ<span class="boxed underline-gradientsym1">هَزَمُو</span>هُم بِإِذْنِ اللَّهِ وَ<span class="boxed underline-gradientsym1">قَتَلَ</span> دَاوُودُ جَالُوتَ وَ<span class="boxed underline-black-far">آتَاهُ اللَّهُ <span class="boxed underline-black-1">الْمُلْكَ</span> وَ<span class="boxed underline-black-1">الْحِكْمَةَ</span></span> وَ<span class="boxed underline-black-far">عَلَّمَهُ مِمَّا يَشَاءُ</span> ۗ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُم بِبَعْضٍ لَّفَسَدَتِ الْأَرْضُ وَلَـٰكِنَّ اللَّهَ ذُو فَضْلٍ عَلَى الْعَالَمِينَ<sup>۲۵۱</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <!-- Aya 252 -->
      <p class="ordinary-far">
        تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ ۚ وَإِنَّكَ لَمِنَ الْمُرْسَلِينَ<sup>۲۵۲</sup>
      </p>

      <div class="diamond-marker bottom-2"></div>
    </div>

    <!-- Aya 253 -->
    <p class="ordinary-far">
      تِلْكَ الرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْضٍ ۘ <span class="boxed underline-black-far">مِّنْهُم مَّن كَلَّمَ اللَّهُ</span> ۖ وَ<span class="boxed underline-black-far">رَفَعَ بَعْضَهُمْ دَرَجَاتٍ</span> ۚ وَ<span class="boxed underline-black-far"><span class="boxed underline-black-3">آتَيْنَا عِيسَى ابْنَ مَرْيَمَ الْبَيِّنَاتِ</span> وَ<span class="boxed underline-black-3">أَيَّدْنَاهُ بِرُوحِ الْقُدُسِ</span></span> ۗ وَلَوْ شَاءَ اللَّهُ مَا اقْتَتَلَ الَّذِينَ مِن بَعْدِهِم مِّن بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ وَلَـٰكِنِ اخْتَلَفُوا فَ<span class="boxed underline-solidgreen">مِنْهُم مَّنْ آمَنَ</span> وَ<span class="boxed underline-solidred">مِنْهُم مَّن كَفَرَ</span> ۚ وَلَوْ شَاءَ اللَّهُ مَا اقْتَتَلُوا وَلَـٰكِنَّ اللَّهَ يَفْعَلُ مَا يُرِيدُ<sup>۲۵۳</sup>
    </p>

    <!-- Aya 254 -->
    <p class="big-bullet-far">
      <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
      يَا أَيُّهَا الَّذِينَ آمَنُوا أَنفِقُوا مِمَّا رَزَقْنَاكُم مِّن قَبْلِ أَن يَأْتِيَ يَوْمٌ <span class="boxed underline-blackdashed">لَّا بَيْعٌ فِيهِ</span> وَ<span class="boxed underline-blackdashed">لَا خُلَّةٌ</span> وَ<span class="boxed underline-blackdashed">لَا شَفَاعَةٌ</span> ۗ وَالْكَافِرُونَ هُمُ الظَّالِمُونَ<sup>۲۵۴</sup>
    </p>

    <!-- Aya 255 -->
    <p class="ordinary-far">
      اللَّهُ لَا إِلَـٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ <span class="boxed underline-blackdashed2">سِنَةٌ</span> وَلَا <span class="boxed underline-blackdashed2">نَوْمٌ</span> ۚ لَّهُ <span class="boxed underline-blackdashed2">مَا فِي السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">مَا فِي الْأَرْضِ</span> ۗ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ <span class="boxed underline-blackdashed2">مَا بَيْنَ أَيْدِيهِمْ</span> وَ<span class="boxed underline-blackdashed2">مَا خَلْفَهُمْ</span> ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ <span class="boxed underline-blackdashed2">السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">الْأَرْضَ</span> ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ<sup>۲۵۵</sup>
    </p>

    <!-- Aya 256 -->
    <p class="ordinary-far">
      لَا إِكْرَاهَ فِي الدِّينِ ۖ قَد تَّبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ ۚ فَمَن <span class="boxed underline-black-3">يَكْفُرْ بِالطَّاغُوتِ</span> وَ<span class="boxed underline-black-3">يُؤْمِن بِاللَّهِ</span> فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَىٰ لَا انفِصَامَ لَهَا ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ<sup>۲۵۶</sup>
      <span class="boxed underline-solidgreen">اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُم مِّنَ الظُّلُمَاتِ إِلَى النُّورِ</span> ۖ وَ<span class="boxed underline-solidred">الَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُم مِّنَ النُّورِ إِلَى الظُّلُمَاتِ ۗ أُولَـٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ</span><sup>۲۵۷</sup>
    </p>

    <div class="container">
      <div class="diamond-marker top-2"></div>
      <div class="vertical-line-2"></div>
      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <p class="ordinary-near">
          <span class="boxed underline-gradient">أَلَمْ تَرَ إِلَى</span> الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          إِذْ قَالَ إِبْرَاهِيمُ <speech open="" green=""></speech>رَبِّيَ الَّذِي <span class="boxed underline-blackdashed">يُحْيِي</span> وَ<span class="boxed underline-blackdashed">يُمِيتُ</span><speech close="" green=""></speech>
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">o </span><span> </span>
          قَالَ <speech open="" red=""></speech>أَنَا <span class="boxed underline-blackdashed">أُحْيِي</span> وَ<span class="boxed underline-blackdashed">أُمِيتُ</span><speech close="" red=""></speech> ۖ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
          قَالَ إِبْرَاهِيمُ <speech open="" green=""></speech>فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ<speech close="" green=""></speech>
        </p>

        <!-- Aya 258 -->
        <p class="ordinary-far">
          فَبُهِتَ الَّذِي كَفَرَ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ<sup>۲۵۸</sup>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="container">
        <div class="diamond-marker top-1"></div>
        <div class="vertical-line-1"></div>
        <p class="ordinary-near">
          أَوْ كَالَّذِي مَرَّ عَلَىٰ قَرْيَةٍ وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">u </span><span> </span>
          قَالَ <speech open="" green=""></speech>أَنَّىٰ يُحْيِي هَـٰذِهِ اللَّهُ بَعْدَ مَوْتِهَا<speech close="" green=""></speech> ۖ
        </p>

        <p class="ordinary-near">
          فَأَمَاتَهُ اللَّهُ مِائَةَ عَامٍ ثُمَّ بَعَثَهُ ۖ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
          قَالَ <speech open="" blue=""></speech>كَمْ لَبِثْتَ<speech close="" blue=""></speech> ۖ
        </p>

        <p class="small-bullet-near">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">u </span><span> </span>
          قَالَ <speech open="" green=""></speech>لَبِثْتُ <span class="boxed underline-blackdashed2">يَوْمًا</span> أَوْ <span class="boxed underline-blackdashed2">بَعْضَ يَوْمٍ</span><speech close="" green=""></speech> ۖ
        </p>

        <div class="small-bullet-near">
          <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
          قَالَ <speech open="" blue=""></speech>بَل لَّبِثْتَ مِائَةَ عَامٍ
          <span style="margin-left: 2mm;"></span>

          <div class="inner-paragraph-13">
            <p class="zero-margin2">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              فَانظُرْ إِلَىٰ <span class="boxed underline-blackdashed2">طَعَامِكَ</span> وَ<span class="boxed underline-blackdashed2">شَرَابِكَ</span> لَمْ يَتَسَنَّهْ ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              وَانظُرْ إِلَىٰ حِمَارِكَ وَلِنَجْعَلَكَ آيَةً لِّلنَّاسِ ۖ
            </p>

            <p class="zero-margin2">
              <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
              وَانظُرْ إِلَى الْعِظَامِ كَيْفَ نُنشِزُهَا ثُمَّ نَكْسُوهَا لَحْمًا<speech close="" blue=""></speech> ۚ
            </p>
          </div>
        </div>

        <p class="ordinary-near">
          فَلَمَّا تَبَيَّنَ لَهُ
        </p>

        <!-- Aya 259 -->
        <p class="small-bullet-far">
          <span style="font-size:3.0mm;line-height:240%;font-family:Wingdings;">u </span><span> </span>
          قَالَ <speech open="" green=""></speech>أَعْلَمُ أَنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<speech close="" green=""></speech><sup>۲۵۹</sup>
        </p>
      <p></p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
        وَإِذْ قَالَ إِبْرَاهِيمُ <speech open="" green=""></speech>رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَىٰ<speech close="" green=""></speech> ۖ
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
        قَالَ <speech open="" blue=""></speech>أَوَلَمْ تُؤْمِن<speech close="" blue=""></speech> ۖ
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
        قَالَ <speech open="" green=""></speech>بَلَىٰ وَلَـٰكِن لِّيَطْمَئِنَّ قَلْبِي<speech close="" green=""></speech> ۖ
      </p>

      <!-- Aya 260 -->
      <p class="small-bullet-far">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">l </span><span> </span>
        قَالَ <speech open="" blue=""></speech>فَخُذْ أَرْبَعَةً مِّنَ الطَّيْرِ فَصُرْهُنَّ إِلَيْكَ <span class="boxed underline-gradientsym2">ثُمَّ</span> اجْعَلْ عَلَىٰ كُلِّ جَبَلٍ مِّنْهُنَّ جُزْءًا <span class="boxed underline-gradientsym2">ثُمَّ</span> ادْعُهُنَّ يَأْتِينَكَ سَعْيًا ۚ وَاعْلَمْ أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ<speech close="" blue=""></speech><sup>۲۶۰</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <div class="diamond-marker bottom-2"></div>
  </div>

  <div class="container">
    <div class="diamond-marker top-2"></div>
    <div class="vertical-line-2"></div>
    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <!-- Aya 261 -->
      <p class="ordinary-far">
        مَّثَلُ الَّذِينَ <span class="highlight9">يُنفِقُونَ</span> أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنبُلَةٍ مِّائَةُ حَبَّةٍ ۗ وَاللَّهُ يُضَاعِفُ لِمَن يَشَاءُ ۗ وَاللَّهُ وَاسِعٌ عَلِيمٌ<sup>۲۶۱</sup>
      </p>

      <!-- Aya 262 -->
      <p class="ordinary-near">
        الَّذِينَ <span class="highlight9">يُنفِقُونَ</span> أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ ثُمَّ لَا يُتْبِعُونَ مَا <span class="highlight9">أَنفَقُوا</span> <span class="boxed underline-blackdotted">مَنًّا</span> وَلَا <span class="boxed underline-blackdotted">أَذًى</span> ۙ <span class="boxed underline-black-2">لَّهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ</span> وَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span><sup>۲۶۲</sup>
        <span class="boxed underline-black-3">قَوْلٌ مَّعْرُوفٌ</span> وَ<span class="boxed underline-black-3">مَغْفِرَةٌ</span> خَيْرٌ مِّن <span class="highlight9">صَدَقَةٍ</span> يَتْبَعُهَا أَذًى ۗ وَاللَّهُ غَنِيٌّ حَلِيمٌ<sup>۲۶۳</sup>
      </p>

      <div class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>

        <div class="inner-paragraph-7">
          <p class="zero-margin">
            يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُبْطِلُوا <span class="highlight9">صَدَقَاتِ</span>كُم بِ<span class="boxed underline-blackdotted">الْمَنِّ</span> وَ<span class="boxed underline-blackdotted">الْأَذَىٰ</span>
          </p>

          <!-- Aya 264 -->
          <p class="zero-margin5">
            <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
            كَ<span class="boxed underline-solidred">الَّذِي <span class="highlight9">يُنفِقُ</span> مَالَهُ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ۖ</span> فَمَثَلُهُ كَمَثَلِ <span class="boxed underline-red">صَفْوَانٍ عَلَيْهِ تُرَابٌ فَأَصَابَهُ وَابِلٌ فَتَرَكَهُ صَلْدًا ۖ لَّا يَقْدِرُونَ عَلَىٰ شَيْءٍ مِّمَّا كَسَبُوا ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ</span><sup>۲۶۴</sup>
          </p>

          <!-- Aya 265 -->
          <p class="zero-margin5">
            <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
            وَمَثَلُ <span class="boxed underline-solidgreen">الَّذِينَ <span class="highlight9">يُنفِقُونَ</span> أَمْوَالَهُمُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَتَثْبِيتًا مِّنْ أَنفُسِهِمْ</span> كَمَثَلِ <span class="boxed underline-green">جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ فَإِن لَّمْ يُصِبْهَا وَابِلٌ فَطَلٌّ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ</span><sup>۲۶۵</sup>
          </p>

          <!-- Aya 266 -->
          <p class="zero-margin">
            أَيَوَدُّ أَحَدُكُمْ أَن تَكُونَ لَهُ جَنَّةٌ مِّن <span class="boxed underline-blackdashed2">نَّخِيلٍ</span> وَ<span class="boxed underline-blackdashed2">أَعْنَابٍ</span> تَجْرِي مِن تَحْتِهَا الْأَنْهَارُ لَهُ فِيهَا مِن كُلِّ الثَّمَرَاتِ وَأَصَابَهُ الْكِبَرُ وَلَهُ ذُرِّيَّةٌ ضُعَفَاءُ فَأَصَابَهَا إِعْصَارٌ فِيهِ نَارٌ فَاحْتَرَقَتْ ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ<sup>۲۶۶</sup>
          </p>
        </div>
      </div>

      <div class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
        يَا أَيُّهَا الَّذِينَ آمَنُوا <span class="highlight9">أَنفِقُوا</span> <span class="boxed underline-blackdashed">مِن طَيِّبَاتِ مَا كَسَبْتُمْ</span> وَ<span class="boxed underline-blackdashed">مِمَّا أَخْرَجْنَا لَكُم مِّنَ الْأَرْضِ</span> ۖ وَلَا تَيَمَّمُوا الْخَبِيثَ مِنْهُ تُنفِقُونَ وَلَسْتُم بِآخِذِيهِ إِلَّا أَن تُغْمِضُوا فِيهِ ۚ وَاعْلَمُوا أَنَّ اللَّهَ غَنِيٌّ حَمِيدٌ<sup>۲۶۷</sup>
        <span style="margin-left: 2mm;"></span>

        <div class="inner-paragraph-14">
          <p class="zero-margin2">
            <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
            الشَّيْطَانُ <span class="boxed underline-blackdotted">يَعِدُكُمُ الْفَقْرَ</span> وَ<span class="boxed underline-blackdotted">يَأْمُرُكُم بِالْفَحْشَاءِ</span> ۖ
          </p>

          <!-- Aya 268 -->
          <p class="zero-margin2">
            <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Symbol&quot;;">– </span>
            وَاللَّهُ يَعِدُكُم <span class="boxed underline-black-2">مَّغْفِرَةً مِّنْهُ</span> وَ<span class="boxed underline-black-2">فَضْلًا</span> ۗ وَاللَّهُ وَاسِعٌ عَلِيمٌ<sup>۲۶۸</sup>
          </p>
        </div>
      </div>

      <!-- Aya 269 -->
      <p class="ordinary-far" style="text-align: center;">
        يُؤْتِي الْحِكْمَةَ مَن يَشَاءُ ۚ وَمَن يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا ۗ وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ<sup>۲۶۹</sup>
      </p>

      <!-- Aya 270 -->
      <p class="ordinary-far">
        وَمَا <span class="boxed underline-black-3"><span class="highlight9">أَنفَقْتُم</span> مِّن <span class="highlight9">نَّفَقَةٍ</span></span> أَوْ <span class="boxed underline-black-3"><span class="highlight9">نَذَرْتُم</span> مِّن <span class="highlight9">نَّذْرٍ</span></span> فَإِنَّ اللَّهَ يَعْلَمُهُ ۗ وَمَا لِلظَّالِمِينَ مِنْ أَنصَارٍ<sup>۲۷۰</sup>
        <span class="boxed underline-gradient">إِن</span> تُبْدُوا <span class="highlight9">الصَّدَقَاتِ</span> فَنِعِمَّا هِيَ ۖ وَ<span class="boxed underline-gradient">إِن</span> <span class="boxed underline-black-3">تُخْفُوهَا</span> وَ<span class="boxed underline-black-3">تُؤْتُوهَا الْفُقَرَاءَ</span> فَهُوَ خَيْرٌ لَّكُمْ ۚ وَيُكَفِّرُ عَنكُم مِّن سَيِّئَاتِكُمْ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ<sup>۲۷۱</sup>
      </p>

      <p class="ordinary-far" style="text-align: center;">
        لَّيْسَ عَلَيْكَ هُدَاهُمْ وَلَـٰكِنَّ اللَّهَ يَهْدِي مَن يَشَاءُ ۗ
      </p>

      <!-- Aya 272 -->
      <p class="ordinary-far">
        <span class="boxed underline-gradient">وَمَا <span class="highlight9">تُنفِقُوا</span> مِنْ خَيْرٍ</span> فَلِأَنفُسِكُمْ ۚ وَمَا <span class="highlight9">تُنفِقُونَ</span> إِلَّا ابْتِغَاءَ وَجْهِ اللَّهِ ۚ <span class="boxed underline-gradient">وَمَا <span class="highlight9">تُنفِقُوا</span> مِنْ خَيْرٍ</span> يُوَفَّ إِلَيْكُمْ وَأَنتُمْ لَا تُظْلَمُونَ<sup>۲۷۲</sup>
      </p>

      <!-- Aya 273 -->
      <p class="ordinary-far">
        لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ يَحْسَبُهُمُ الْجَاهِلُ أَغْنِيَاءَ مِنَ التَّعَفُّفِ تَعْرِفُهُم بِسِيمَاهُمْ لَا يَسْأَلُونَ النَّاسَ إِلْحَافًا ۗ <span class="boxed underline-gradient">وَمَا <span class="highlight9">تُنفِقُوا</span> مِنْ خَيْرٍ</span> فَإِنَّ اللَّهَ بِهِ عَلِيمٌ<sup>۲۷۳</sup>
      </p>

      <!-- Aya 274 -->
      <p class="ordinary-far">
        الَّذِينَ <span class="highlight9">يُنفِقُونَ</span> أَمْوَالَهُم بِ<span class="boxed underline-blackdashed2">اللَّيْلِ</span> وَ<span class="boxed underline-blackdashed2">النَّهَارِ</span> <span class="boxed underline-blackdashed">سِرًّا</span> وَ<span class="boxed underline-blackdashed">عَلَانِيَةً</span> فَ<span class="boxed underline-black-2">لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ</span> وَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span><sup>۲۷۴</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <!-- Aya 275 -->
      <p class="ordinary-far">
        الَّذِينَ يَأْكُلُونَ <span class="highlight10">الرِّبَا</span> لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ۚ ذَٰلِكَ بِأَنَّهُمْ قَالُوا <speech open="" red=""></speech>إِنَّمَا <span class="highlight11">الْبَيْعُ</span> مِثْلُ <span class="highlight10">الرِّبَا</span><speech close="" red=""></speech> ۗ وَ<span class="boxed underline-green">أَحَلَّ اللَّهُ الْبَيْعَ</span> وَ<span class="boxed underline-red">حَرَّمَ <span class="highlight10">الرِّبَا</span></span> ۚ فَمَن جَاءَهُ مَوْعِظَةٌ مِّن رَّبِّهِ فَانتَهَىٰ فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ ۖ وَمَنْ عَادَ فَأُولَـٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ<sup>۲۷۵</sup>
        <span class="boxed underline-solidred">يَمْحَقُ اللَّهُ <span class="highlight10">الرِّبَا</span></span> وَ<span class="boxed underline-solidgreen">يُرْبِي <span class="highlight9">الصَّدَقَاتِ</span></span> ۗ وَاللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ<sup>۲۷۶</sup>
      </p>

      <!-- Aya 277 -->
      <p class="ordinary-far" style="text-align: center;">
        إِنَّ الَّذِينَ<span class="boxed underline-black-3"> آمَنُوا</span> وَ<span class="boxed underline-black-3">عَمِلُوا الصَّالِحَاتِ</span> وَ<span class="boxed underline-black-3">أَقَامُوا الصَّلَاةَ</span> وَ<span class="boxed underline-black-3">آتَوُا الزَّكَاةَ</span> <span class="boxed underline-black-2">لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ</span> وَ<span class="backhighlight1"><span class="boxed underline-black-2">لَا خَوْفٌ عَلَيْهِمْ</span> وَ<span class="boxed underline-black-2">لَا هُمْ يَحْزَنُونَ</span></span><sup>۲۷۷</sup>
      </p>

      <!-- Aya 278 -->
      <p class="big-bullet-far">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
        يَا أَيُّهَا الَّذِينَ آمَنُوا <span class="boxed underline-gradient">اتَّقُوا</span> اللَّهَ وَ<span class="boxed underline-gradient">ذَرُوا</span> مَا بَقِيَ مِنَ <span class="highlight10">الرِّبَا</span> إِن كُنتُم مُّؤْمِنِينَ<sup>۲۷۸</sup>
        فَإِن لَّمْ تَفْعَلُوا فَأْذَنُوا بِحَرْبٍ مِّنَ <span class="boxed underline-black-1">اللَّهِ</span> وَ<span class="boxed underline-black-1">رَسُولِهِ</span> ۖ وَإِن تُبْتُمْ فَلَكُمْ رُءُوسُ أَمْوَالِكُمْ <span class="boxed underline-blackdashed2">لَا تَظْلِمُونَ</span> وَ<span class="boxed underline-blackdashed2">لَا تُظْلَمُونَ</span><sup>۲۷۹</sup>
        وَإِن كَانَ ذُو عُسْرَةٍ فَنَظِرَةٌ إِلَىٰ مَيْسَرَةٍ ۚ وَأَن <span class="highlight9">تَصَدَّقُوا</span> خَيْرٌ لَّكُمْ ۖ إِن كُنتُمْ تَعْلَمُونَ<sup>۲۸۰</sup>
        <span class="boxed underline-notsure">&nbsp;
        وَاتَّقُوا يَوْمًا تُرْجَعُونَ فِيهِ إِلَى اللَّهِ ۖ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ<sup>۲۸۱</sup>&nbsp;</span>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <p class="big-bullet-near">
        <span style="font-size:4.5mm;line-height:240%;font-family:&quot;Wingdings 3&quot;;">^ </span><span> </span>
        يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا <span class="highlight11">تَدَايَنتُم</span> بِ<span class="highlight11">دَيْنٍ</span> إِلَىٰ أَجَلٍ مُّسَمًّى فَ<span class="boxed underline-black-wavy">اكْتُبُو</span>هُ ۚ
      </p>

      <div class="ordinary-far">
        <div class="inner-paragraph-15" style="margin-right: 30mm;">
          <p class="zero-margin">
            وَلْ<span class="boxed underline-black-wavy">يَكْتُب</span> بَّيْنَكُمْ <span class="boxed underline-black-wavy">كَاتِبٌ</span> بِالْعَدْلِ ۚ
            <span style="margin-left: 17mm;"></span>
            
            وَ<span class="boxed square">لَا يَأْبَ</span> <span class="boxed underline-black-wavy">كَاتِبٌ</span> أَن <span class="boxed underline-black-wavy">يَكْتُبَ</span> كَمَا عَلَّمَهُ اللَّهُ ۚ
          </p>

          <p class="zero-margin">
            فَلْ<span class="boxed underline-black-wavy">يَكْتُبْ</span> وَلْيُمْلِلِ الَّذِي عَلَيْهِ الْحَقُّ وَلْ<span class="boxed underline-gradientrev">يَتَّقِ</span> اللَّهَ رَبَّهُ وَ<span class="boxed underline-gradientrev">لَا يَبْخَسْ</span> مِنْهُ شَيْئًا ۚ
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            فَإِن كَانَ الَّذِي عَلَيْهِ الْحَقُّ <span class="boxed underline-blackdashed2">سَفِيهًا</span> أَوْ <span class="boxed underline-blackdashed2">ضَعِيفًا</span> أَوْ <span class="boxed underline-blackdashed2">لَا يَسْتَطِيعُ أَن يُمِلَّ هُوَ</span> فَلْيُمْلِلْ وَلِيُّهُ بِالْعَدْلِ ۚ
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            وَ<span class="boxed underline-zigzag">اسْتَشْهِدُوا</span> <span class="boxed underline-zigzag"><span class="boxed underline-blackdashed2">شَهِيدَيْنِ</span></span> مِن رِّجَالِكُمْ ۖ فَإِن لَّمْ يَكُونَا رَجُلَيْنِ فَ<span class="boxed underline-blackdashed">رَجُلٌ</span> وَ<span class="boxed underline-blackdashed">امْرَأَتَانِ</span> مِمَّن تَرْضَوْنَ مِنَ <span class="boxed underline-zigzag">الشُّهَدَاءِ</span> أَن تَضِلَّ إِحْدَاهُمَا فَتُذَكِّرَ إِحْدَاهُمَا الْأُخْرَىٰ ۚ
            <span style="margin-left: 0mm;"></span>
            
            وَ<span class="boxed square">لَا يَأْبَ</span> <span class="boxed underline-zigzag">الشُّهَدَاءُ</span> إِذَا مَا دُعُوا ۚ
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            وَلَا تَسْأَمُوا أَن <span class="boxed underline-black-wavy">تَكْتُبُو</span>هُ <span class="boxed underline-blackdashed2">صَغِيرًا</span> أَوْ <span class="boxed underline-blackdashed2">كَبِيرًا</span> إِلَىٰ أَجَلِهِ ۚ ذَٰلِكُمْ <span class="boxed underline-blackdashed-far">أَقْسَطُ عِندَ اللَّهِ</span> وَ<span class="boxed underline-blackdashed-far">أَقْوَمُ لِ<span class="boxed underline-zigzag">لشَّهَادَةِ</span></span> وَ<span class="boxed underline-blackdashed-far">أَدْنَىٰ أَلَّا تَرْتَابُوا</span> ۖ
          </p>

          <p class="zero-margin">
            إِلَّا أَن تَكُونَ <span class="highlight11">تِجَارَةً</span> حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا <span class="boxed underline-black-wavy">تَكْتُبُو</span>هَا ۗ
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            وَ<span class="boxed underline-zigzag">أَشْهِدُوا</span> إِذَا <span class="highlight11">تَبَايَعْتُمْ ۚ</span>
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            وَلَا يُضَارَّ <span class="boxed underline-black-wavy">كَاتِبٌ</span> وَلَا <span class="boxed underline-zigzag">شَهِيدٌ</span> ۚ وَإِن تَفْعَلُوا فَإِنَّهُ فُسُوقٌ بِكُمْ ۗ
          </p>

          <!-- Aya 282 -->
          <p class="zero-margin" style="margin-bottom: 4.5mm;text-align: center;">
            وَاتَّقُوا اللَّهَ ۖ وَيُعَلِّمُكُمُ اللَّهُ ۗ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ<sup>۲۸۲</sup>
          </p>

          <p class="zero-margin" style="margin-bottom: 4.5mm;">
            وَإِن كُنتُمْ عَلَىٰ سَفَرٍ وَلَمْ تَجِدُوا <span class="boxed underline-black-wavy">كَاتِبًا</span> فَرِهَانٌ مَّقْبُوضَةٌ ۖ

            </p><p class="zero-margin" style="margin-bottom: 4.5mm;">
              فَإِنْ <span class="highlight11">أَمِنَ</span> بَعْضُكُم بَعْضًا فَلْ<span class="boxed underline-gradientrev">يُؤَدِّ</span> الَّذِي <span class="highlight11">اؤْتُمِنَ</span> <span class="highlight11">أَمَانَتَ</span>هُ وَلْ<span class="boxed underline-gradientrev">يَتَّقِ</span> اللَّهَ رَبَّهُ ۗ
            </p>

            <p class="zero-margin" style="margin-bottom: 4.5mm;">
              وَلَا تَكْتُمُوا <span class="boxed underline-zigzag">الشَّهَادَةَ</span> ۚ وَمَن يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ ۗ
            </p>

            <!-- Aya 283 -->
            <p class="zero-margin" style="text-align: center;">
              وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ<sup>۲۸۳</sup>
            </p>
          </div>
        </div>

        <p class="ordinary-far">
        </p>

        <!-- Aya 284 -->
        <p class="ordinary-far">
          <span class="boxed underline-notsure">&nbsp;
          لِّلَّهِ <span class="boxed underline-blackdashed2">مَا فِي السَّمَاوَاتِ</span> وَ<span class="boxed underline-blackdashed2">مَا فِي الْأَرْضِ</span> ۗ وَإِن <span class="boxed underline-blackdashed">تُبْدُوا مَا فِي أَنفُسِكُمْ</span> أَوْ <span class="boxed underline-blackdashed">تُخْفُوهُ</span> يُحَاسِبْكُم بِهِ اللَّهُ ۖ فَ<span class="boxed underline-solidgreen">يَغْفِرُ لِمَن يَشَاءُ</span> وَ<span class="boxed underline-solidred">يُعَذِّبُ مَن يَشَاءُ</span> ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ<sup>۲۸۴</sup>&nbsp;</span>
        </p>

        <div class="diamond-marker bottom-1"></div>
      </div>

      <div class="diamond-marker bottom-2"></div>
    </div>

    <div class="container">
      <div class="diamond-marker top-1"></div>
      <div class="vertical-line-1"></div>
      <p class="ordinary-near">
        آمَنَ <span class="boxed underline-black-2">الرَّسُولُ</span> بِمَا أُنزِلَ إِلَيْهِ مِن رَّبِّهِ <span class="boxed underline-black-2">وَالْمُؤْمِنُونَ</span> ۚ كُلٌّ آمَنَ بِ<span class="boxed underline-black-1">اللَّهِ</span> وَ<span class="boxed underline-black-1">مَلَائِكَتِهِ</span> وَ<span class="boxed underline-black-1">كُتُبِهِ</span> وَ<span class="boxed underline-black-1">رُسُلِهِ</span>
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
        <speech open="" green="" underline=""></speech>لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّن رُّسُلِهِ<speech close="" green="" underline=""></speech> ۚ
      </p>

      <!-- Aya 285 -->
      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;">n </span><span> </span>
        وَقَالُوا <speech open="" green=""></speech><span class="boxed underline-black-3">سَمِعْنَا</span> وَ<span class="boxed underline-black-3">أَطَعْنَا</span> ۖ غُفْرَانَكَ <span class="boxed underline-gradientsym2">رَبَّنَا</span> وَإِلَيْكَ الْمَصِيرُ<speech close="" green=""></speech><sup>۲۸۵</sup>
      </p>

      <p class="ordinary-near">
        <span class="boxed underline-notsure">
        &nbsp;لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ <span class="boxed underline-blackdashed">لَهَا مَا كَسَبَتْ</span> وَ<span class="boxed underline-blackdashed">عَلَيْهَا مَا اكْتَسَبَتْ</span> ۗ &nbsp;</span>
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
        <speech open="" green="" underline=""></speech><span class="boxed underline-gradientsym2">رَبَّنَا</span> لَا تُؤَاخِذْنَا إِن <span class="boxed underline-blackdashed2">نَّسِينَا</span> أَوْ <span class="boxed underline-blackdashed2">أَخْطَأْنَا</span><speech close="" green="" underline=""></speech> ۚ
      </p>

      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
        <speech open="" green="" underline=""></speech><span class="boxed underline-gradientsym2">رَبَّنَا</span> وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِن قَبْلِنَا<speech close="" green="" underline=""></speech> ۚ
      </p>

      <!-- Aya 286 -->
      <p class="small-bullet-near">
        <span style="font-size:3.5mm;line-height:240%;font-family:Wingdings;"><span class="boxed underline-black-1">n</span> </span><span> </span>
        <speech open="" green="" underline=""></speech><span class="boxed underline-gradientsym2">رَبَّنَا</span> وَ<span class="boxed underline-black-3">لَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ</span> ۖ وَ<span class="boxed underline-black-3">اعْفُ عَنَّا</span> وَ<span class="boxed underline-black-3">اغْفِرْ لَنَا</span> وَ<span class="boxed underline-black-3">ارْحَمْنَا</span> ۚ أَنتَ مَوْلَانَا فَانصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ<speech close="" green="" underline=""></speech><sup>۲۸۶</sup>
      </p>

      <div class="diamond-marker bottom-1"></div>
    </div>
  
</body></html>