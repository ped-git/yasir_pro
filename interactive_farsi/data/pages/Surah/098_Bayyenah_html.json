        "p098-local-underline-pattern-b891409556"
      ],
      "sourceText": "يُقِيمُوا الصَّلَاةَ"
    },
    {
      "id": "p098-u0005",
      "text": "را برپا دارند، و زکات",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(3)",
