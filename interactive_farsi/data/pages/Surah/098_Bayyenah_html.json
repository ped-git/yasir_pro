        "p098-local-underline-pattern-b891409556"
      ],
      "sourceText": "يَعْبُدُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ حُنَفَاءَ"
    },
    {
      "id": "p098-u0004",
      "text": "کنند، و حق گرا باشند، و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
