      "end": 145,
      "groups": [
        "p098-textual-coordination-cd7d42ba8a"
      ],
      "sourceText": "الْمُشْرِكِينَ"
    },
    {
      "id": "p098-u0003",
      "text": "جز آنکه خدا را بپرستند، و ایمان و عبادت را برای او از هرگونه شرکی",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(1)",
      "textHash": "73c1d674fc89301b50b7c9b486f08b5be7fe014fc6008629cdc7b88751f94667",
