        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 20,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c13",
      "start": 1409,
      "end": 1424,
      "groups": [
        "p081-textual-coordination-4d13ff255b"
      ],
      "sourceText": "ذِي قُوَّةٍ"
    },
    {
      "id": "p081-u0015",
      "text": "صاحب عرش دارای مقام و منزلت است؛….",
      "selector": "body:nth-of-type(1) > p:nth-of-type(19) > span:nth-of-type(3)",
      "textHash": "dca208e86656994d547e0e7451c142d4d872b285a83afe0e7f9deb6db22db441",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 20,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c13",
      "start": 1425,
      "end": 1460,
      "groups": [
        "p081-textual-coordination-4d13ff255b"
      ],
      "sourceText": "عِندَ ذِي الْعَرْشِ مَكِينٍ"
    },
    {
      "id": "p081-u0016",
      "text": "آنجا مورد اطاعت [فرشتگان]",
      "selector": "body:nth-of-type(1) > p:nth-of-type(19) > span:nth-of-type(4)",
      "textHash": "2acbdf764c8ce044e690297553276655906981be0e451f85b3bb3cec3204b3fb",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c13",
      "start": 1469,
      "end": 1494,
      "groups": [
        "p081-textual-coordination-4d13ff255b"
      ],
      "sourceText": "مُّطَاعٍ ثَمَّ"
    },
    {
      "id": "p081-u0017",
      "text": "و امین است….",
      "selector": "body:nth-of-type(1) > p:nth-of-type(19) > span:nth-of-type(5)",
      "textHash": "271a5ddd9f69dbd4c3b52154bae63aad10479184db13bcc3a8c1ad6c507e5766",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c13",
      "start": 1495,
      "end": 1508,
      "groups": [
        "p081-textual-coordination-4d13ff255b"
      ],
      "sourceText": "أَمِينٍ"
    },
    {
      "id": "p081-u0018",
      "text": "رفیق و یار شما دیوانه نیست.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(20) > span:nth-of-type(1)",
      "textHash": "1522af9a279e45df6b93a2ca5d731d5c0ed6892295d677b5c01a02231fece997",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 14,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c14",
      "start": 1528,
      "end": 1555,
      "groups": [
        "p081-textual-coordination-2d004a9767",
        "p081-local-underline-pattern-5e8f660724"
      ],
      "sourceText": "مَا صَاحِبُكُم بِمَجْنُونٍ"
    },
    {
      "id": "p081-u0019",
      "text": "تردید امین وحی را در افق روشن دیده است،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(20) > span:nth-of-type(2)",
      "textHash": "2fa2a014f02092ab184abe57fb4dbb6e9839288c25fa1d5414d1768b129324b9",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 14,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c14",
      "start": 1559,
      "end": 1599,
      "groups": [
        "p081-textual-coordination-2d004a9767",
        "p081-local-underline-pattern-5e8f660724"
      ],
      "sourceText": "لَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ"
    },
    {
      "id": "p081-u0020",
      "text": "نسبت به [ابلاغ و تعلیم] آنچه به او وحی می شود، بخیل نیست",
      "selector": "body:nth-of-type(1) > p:nth-of-type(20) > span:nth-of-type(3)",
      "textHash": "2c9d01f4cfe48141ea1a292d7698ddde068723c169df2fb2926327dfe30cf0dc",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 24,
      "blockIndex": 14,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c14",
      "start": 1605,
      "end": 1663,
      "groups": [
        "p081-textual-coordination-2d004a9767",
        "p081-local-underline-pattern-5e8f660724"
      ],
      "sourceText": "مَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ"
    },
    {
      "id": "p081-u0021",
      "text": "قرآن، کلام شیطان رانده شده نیست؛",
      "selector": "body:nth-of-type(1) > p:nth-of-type(21) > span:nth-of-type(1)",
      "textHash": "53da06aaadddb95d3d02e8463226dd0431fa7519c854b47b44519b45e38ba5d8",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 25,
      "blockIndex": 15,
      "parentId": null,
      "sectionId": null,
      "contextId": "p081-c15",
      "start": 1683,
      "end": 1715,
      "groups": [
        "p081-local-underline-pattern-5e8f660724"
      ],
      "sourceText": "مَا هُوَ بِقَوْلِ شَيْطَانٍ رَّجِيمٍ"
