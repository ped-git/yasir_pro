      "sourceText": "كَرِيمٍ"
    },
    {
      "id": "p081-u0014",
      "text": "نیرومندی که نزد",
      "selector": "body:nth-of-type(1) > p:nth-of-type(19) > span:nth-of-type(2)",
      "textHash": "45890964fea8645c15755eab287c50d4665a2c6cb09922b93c080ffd99efaa6b",
      "appearance": {
