    },
    {
      "id": "p079-u0022",
      "text": "و دام هایتان باشد.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(6)",
      "textHash": "72e3e90ad4e86072cd2ed66c19dfe3387fb819cc9336a603e7bfafe42db43024",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 33,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c6",
      "start": 2496,
      "end": 2514,
      "groups": [
        "p079-textual-coordination-ff590ff141"
      ],
      "sourceText": "لِأَنْعَامِكُمْ"
    },
    {
      "id": "p079-u0023",
      "text": "انسان آنچه تلاش و کوشش کرده به یاد آورد",
      "selector": "body:nth-of-type(1) > p:nth-of-type(14) > span:nth-of-type(1)",
      "textHash": "05ef6c75e5579c3b7dee989205e2f8f8417eca1d278006031657535557dffbc3",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 35,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c7",
      "start": 2596,
      "end": 2636,
      "groups": [
        "p079-textual-coordination-85209cf90c"
      ],
      "sourceText": "يَتَذَكَّرُ الْإِنسَانُ مَا سَعَىٰ"
    },
    {
      "id": "p079-u0024",
      "text": "دوزخ رابرای هر بیننده ای آشکار سازند،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(14) > span:nth-of-type(2)",
      "textHash": "5e136ae7cf8abda224ea7c803f992421c9bf85f4ff7c0c0d6391657c56cd5dfc",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 36,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c7",
      "start": 2640,
      "end": 2677,
      "groups": [
        "p079-textual-coordination-85209cf90c"
      ],
      "sourceText": "بُرِّزَتِ الْجَحِيمُ لِمَن يَرَىٰ"
    },
    {
      "id": "p079-u0025",
      "text": "سرکشی کرده",
      "selector": "body:nth-of-type(1) > p:nth-of-type(15) > span:nth-of-type(3)",
      "textHash": "0cfa1cc7c47547d835175fe403d4d22f48a71d66bfe00d85041951bbf2bc6e8f",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 37,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c8",
      "start": 2725,
      "end": 2736,
      "groups": [
        "p079-textual-coordination-86c3d0f901",
        "p079-red-green-pair-99ddc2d29b",
        "p079-red-green-pair-0df625d3af",
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "طَغَىٰ"
    },
    {
      "id": "p079-u0026",
      "text": "زندگی دنیا را [بر زندگی ابد و جاوید آخرت] ترجیح داده،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(15) > span:nth-of-type(4)",
      "textHash": "66dcf2395f0ab169343af94edca9d680194715fa6a155d3c1d75dc99cb7dcede",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 38,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c8",
      "start": 2740,
      "end": 2793,
      "groups": [
        "p079-textual-coordination-86c3d0f901",
        "p079-red-green-pair-99ddc2d29b",
        "p079-red-green-pair-0df625d3af",
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "آثَرَ الْحَيَاةَ الدُّنْيَا"
    },
    {
      "id": "p079-u0027",
      "text": "بی تردید جایگاهش دوزخ است؛",
      "selector": "body:nth-of-type(1) > p:nth-of-type(15) > span:nth-of-type(6)",
      "textHash": "add8d24e9c1876e327aa71c18da3e682f75473abdd85e93fb376e71c1bddf3f8",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 39,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c8",
      "start": 2804,
      "end": 2831,
      "groups": [
        "p079-red-green-pair-0df625d3af",
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "إِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ"
    },
    {
      "id": "p079-u0028",
      "text": "مقام و منزلت پروردگارش",
      "selector": "body:nth-of-type(1) > p:nth-of-type(16) > span:nth-of-type(3)",
      "textHash": "e3ccba1cbd95d999488408f486cf1d8d5b81864c4f53727756c4d4b6ba49637d",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 40,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c9",
      "start": 2875,
      "end": 2898,
      "groups": [
        "p079-textual-coordination-67dbdf0eb9",
        "p079-red-green-pair-99ddc2d29b",
        "p079-red-green-pair-0df625d3af",
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "خَافَ مَقَامَ رَبِّهِ"
    },
    {
      "id": "p079-u0029",
      "text": "و نفس را از هوا و هوس بازداشته است؛",
      "selector": "body:nth-of-type(1) > p:nth-of-type(16) > span:nth-of-type(4)",
      "textHash": "6b816a66dfa04ad0fccb6b078921d964e4b7b2d964b0c3bb825189c09f56dada",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 40,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c9",
      "start": 2904,
      "end": 2940,
      "groups": [
        "p079-textual-coordination-67dbdf0eb9",
        "p079-red-green-pair-99ddc2d29b",
        "p079-red-green-pair-0df625d3af",
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "نَهَى النَّفْسَ عَنِ الْهَوَىٰ"
    },
    {
      "id": "p079-u0030",
      "text": "بی تردید جایگاهش بهشت است.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(16) > span:nth-of-type(6)",
      "textHash": "27ec537da9ad2082e099f4b617a0b8ee4eecc0bd3e7ed312c85ae48b93bb9c59",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 41,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c9",
      "start": 2951,
      "end": 2978,
      "groups": [
        "p079-red-green-pair-7f1424be7f"
      ],
      "sourceText": "إِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ"
    },
    {
      "id": "p079-u0031",
      "text": "یا صبح گاه",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(1)",
      "textHash": "62afef8edf7b1f6e4509299a002c253507164657d417994c143ecb2503becbbb",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 46,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c10",
      "start": 3355,
      "end": 3367,
      "groups": [
        "p079-textual-coordination-573b2a5f7d"
      ],
      "sourceText": "عَشِيَّةً"
    },
    {
      "id": "p079-u0032",
      "text": "نکرده اند!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(2)",
      "textHash": "856234ff7781c2931252b8f9b2bad9cdd8b14191ac19235626ef1fb1547c1e9f",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 46,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p079-c10",
      "start": 3374,
      "end": 3385,
      "groups": [
        "p079-textual-coordination-573b2a5f7d"
      ],
      "sourceText": "ضُحَاهَا"
    }
