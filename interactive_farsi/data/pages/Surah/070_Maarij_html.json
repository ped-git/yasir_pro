      "sectionId": null,
      "contextId": "p070-c1",
      "start": 539,
      "end": 612,
      "groups": [
        "p070-textual-coordination-a61b82e2c6"
      ],
      "sourceText": "لَا يَسْأَلُ حَمِيمٌ حَمِيمًا"
    },
