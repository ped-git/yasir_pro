    {
      "id": "p070-u0012",
      "text": "همه کسانی را که در روی زمین اند تا [این فدیه و عوض] او",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(12)",
      "textHash": "f00b535d07ac9b5309dfdbbcfe59df973abd288dd4b3e9ee2bf63c1b09a07a44",
