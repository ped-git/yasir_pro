      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 8,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p070-c1",
      "start": 464,
      "end": 492,
      "groups": [
        "p070-textual-coordination-a61b82e2c6"
      ],
      "sourceText": "تَكُونُ السَّمَاءُ كَالْمُهْلِ"
    },
    {
      "id": "p070-u0006",
      "text": "کوه ها مانند پشم رنگینِ حلاجی شده شود",
