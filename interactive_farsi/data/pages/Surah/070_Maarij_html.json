        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 9,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p070-c1",
      "start": 495,
      "end": 532,
      "groups": [
        "p070-textual-coordination-a61b82e2c6"
      ],
      "sourceText": "تَكُونُ الْجِبَالُ كَالْعِهْنِ"
    },
    {
      "id": "p070-u0007",
      "text": "خویشاوند و دوست صمیمی از [اوضاع و احوال] خویشاوند و دوست صمیمی اش نپرسد!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(7)",
      "textHash": "787e14f5fb085534000f1da8f716a21740f21727b99b28ce14daa9673fcb6f63",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 10,
      "blockIndex": 1,
