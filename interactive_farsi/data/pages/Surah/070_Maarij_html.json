        "colorFamily": "gray"
      },
      "verse": 13,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p070-c1",
      "start": 809,
      "end": 859,
      "groups": [
        "p070-textual-coordination-4ececb71a5"
      ],
      "sourceText": "فَصِيلَتِهِ الَّتِي تُؤْوِيهِ"
