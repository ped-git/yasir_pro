      "verse": 14,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p070-c1",
      "start": 866,
      "end": 921,
      "groups": [
        "p070-textual-coordination-4ececb71a5"
      ],
