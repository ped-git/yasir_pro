      "start": 435,
      "end": 458,
      "groups": [
        "p070-red-green-pair-ae913b6395"
      ],
      "sourceText": "نَرَاهُ قَرِيبًا"
    },
    {
      "id": "p070-u0005",
      "text": "که آسمان چون فلز گداخته گردد",
