      "contextId": "p089-c4",
      "start": 703,
      "end": 720,
      "groups": [
        "p089-local-underline-pattern-17f8301ed1"
      ],
      "sourceText": "فِرْعَوْنَ"
    },
    {
      "id": "p089-u0006",
      "text": "بخشد، می گوید:",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(5)",
      "textHash": "2276ff87fbae40f3fea2a8f49d5b2844849e249d3028676c4d3468a4e7f58b8e",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 15,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c5",
      "start": 1092,
      "end": 1107,
      "groups": [
        "p089-textual-coordination-100c49ffe1"
      ],
      "sourceText": "أَكْرَمَهُ"
    },
    {
      "id": "p089-u0007",
      "text": "پروردگارم [چون",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(6)",
      "textHash": "760ab8a3a8d9e69c1e403cc172d7f84fb40f9479a4c91b416b7888dacf1a15ce",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 15,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c5",
      "start": 1108,
      "end": 1123,
      "groups": [
        "p089-textual-coordination-100c49ffe1"
      ],
      "sourceText": "نَعَّمَهُ"
    },
    {
      "id": "p089-u0008",
      "text": "این چنین نیست که می",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(3) > span:nth-of-type(1)",
      "textHash": "db3a8a6074a91bf597aeee95c2d55811daa255133b8e8da1bbed03b6ba1d1d14",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 17,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c6",
      "start": 1329,
      "end": 1348,
      "groups": [
        "p089-u0008-individual"
      ],
      "sourceText": "كَلَّا"
    },
    {
      "id": "p089-u0009",
      "text": "[زبونی، خواری و دور شدن شما از رحمت خدا برای این است که] یتیم را گرامی نمی دارید",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(3) > span:nth-of-type(2)",
      "textHash": "bb269ce290357a98cbd73546843f83549e3ab90cdb470c3f88acfdcf64cad75e",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 17,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c6",
      "start": 1363,
      "end": 1445,
      "groups": [
        "p089-textual-coordination-955041ae5b"
      ],
      "sourceText": "لَّا تُكْرِمُونَ الْيَتِيمَ"
    },
    {
      "id": "p089-u0010",
      "text": "یکدیگر را بر طعام دادن به مستمند تشویق نمی کنید",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(3) > span:nth-of-type(3)",
      "textHash": "a95095d0d069702b6b62a82a9b60dce3a9c18ae52d22598ab513bfb0792bef97",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 18,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c6",
      "start": 1449,
      "end": 1497,
      "groups": [
        "p089-textual-coordination-955041ae5b"
      ],
      "sourceText": "لَا تَحَاضُّونَ عَلَىٰ طَعَامِ الْمِسْكِينِ"
    },
    {
      "id": "p089-u0011",
      "text": "میراث خود را [با میراث دیگران بی توجه به حلال وحرام بودنش] یک جا و کامل می خورید",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(3) > span:nth-of-type(4)",
      "textHash": "dd8f35b7a49abe3d64d3d7cda971c67a14c1cc99a05fa5cecd6a1b73206378f8",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 19,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c6",
      "start": 1501,
      "end": 1582,
      "groups": [
        "p089-textual-coordination-955041ae5b"
      ],
      "sourceText": "تَأْكُلُونَ التُّرَاثَ أَكْلًا لَّمًّا"
    },
    {
      "id": "p089-u0012",
      "text": "وثروت را بسیار دوست دارید.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(3) > span:nth-of-type(5)",
      "textHash": "48b0e6883af9c3b2241c7007ad02fbc25410b1def2e057710100a3bafec7ed98",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 19,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p089-s0001",
      "contextId": "p089-c6",
      "start": 1584,
      "end": 1610,
      "groups": [
        "p089-textual-coordination-955041ae5b"
      ],
      "sourceText": "تُحِبُّونَ الْمَالَ حُبًّا جَمًّا"
    },
    {
      "id": "p089-u0013",
      "text": "این چنین",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "adbdcd39932ffa43906be42870e7a429156d1e252ee30e0ec8324e3ec0e124be",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 21,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1675,
      "end": 1684,
      "groups": [
        "p089-u0013-individual"
      ],
      "sourceText": "كَلَّا"
    },
    {
      "id": "p089-u0014",
      "text": "پندارید، هنگامی که زمین را به شدت درهم کوبند",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(2)",
      "textHash": "7941a578e2ecc73295fe97dc19224cc4963dc9af44c2a3977be9135fe3e48f30",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1694,
      "end": 1741,
      "groups": [
        "p089-textual-coordination-e5f1d91199"
      ],
      "sourceText": "دُكَّتِ الْأَرْضُ دَكًّا دَكًّا"
    },
    {
      "id": "p089-u0015",
      "text": "[فرمان] پروردگارت برسد، وفرشتگان صف اندر صف حاضر شوند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(3)",
      "textHash": "196dff448877f9b5550dc234189e217259eb4c8d17485901f085288a11c0d438",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1745,
      "end": 1799,
      "groups": [
        "p089-textual-coordination-e5f1d91199"
      ],
      "sourceText": "جَاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا"
    },
    {
      "id": "p089-u0016",
      "text": "پروردگارت",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(3) > span:nth-of-type(1)",
      "textHash": "f382c14898bccafc359369457298d863c28d3c334633dd912e98163c4b6ffba8",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 7,
      "parentId": "p089-u0015",
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1753,
      "end": 1763,
      "groups": [
        "p089-textual-coordination-4e3dab1100"
      ],
      "sourceText": "رَبُّكَ"
    },
    {
      "id": "p089-u0017",
      "text": "وفرشتگان صف",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(3) > span:nth-of-type(2)",
      "textHash": "a453e1f7f09f658355869f4f96384f8545ef3a233f371f1668e06a9c9e5670c3",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 7,
      "parentId": "p089-u0015",
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1768,
      "end": 1781,
      "groups": [
        "p089-textual-coordination-4e3dab1100"
      ],
      "sourceText": "الْمَلَكُ"
    },
    {
      "id": "p089-u0018",
      "text": "آن روز دوزخ را بیاورند، در",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(4)",
      "textHash": "c6794b4d1f106603ee8a0e586cbd4f1b1a9d61e65a37fe81a2b3726d4cacb0c4",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1803,
      "end": 1831,
      "groups": [
        "p089-textual-coordination-e5f1d91199"
      ],
      "sourceText": "جِيءَ يَوْمَئِذٍ بِجَهَنَّمَ"
    },
    {
      "id": "p089-u0019",
      "text": "متذکّر شود و کجا این",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(6)",
      "textHash": "7287196fd744d87cb7818025225d0513682f6fa8b3b9c0086ef70a821de9a3c1",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1844,
      "end": 1866,
      "groups": [
        "p089-textual-coordination-2bd54d7ace"
      ],
      "sourceText": "يَتَذَكَّرُ الْإِنسَانُ"
    },
    {
      "id": "p089-u0020",
      "text": "برای او سودمند افتد؟!",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(7)",
      "textHash": "3385136ecbefc23151ba2a7a058f50f5dd98df59720e68c770e178e0b065d6db",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p089-s0002",
      "contextId": "p089-c7",
      "start": 1870,
      "end": 1892,
      "groups": [
        "p089-textual-coordination-2bd54d7ace"
      ],
      "sourceText": "أَنَّىٰ لَهُ الذِّكْرَىٰ"
    },
    {
      "id": "p089-u0021",
      "text": "هیچ کس چون عذاب کردن او عذاب نکند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(2) > span:nth-of-type(2)",
      "textHash": "99e725871db60d57e980ba815ff68495a5382f2d33c4f279643544667d6ae371",
      "appearance": {
