        "p089-red-green-pair-4b394b1791",
        "p089-red-green-pair-dc1fb29ff2"
      ],
      "sourceText": "لَا يُوثِقُ وَثَاقَهُ أَحَدٌ"
    },
    {
      "id": "p089-u0023",
      "text": "به سوی پروردگارت",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(3) > span:nth-of-type(1)",
