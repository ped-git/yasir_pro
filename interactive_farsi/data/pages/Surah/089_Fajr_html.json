    },
    {
      "id": "p089-u0004",
      "text": "قوم ثمود آنان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(2)",
