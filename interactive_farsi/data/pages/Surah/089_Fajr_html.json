      "sourceText": "ارْجِعِي"
    },
    {
      "id": "p089-u0024",
      "text": "در حالی که از او خشنودی و او هم از تو خشنود است، باز گرد.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(3) > span:nth-of-type(2)",
