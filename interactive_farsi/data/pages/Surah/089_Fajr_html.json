      ],
      "sourceText": "لَّا يُعَذِّبُ عَذَابَهُ أَحَدٌ"
    },
    {
      "id": "p089-u0022",
      "text": "هیچ کس چون به بند کشیدن او به بند نکشد.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(2) > span:nth-of-type(3)",
