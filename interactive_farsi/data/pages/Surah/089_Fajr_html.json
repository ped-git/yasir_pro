      "start": 568,
      "end": 583,
      "groups": [
        "p089-local-underline-pattern-17f8301ed1"
      ],
      "sourceText": "ثَمُودَ"
    },
    {
      "id": "p089-u0005",
      "text": "فرعون نیرومند که",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(2)",
