        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 7,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": null,
      "contextId": "p082-c6",
      "start": 554,
      "end": 572,
      "groups": [
        "p082-textual-coordination-9d52df7d3f"
      ],
      "sourceText": "عَدَلَكَ"
    },
    {
      "id": "p082-u0010",
      "text": "بزرگوارانی نویسنده",
