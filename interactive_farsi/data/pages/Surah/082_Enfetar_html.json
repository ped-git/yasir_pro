      "start": 532,
      "end": 547,
      "groups": [
        "p082-textual-coordination-9d52df7d3f"
      ],
      "sourceText": "سَوَّاكَ"
    },
    {
      "id": "p082-u0009",
      "text": "و متناسب قرار داد،",
