      "groups": [
        "p082-textual-coordination-9d52df7d3f"
      ],
      "sourceText": "خَلَقَكَ"
    },
    {
      "id": "p082-u0008",
      "text": "و نیکو ساخت و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(8) > span:nth-of-type(4)",
