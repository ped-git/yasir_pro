      "start": 749,
      "end": 822,
      "groups": [
        "p063-textual-coordination-9e288a3d9c"
      ],
      "sourceText": "إِن يَقُولُوا تَسْمَعْ لِقَوْلِهِمْ"
    },
    {
      "id": "p063-u0005",
      "text": "سرهای خود را بر می",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "9e0db0e74e71e08badc5a23023228da55ec19854d55968eb95b877f2cd73d0e9",
      "appearance": {
