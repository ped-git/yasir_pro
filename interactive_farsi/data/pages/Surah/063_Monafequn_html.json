      "start": 1239,
      "end": 1260,
      "groups": [
        "p063-textual-coordination-8590958086"
      ],
      "sourceText": "لَوَّوْا رُءُوسَهُمْ"
    },
    {
      "id": "p063-u0006",
      "text": "و آنان را می بینی که متکبرانه",
