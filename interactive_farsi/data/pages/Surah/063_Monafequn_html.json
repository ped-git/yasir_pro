      "contextId": "p063-c3",
      "start": 1342,
      "end": 1359,
      "groups": [
        "p063-textual-coordination-2682f90f18"
      ],
      "sourceText": "أَسْتَغْفَرْتَ لَهُمْ"
    },
    {
      "id": "p063-u0008",
