      ],
      "sourceText": "وَاللَّهُ يَعْلَمُ إِنَّكَ لَرَسُولُهُ"
    },
    {
      "id": "p063-u0002",
      "text": "اویی، و خدا گواهی می دهد که یقیناً منافقان دروغگویند.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(2)",
