      ],
      "sourceText": "يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ"
    },
    {
      "id": "p101-u0002",
      "text": "کوه ها مانند پشم رنگین حلاجی شده گردد!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(5)",
      "textHash": "a11776c298204c398f11ddf50337fa20d41d0389f4ca5c3732de5f6d0a33ae40",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p101-c1",
      "start": 217,
      "end": 255,
      "groups": [
        "p101-textual-coordination-277707498d"
      ],
      "sourceText": "تَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنفُوشِ"
    },
    {
      "id": "p101-u0003",
      "text": "اما هرکس اعمال وزن شده اش سنگین و باارزش است؛",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(3)",
      "textHash": "d3d4df5ab81916935a7f12227a0217cc567a04bacbb85a3d95b334ec4351dd12",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-right ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-green-100-180-100 ul-thickness-1px",
        "structure": "ul-gradient-to-right ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 6,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": null,
      "contextId": "p101-c2",
