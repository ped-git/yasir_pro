      "end": 334,
      "groups": [
        "p101-red-green-pair-76b5fea6bb",
        "p101-red-green-pair-b055a3de99",
        "p101-red-green-pair-71c42b141c"
      ],
      "sourceText": "فَأَمَّا مَن ثَقُلَتْ مَوَازِينُهُ"
    },
    {
      "id": "p101-u0004",
      "text": "پس او در یک زندگی خوش و پسندیده ای است،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(4)",
      "textHash": "15c70b7dbe0c03424bec41eddf29f63cae8a59d05b385d4018e347b700c3853c",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 7,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": null,
      "contextId": "p101-c2",
      "start": 342,
      "end": 381,
      "groups": [
        "p101-red-green-pair-b055a3de99",
        "p101-red-green-pair-71c42b141c"
      ],
      "sourceText": "فَهُوَ فِي عِيشَةٍ رَّاضِيَةٍ"
    },
    {
      "id": "p101-u0005",
      "text": "و اما هرکساعمال وزن شده اش سبک و بی ارزش است،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(3)",
      "textHash": "f745cd445e55e37b531309be1d9eb058ee4f81f64b7c2f9faad8d3e4ba848cb1",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-right ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-red-220-150-150 ul-thickness-1px",
        "structure": "ul-gradient-to-right ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 8,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": null,
      "contextId": "p101-c3",
      "start": 415,
      "end": 460,
