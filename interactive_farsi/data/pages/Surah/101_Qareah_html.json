  "underlines": [
    {
      "id": "p101-u0001",
      "text": "مردم [در سراسیمگی] چون پروانه های پراکنده اند",
      "selector": "body:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(4)",
