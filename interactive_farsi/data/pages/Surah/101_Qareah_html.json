        "p101-red-green-pair-b055a3de99",
        "p101-red-green-pair-71c42b141c"
      ],
      "sourceText": "وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ"
    },
    {
      "id": "p101-u0006",
      "text": "پس جایگاه و پناهگاهش هاویه است،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(4)",
      "textHash": "68a67ac847847ef5371a50ed471b9a3131bbf84cdb76dd5841ff0f2a18d7ab13",
      "appearance": {
