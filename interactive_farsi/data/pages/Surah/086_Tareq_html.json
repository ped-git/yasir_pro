        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 13,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": null,
      "contextId": "p086-c3",
      "start": 777,
      "end": 833,
      "groups": [
        "p086-textual-coordination-07941858f9"
      ],
      "sourceText": "إِنَّهُ لَقَوْلٌ فَصْلٌ"
