      "groups": [
        "p086-textual-coordination-06f4a01933"
      ],
      "sourceText": "الْأَرْضِ ذَاتِ الصَّدْعِ"
    },
    {
      "id": "p086-u0010",
      "text": "ها و کشت و زرع و",
