      ],
      "sourceText": "يَكُ نُطْفَةً مِّن مَّنِيٍّ يُمْنَىٰ"
    },
    {
      "id": "p075-u0025",
      "text": "شد و خدا او را آفرید و اندامش را درست و نیکو ساخت،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(2)",
