        "p075-textual-coordination-6ac82a811c"
      ],
      "sourceText": "كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"
    },
    {
      "id": "p075-u0026",
      "text": "از او دو زوج به وجود آورد یکی نر و دیگر ماده،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(3)",
      "textHash": "24d5012719701c741cbbe0b4dbde6d9b361844864175fdd2bc83dd4630005ba9",
      "appearance": {
