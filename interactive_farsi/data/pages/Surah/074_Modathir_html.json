      ],
      "sourceText": "سَقَرُ"
    },
    {
      "id": "p074-u0022",
      "text": "[آتشی است که] نه چیزی را باقی",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "b68438007d9a942e0b5ea5b0c8692a6fac7469276f13a79c3249ffe4305be536",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c6",
      "start": 1716,
      "end": 1745,
      "groups": [
        "p074-textual-coordination-748fcd4af1"
      ],
      "sourceText": "لَا تُبْقِي"
    },
    {
      "id": "p074-u0023",
      "text": "گذارد و نه رها می کند؛",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(7) > span:nth-of-type(4)",
      "textHash": "d91bafa088a80b8a785c031983f0973ac5c8cdbff28f336fabe8d49d0625c987",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c6",
      "start": 1748,
      "end": 1773,
      "groups": [
        "p074-textual-coordination-748fcd4af1"
      ],
      "sourceText": "لَا تَذَرُ"
    },
    {
      "id": "p074-u0024",
      "text": "و ما موکّلان آتش",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "68df90a4635ae61c37991064f1604aae426d0ecad3bb19b823595c5a273b68cc",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 31,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c7",
      "start": 1905,
      "end": 1921,
      "groups": [
        "p074-local-underline-pattern-a253ea4300"
      ],
      "sourceText": "وَمَا جَعَلْنَا"
    },
    {
      "id": "p074-u0025",
      "text": "آنان را جز آزمایشی",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(2)",
      "textHash": "ccd6666ac35caee67539471528779ab1c946706dd72acb6ba3ad782cc1eb37ea",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 31,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c7",
      "start": 1960,
      "end": 1978,
      "groups": [
        "p074-local-underline-pattern-a253ea4300"
      ],
      "sourceText": "وَمَا جَعَلْنَا"
    },
    {
      "id": "p074-u0026",
      "text": "هماهنگی قرآن با کتابشان] یقین پیدا کنند و بر",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(3)",
      "textHash": "3eb4c2cd75f3771b79a061af9967eb6ebc055655fd4dac1095c45b2ed52b2f50",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c8",
      "start": 2056,
      "end": 2101,
      "groups": [
        "p074-textual-coordination-7d7aed9be5"
      ],
      "sourceText": "يَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ"
    },
    {
      "id": "p074-u0027",
      "text": "ایمان مؤمنان بیفزاید، و اهل کتاب و مؤمنان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4)",
      "textHash": "a2d659f56f68df9c73d5e20cd92bd0342e5146f8d926f07545d86a4e89a6d8ac",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c8",
      "start": 2101,
      "end": 2142,
      "groups": [
        "p074-textual-coordination-7d7aed9be5"
      ],
      "sourceText": "يَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا"
    },
    {
      "id": "p074-u0028",
      "text": "حقّانیّت قرآن] تردید نکنند، و تا بیماردلان و کافران بگویند:",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(5)",
      "textHash": "7fd3d0f8f6d7f09dbd25e0327975c696a14cd5871983ce3cf38596824ed9214f",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c8",
      "start": 2146,
      "end": 2207,
      "groups": [
        "p074-textual-coordination-7d7aed9be5"
      ],
      "sourceText": "لَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ"
    },
    {
      "id": "p074-u0029",
      "text": "تردید نکنند، و تا بیماردلان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "87207840fa9bf879546c135bcee8c0fe8f8a7568f9b215ed70fc17e5b3546eb7",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 8,
      "parentId": "p074-u0028",
      "sectionId": "p074-s0001",
      "contextId": "p074-c8",
      "start": 2161,
      "end": 2189,
      "groups": [
        "p074-textual-coordination-b57f2a250a"
      ],
      "sourceText": "الَّذِينَ أُوتُوا الْكِتَابَ"
    },
    {
      "id": "p074-u0030",
      "text": "کافران بگویند:",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "223d467e0d1b69363095288e5e33140026ea0626045836c168fb016c0988a62b",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 8,
      "parentId": "p074-u0028",
      "sectionId": "p074-s0001",
      "contextId": "p074-c8",
      "start": 2191,
      "end": 2207,
      "groups": [
        "p074-textual-coordination-b57f2a250a"
      ],
      "sourceText": "الْمُؤْمِنُونَ"
    },
    {
      "id": "p074-u0031",
      "text": "گماشتگان آتش به این [نوزده نفر] چه",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(3)",
      "textHash": "cb71ee2009cb47200b0ec8c8e71978bc8c021b5a1423f55ddba67605fb9451f1",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c9",
      "start": 2248,
      "end": 2282,
      "groups": [
        "p074-textual-coordination-5cc89cef4c"
      ],
      "sourceText": "الَّذِينَ فِي قُلُوبِهِم مَّرَضٌ"
    },
    {
      "id": "p074-u0032",
      "text": "هدفی دارد؟ این",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(4)",
      "textHash": "9783cc7ec992f0f4d462564625eac59ee1aea59b77597230c1325b2c2251f80b",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 31,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c9",
      "start": 2283,
      "end": 2298,
      "groups": [
        "p074-textual-coordination-5cc89cef4c"
      ],
      "sourceText": "الْكَافِرُونَ"
    },
    {
      "id": "p074-u0033",
      "text": "کند و هر که را بخواهد هدایت",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(1)",
      "textHash": "2962f5ab4f82990e33acee5425501937ca86e7f90bfc35369353e29350aa009a",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 31,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c10",
      "start": 2376,
      "end": 2403,
      "groups": [
        "p074-paired-contrast-a167eb46a3"
      ],
      "sourceText": "يُضِلُّ اللَّهُ مَن يَشَاءُ"
    },
    {
      "id": "p074-u0034",
      "text": "نماید، و سپاهیان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "d4569bc1726eab417b09fa9fceff2841c39fdbc89163583077640a1e159960c6",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 31,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": "p074-s0001",
      "contextId": "p074-c10",
      "start": 2406,
      "end": 2425,
      "groups": [
        "p074-paired-contrast-a167eb46a3"
      ],
      "sourceText": "يَهْدِي مَن يَشَاءُ"
    },
    {
      "id": "p074-u0035",
      "text": "و انجام کار خیر] پیشی جوید",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(2)",
      "textHash": "ab8a6a5c502f1afa4c2ae923de5abce6b33fe220d764325985d750d48e5709ad",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 37,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": "p074-s0002",
      "contextId": "p074-c11",
      "start": 3123,
      "end": 3150,
      "groups": [
        "p074-textual-coordination-da05288566"
      ],
      "sourceText": "يَتَقَدَّمَ"
    },
    {
      "id": "p074-u0036",
      "text": "کفر، طغیان و گناه] پس ماند؛",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(3)",
      "textHash": "584d088b4fd01c145f2471dc0737cc797961d1625dc3fbe9193b7894b036d815",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 37,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": "p074-s0002",
      "contextId": "p074-c11",
      "start": 3160,
      "end": 3188,
      "groups": [
        "p074-textual-coordination-da05288566"
      ],
      "sourceText": "يَتَأَخَّرَ"
    },
    {
      "id": "p074-u0037",
      "text": "به دوزخ وارد کرد؟",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(3)",
      "textHash": "cfdd30d7a8c9a56b79b21b250abb0f7fae2b05802931ba7a88b1318a1835f63d",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-3px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 42,
      "blockIndex": 12,
      "parentId": null,
      "sectionId": null,
      "contextId": "p074-c12",
      "start": 3444,
      "end": 3461,
      "groups": [
        "p074-u0037-individual"
      ],
      "sourceText": "سَقَرَ"
    },
    {
      "id": "p074-u0038",
      "text": "به دوزخ وارد کرد؟",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(3) > span:nth-of-type(1)",
      "textHash": "cfdd30d7a8c9a56b79b21b250abb0f7fae2b05802931ba7a88b1318a1835f63d",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 42,
      "blockIndex": 12,
      "parentId": "p074-u0037",
      "sectionId": null,
      "contextId": "p074-c12",
      "start": 3444,
      "end": 3461,
      "groups": [
        "p074-u0038-individual"
      ],
      "sourceText": "سَقَرَ"
    },
    {
      "id": "p074-u0039",
      "text": "ما از نمازگزاران نبودیم",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(3)",
      "textHash": "8f9e6636d94e8814c6b9b691bf0afc1237672866ef1f74887f1f2fbe834bbab8",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 43,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p074-c13",
      "start": 3499,
      "end": 3523,
      "groups": [
        "p074-textual-coordination-9cdd824392"
      ],
      "sourceText": "لَمْ نَكُ مِنَ الْمُصَلِّينَ"
    },
    {
      "id": "p074-u0040",
      "text": "به تهیدستان و نیازمندان طعام نمی دادیم",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(4)",
      "textHash": "864d896ef4a67a24f4a392e3f9f518e6214d8a895585c8af1828ea5d5733d64c",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 44,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p074-c13",
      "start": 3527,
      "end": 3566,
      "groups": [
        "p074-textual-coordination-9cdd824392"
      ],
      "sourceText": "لَمْ نَكُ نُطْعِمُ الْمِسْكِينَ"
    },
    {
      "id": "p074-u0041",
      "text": "فرورفتگان [در گفتار و کردار باطل] فرومی رفتیم،",
