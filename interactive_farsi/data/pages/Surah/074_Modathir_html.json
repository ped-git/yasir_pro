      "start": 791,
      "end": 857,
      "groups": [
        "p074-textual-coordination-6954472050"
      ],
      "sourceText": "جَعَلْتُ لَهُ مَالًا مَّمْدُودًا۱۲ وَبَنِينَ شُهُودًا۱۳"
    },
    {
      "id": "p074-u0004",
      "text": "و فراوان قرار دادم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(2) > span:nth-of-type(1)",
