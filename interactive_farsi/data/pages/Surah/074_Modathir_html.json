      "end": 828,
      "groups": [
        "p074-textual-coordination-0ac727d552"
      ],
      "sourceText": "مَالًا مَّمْدُودًا"
    },
    {
      "id": "p074-u0005",
      "text": "فرزندانی که نزدش حاضرند",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(2) > span:nth-of-type(2)",
