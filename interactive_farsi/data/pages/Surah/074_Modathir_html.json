    },
    {
      "id": "p074-u0006",
      "text": "ها [ی مادی و وسایل زندگی] را به طور کامل برای او فراهم آوردم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(3)",
