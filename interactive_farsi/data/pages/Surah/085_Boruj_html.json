      "selector": "body:nth-of-type(1) > p:nth-of-type(8) > span:nth-of-type(2)",
      "textHash": "0dcd9cd5db4bf89f683c2163cf2c1b1d105f7f5dec9ecd2e013aa4e1ebc403e5",
