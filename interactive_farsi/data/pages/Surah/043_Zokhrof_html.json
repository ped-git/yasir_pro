        "p043-textual-coordination-698775628f"
      ],
      "sourceText": "يَخُوضُوا"
    },
    {
      "id": "p043-u0012",
      "text": "فرو روند و [با",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(4)",
      "textHash": "368b046a750f028c03247e568d7526db488e1358d314037801bed03383da06b7",
      "appearance": {
