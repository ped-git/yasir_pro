      "sourceText": "سِرَّهُمْ"
    },
    {
      "id": "p043-u0008",
      "text": "فرستادگان ما [که",
      "selector": "body:nth-of-type(1) > p:nth-of-type(15) > span:nth-of-type(2)",
      "textHash": "912218f134eee494732aad148553d335df0c0deb75e2f19f3fdd614a3afea7cb",
