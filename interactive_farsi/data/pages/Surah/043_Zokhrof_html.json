        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 83,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 11994,
      "end": 12010,
      "groups": [
        "p043-textual-coordination-698775628f"
      ],
      "sourceText": "يَلْعَبُوا"
    },
    {
      "id": "p043-u0013",
      "text": "اوست که در آسمان ها معبود [واقعی] است و در زمین هم معبود",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(5)",
      "textHash": "47697b7f5d7fbe586ce6d4a852b0d0d824044f9671cb8e9bc7a492658d483d71",
      "appearance": {
        "signature": "ul-color-gray-150 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 84,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12099,
      "end": 12156,
      "groups": [
        "p043-textual-coordination-f844d70ede"
      ],
      "sourceText": "هُوَ الَّذِي فِي السَّمَاءِ إِلَـٰهٌ وَفِي الْأَرْضِ إِلَـٰهٌ"
    },
    {
      "id": "p043-u0014",
      "text": "آسمان ها معبود [واقعی]",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "db4d373acaf24d114afcc992190669d5605f2fa7bdcdb35fc526e4f5bb09330b",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 84,
      "blockIndex": 8,
      "parentId": "p043-u0013",
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12110,
      "end": 12133,
      "groups": [
        "p043-textual-coordination-6d0e7cd30c"
      ],
      "sourceText": "فِي السَّمَاءِ إِلَـٰهٌ"
    },
    {
      "id": "p043-u0015",
      "text": "و در زمین هم معبود",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "07cc1644e9a93cd3c5a0b8643b1ed50e9b2c7dcb1ff8c4825bc39262bc35e363",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 84,
      "blockIndex": 8,
      "parentId": "p043-u0013",
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12136,
      "end": 12156,
      "groups": [
        "p043-textual-coordination-6d0e7cd30c"
      ],
      "sourceText": "فِي الْأَرْضِ إِلَـٰهٌ"
    },
    {
      "id": "p043-u0016",
      "text": "است و او حکیم و داناست.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(6)",
      "textHash": "cf385074e885e3a83ef5d762f808e7ec5ff90d3aaf4da38496e56f6eb408d684",
      "appearance": {
        "signature": "ul-color-gray-150 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 84,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12163,
      "end": 12187,
      "groups": [
        "p043-textual-coordination-f844d70ede"
      ],
      "sourceText": "هُوَ الْحَكِيمُ الْعَلِيمُ"
    },
    {
      "id": "p043-u0017",
      "text": "سودمند و با برکت است کسی که مالکیّت و فرمانروایی آسمان ها و زمین و آنچه میان آنهاست، فقط در سیطره",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(7)",
      "textHash": "03fb3991f59716c0297b24d14a1926596a177f8b3678415271dcc5f494c65c18",
      "appearance": {
        "signature": "ul-color-gray-150 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 85,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12194,
      "end": 12293,
      "groups": [
        "p043-textual-coordination-f844d70ede"
      ],
      "sourceText": "تَبَارَكَ الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا"
    },
    {
      "id": "p043-u0018",
      "text": "فرمانروایی آسمان ها",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(7) > span:nth-of-type(1)",
      "textHash": "9c9fbe38fd274fae3e186c613481924a7726812d44f05607ff21886df4533e18",
      "appearance": {
        "signature": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed ul-color-gray-180",
        "structure": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed",
        "colorFamily": "gray"
      },
      "verse": 85,
      "blockIndex": 8,
      "parentId": "p043-u0017",
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12232,
      "end": 12252,
      "groups": [
        "p043-textual-coordination-ec124f3a7b"
      ],
      "betaEditorialReason": "The heavens and earth are neutral objects named within positive statements of divine lordship and dominion.",
      "betaSemanticRole": "neutral",
      "sourceText": "السَّمَاوَاتِ"
    },
    {
      "id": "p043-u0019",
      "text": "زمین و آنچه",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(7) > span:nth-of-type(2)",
      "textHash": "c82c1b86f91c74c18516555955f372461b1f3b1d1cf4686c7799ed7155893134",
      "appearance": {
        "signature": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed ul-color-gray-180",
        "structure": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed",
        "colorFamily": "gray"
      },
      "verse": 85,
      "blockIndex": 8,
      "parentId": "p043-u0017",
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12255,
      "end": 12267,
      "groups": [
        "p043-textual-coordination-ec124f3a7b"
      ],
      "betaEditorialReason": "The heavens and earth are neutral objects named within positive statements of divine lordship and dominion.",
      "betaSemanticRole": "neutral",
      "sourceText": "الْأَرْضِ"
    },
    {
      "id": "p043-u0020",
      "text": "آنهاست، فقط در سیطره",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "38b4f08130b894339a7268bd98f659893702141fde0c4424083de31101b4b6c4",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 85,
      "blockIndex": 8,
      "parentId": "p043-u0017",
      "sectionId": null,
      "contextId": "p043-c8",
      "start": 12271,
      "end": 12293,
      "groups": [
        "p043-textual-coordination-ec124f3a7b"
      ],
      "sourceText": "مَا بَيْنَهُمَا"
    },
    {
      "id": "p043-u0021",
      "text": "و آگاهی [به همه شؤون] قیامت نزد",
      "selector": "body:nth-of-type(1) > p:nth-of-type(17) > span:nth-of-type(8)",
