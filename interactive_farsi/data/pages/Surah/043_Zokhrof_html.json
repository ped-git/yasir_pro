  "sections": [
    {
      "id": "p043-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "o [نه] بلکه [هیچ دلیلی بر حقّانیّت بت",
        "last": "گفتند: این جادوست و ما به آن کافریم،۳۰"
      },
      "lines": [
        "p043-l0001"
      ]
    },
    {
      "id": "p043-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "o و گفتند: این قرآن چرا بر مردمی",
        "last": "نیست، و آخرت نزد پروردگارت برای پرهیزکاران است؛۳۵"
      },
      "lines": [
        "p043-l0002"
      ]
    },
    {
      "id": "p043-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "و هر کس خود را از یاد [خدای]",
        "last": "همه با هم در عذاب مشترک خواهید بود؛۳۹"
      },
      "lines": [
        "p043-l0003"
      ]
    },
    {
      "id": "p043-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "پس آیا تو می توانی [دعوتت را] به",
        "last": "رحمان معبودانی که پرستش شوند، قرار داده ایم؟!۴۵"
      },
      "lines": [
        "p043-l0004"
      ]
    },
    {
      "id": "p043-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(6)",
      "excerpt": {
        "first": "و به راستی ما موسی را با نشانه",
        "last": "پیشگامان [دوزخیان] و عبرتی برای آیندگان قرار دادیم.۵۶"
      },
      "lines": [
        "p043-l0005"
      ]
    },
    {
      "id": "p043-s0006",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(7)",
      "excerpt": {
        "first": "و چون فرزند مریم [در آیات قرآن به",
        "last": "آیات خدا] ستم ورزیدند از عذاب روزی دردناک.۶۵"
      },
      "lines": [
        "p043-l0006"
      ]
    },
    {
      "id": "p043-s0007",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(8)",
      "excerpt": {
        "first": "آیا جز این انتظاری دارند که ناگاه قیامت",
        "last": "آوردیم، ولی بیشتر شما حق را خوش نداشتید،۷۸"
      },
      "lines": [
        "p043-l0007"
      ]
    }
  ],
