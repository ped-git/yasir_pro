    },
    {
      "id": "beta-u-43-68-1",
      "text": "آنان گوید:] ای بندگان من! امروز نه بیمی",
      "logicalText": "لا خوف عليكم اليوم",
      "textHash": "fd0a83ea4feb662c01bb433c29a8eac973740f478a47538f6a437f54795b8ed7",
      "selector": "body:nth-of-type(1) > div:nth-of-type(8) > p:nth-of-type(2) > span:nth-of-type(3)",
