      ],
      "sourceText": "لَا تُطِعْ"
    },
    {
      "id": "p076-u0024",
      "text": "کافری از",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(3)",
      "textHash": "b161975a310092a94273320206314b82ea63fa2ae238105a09a70725e236ebe2",
      "appearance": {
