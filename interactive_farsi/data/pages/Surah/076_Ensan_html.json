      "start": 2498,
      "end": 2508,
      "groups": [
        "p076-textual-coordination-aac34f755d"
      ],
      "sourceText": "بُكْرَةً"
    },
    {
      "id": "p076-u0028",
      "text": "یاد کن.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(7)",
      "textHash": "a853a3adadbb1f18630f374c43011b3e7b791671dd6aacfb86e201a55bb4b135",
