      ],
      "sourceText": "كَفُورًا"
    },
    {
      "id": "p076-u0026",
      "text": "صبح و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(5)",
      "textHash": "cc7c8af0292329a08a84d8ce43b8b6d0ffbc1a2c0fbacc89ac20dfbb072f8a29",
