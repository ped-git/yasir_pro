    },
    {
      "id": "p076-u0027",
      "text": "پروردگارت",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(6)",
      "textHash": "f382c14898bccafc359369457298d863c28d3c334633dd912e98163c4b6ffba8",
      "appearance": {
