      "end": 2464,
      "groups": [
        "p076-textual-coordination-3fd52e2906"
      ],
      "sourceText": "آثِمًا"
    },
    {
      "id": "p076-u0025",
      "text": "اطاعت مکن،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(4)",
      "textHash": "5899c587238c7ee8ec39d89e5acb80ab5b5724091510347e851d5adf9563cee7",
      "appearance": {
