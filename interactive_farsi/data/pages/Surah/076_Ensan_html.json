        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 25,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2511,
      "end": 2518,
      "groups": [
        "p076-textual-coordination-aac34f755d"
      ],
      "sourceText": "أَصِيلًا"
    },
    {
      "id": "p076-u0029",
      "text": "به سجده",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(8)",
      "textHash": "ab99d2f060a382d769159613ec0a71b1ebe9ee2913b1695df4caa2ddea9adfe9",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 26,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2541,
      "end": 2550,
      "groups": [
        "p076-local-underline-pattern-ea3cad5413"
      ],
      "sourceText": "اسْجُدْ"
    },
    {
      "id": "p076-u0030",
      "text": "او را در",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(9)",
      "textHash": "08a00ee244ef2a8853cfa00e7e73d7ee7699dfb09543d72bafe1aea380a8bb51",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-black-white ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 26,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2557,
      "end": 2566,
      "groups": [
        "p076-local-underline-pattern-ea3cad5413"
      ],
      "sourceText": "سَبِّحْ"
    },
    {
      "id": "p076-u0031",
      "text": "اند] دنیای زودگذر را دوست دارند [و فقط برای به",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(10)",
      "textHash": "38bc25024179b8410a906e27f8ed17b5a5d36d85b4f5cf1cb44004e08acec2cb",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 27,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2623,
      "end": 2670,
      "groups": [
        "p076-textual-coordination-7ecffe3efb"
      ],
      "sourceText": "يُحِبُّونَ الْعَاجِلَةَ"
    },
    {
      "id": "p076-u0032",
      "text": "آوردن آن می کوشند] و روز هولناک و سختی را که پیش رو دارند وامی گذارند.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(11)",
      "textHash": "d381dbe6fe5431ac68de7c3119b74ee7987062e6d691a941b4f38fed683fe1da",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 27,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2674,
      "end": 2747,
      "groups": [
        "p076-textual-coordination-7ecffe3efb"
      ],
      "sourceText": "يَذَرُونَ وَرَاءَهُمْ يَوْمًا ثَقِيلًا"
    },
    {
      "id": "p076-u0033",
      "text": "و مفاصلشان را [با رشته های",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(12)",
      "textHash": "dcc0edf99ac43760547a61712b8ea450b3d4be8ece464f9a4b96a87aa57df34e",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2767,
      "end": 2794,
      "groups": [
        "p076-textual-coordination-f8122a7c28"
      ],
      "sourceText": "خَلَقْنَاهُمْ"
    },
    {
      "id": "p076-u0034",
      "text": "اعصاب و عضلات] محکم و استوار کردیم، و هرگاه",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(13)",
      "textHash": "f64910a2d8b729a52509b7a1cbb2bff7a0fbbb37daa834ee762e9009cb384392",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2795,
      "end": 2839,
      "groups": [
        "p076-textual-coordination-f8122a7c28"
      ],
      "sourceText": "شَدَدْنَا أَسْرَهُمْ"
    },
    {
      "id": "p076-u0035",
      "text": "[آنان را نابود می کنیم و] امثال و نظایرشان را [که مطیع و فرمانبردارند] به جای آنان قرار می دهیم.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(14)",
      "textHash": "6f22bf5e896b46b840c70f15dc1db9729caca6db5ae2593db4829bf513abd294",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c4",
      "start": 2846,
      "end": 2945,
      "groups": [
        "p076-textual-coordination-f8122a7c28"
      ],
      "sourceText": "إِذَا شِئْنَا بَدَّلْنَا أَمْثَالَهُمْ تَبْدِيلًا"
    },
    {
      "id": "p076-u0036",
      "text": "هر کس را بخواهد در رحمتش درآورد",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "fed27bef6765e99bedd0e9e4ccbad5e7ba25a683b0ebcceb0f2be72ee549fa3c",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 31,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c5",
      "start": 3149,
      "end": 3180,
      "groups": [
        "p076-paired-contrast-bb3f5fdb81"
      ],
      "sourceText": "يُدْخِلُ مَن يَشَاءُ فِي رَحْمَتِهِ"
    },
    {
      "id": "p076-u0037",
      "text": "برای ستمکاران عذابی دردناک آماده کرده است.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "334fa5c7f04c932e8273194423dea89f1011bbeeecc60be0e5fa8dc283f05d3b",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 31,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": null,
      "contextId": "p076-c5",
      "start": 3183,
      "end": 3225,
      "groups": [
        "p076-paired-contrast-bb3f5fdb81"
      ],
      "sourceText": "الظَّالِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًا"
    }
