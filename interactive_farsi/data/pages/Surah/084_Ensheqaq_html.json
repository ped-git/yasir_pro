        "p084-textual-coordination-b237bb1dcf"
      ],
      "sourceText": "مَا وَسَقَ"
    },
    {
      "id": "p084-u0021",
      "text": "شود که ایمان نمی آورند؟!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(10) > span:nth-of-type(1)",
      "textHash": "ee0cd5a791ede479330ea30b6df2ce6d3b5b3944864e45da6527d9775eb15605",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 20,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c8",
      "start": 1898,
      "end": 1923,
      "groups": [
        "p084-textual-coordination-2b1a65ba18"
      ],
      "sourceText": "لَا يُؤْمِنُونَ"
    },
    {
      "id": "p084-u0022",
      "text": "هرگاه قرآن را بر آنان خوانند، خاضع و تسلیم نمی شوند؟!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(10) > span:nth-of-type(2)",
      "textHash": "b3937b5a55b6225ba360adaaba5ec248b533dfab5860c49ced3a3b52eca2e1b7",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c8",
      "start": 1927,
      "end": 1981,
      "groups": [
        "p084-textual-coordination-2b1a65ba18"
      ],
      "sourceText": "إِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ"
    },
    {
      "id": "p084-u0023",
      "text": "همواره انکار هم می کنند!",
      "selector": "body:nth-of-type(1) > p:nth-of-type(11) > span:nth-of-type(1)",
      "textHash": "7915bfd4aed9ce81e2cdb056e2651cf632cac36f777a606ab6995e131995ed54",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 22,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c9",
      "start": 2011,
      "end": 2036,
      "groups": [
        "p084-red-green-pair-fa3a1a5d75",
        "p084-red-green-pair-43243919ff",
        "p084-red-green-pair-4a732b5ae6"
      ],
      "sourceText": "كَفَرُوا يُكَذِّبُونَ"
    },
    {
      "id": "p084-u0024",
      "text": "پس آنان را به عذابی دردناک بشارت ده.….",
      "selector": "body:nth-of-type(1) > p:nth-of-type(11) > span:nth-of-type(2)",
      "textHash": "13b79d6a4078cd3ae5a874353cf08fb535f3df168e0c1023c9831b48e96b6575",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 24,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c9",
      "start": 2128,
      "end": 2166,
      "groups": [
        "p084-red-green-pair-43243919ff",
        "p084-red-green-pair-4a732b5ae6"
      ],
      "sourceText": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"
    },
    {
      "id": "p084-u0025",
      "text": "آورده و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(12) > span:nth-of-type(1)",
      "textHash": "2e1223afef139d504b1995d61697533bbdc82802b40d61e759e0d88577a8bbd2",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 25,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c10",
      "start": 2204,
      "end": 2213,
      "groups": [
        "p084-textual-coordination-b4e5f07927",
        "p084-red-green-pair-fa3a1a5d75",
        "p084-red-green-pair-43243919ff",
        "p084-red-green-pair-4a732b5ae6"
      ],
      "sourceText": "آمَنُوا"
    },
    {
      "id": "p084-u0026",
      "text": "شایسته انجام داده اند، که",
      "selector": "body:nth-of-type(1) > p:nth-of-type(12) > span:nth-of-type(2)",
      "textHash": "a8d2136cc8fa483117729b13333e936ece62a779432a9ca27c33052a32546709",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 25,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c10",
      "start": 2219,
      "end": 2245,
      "groups": [
        "p084-textual-coordination-b4e5f07927",
        "p084-red-green-pair-fa3a1a5d75",
        "p084-red-green-pair-43243919ff",
        "p084-red-green-pair-4a732b5ae6"
      ],
      "sourceText": "عَمِلُوا الصَّالِحَاتِ"
    },
    {
      "id": "p084-u0027",
      "text": "آنان را پاداشی جاودان و بی منت است.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(12) > span:nth-of-type(3)",
      "textHash": "a288dfc199f124e93febcecf1dfdb94eef527fb8dc5a4759ca400d246d21a55a",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 25,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p084-c10",
      "start": 2246,
      "end": 2282,
      "groups": [
        "p084-red-green-pair-4a732b5ae6"
      ],
      "sourceText": "لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"
