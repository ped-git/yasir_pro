        "p032-red-green-pair-27a9ac640e",
        "p032-red-green-pair-3dfe19d192"
      ],
      "sourceText": "مَن كَانَ مُؤْمِنًا"
    },
    {
      "id": "p032-u0029",
      "text": "هستند که فاسق اند؟ [نه هرگز این",
      "selector": "body:nth-of-type(1) > p:nth-of-type(9) > span:nth-of-type(2)",
