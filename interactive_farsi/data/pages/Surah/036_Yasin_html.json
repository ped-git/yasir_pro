      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "و برای آنان [که با تو برخورد خصمانه",
        "last": "آن فریاد] همه بی حرکت و خاموش شدند!۲۹"
