  "sections": [
    {
      "id": "p037-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "بلکه [تو از انکارشان] تعجب می کنی و",
        "last": "همواره انجام می دادید، پاداش داده نمی شوید،۳۹"
      },
      "lines": [
        "p037-l0001"
      ]
    },
    {
      "id": "p037-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "جز بندگان خالص شده خدا [که از هر",
        "last": "باید برای چنین پاداشی عمل کنندگان عمل کنند.۶۱"
      },
      "lines": [
        "p037-l0002"
      ]
    },
    {
      "id": "p037-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "آیا این [بهشت جاودان پر نعمت] برای پذیرایی",
        "last": "بود؟۷۳[همه هلاک شدند] جز بندگان خالص شده خدا،۷۴"
      },
      "lines": [
        "p037-l0003"
      ]
    },
    {
      "id": "p037-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "و نوح ما را ندا کرد [و ما",
        "last": "نعمت ها و مواهب خود] بهره مند کردیم.۱۴۸"
      },
      "lines": [
        "p037-l0004"
      ]
    },
    {
      "id": "p037-s0005",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(3)",
      "excerpt": {
        "first": "و نوح ما را ندا کرد [و ما",
        "last": "بندگان مؤمن ما بود.۸۱سپس دیگران را غرق کردیم؛۸۲"
      },
      "lines": [
        "p037-l0005"
      ]
    },
    {
      "id": "p037-s0006",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(4)",
      "excerpt": {
        "first": "و به راستی ابراهیم از پیروان نوح بود،۸۳هنگامی",
        "last": "برخی نیکوکارند و برخی آشکارا ستمکار بر خویشند،۱۱۳"
      },
      "lines": [
        "p037-l0006"
      ]
    },
    {
      "id": "p037-s0007",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(5)",
      "excerpt": {
        "first": "و به راستی ما به موسی و هارون",
        "last": "تردید هر دو از بندگان مؤمن ما بودند،۱۲۲"
      },
      "lines": [
        "p037-l0007"
      ]
    },
    {
      "id": "p037-s0008",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(6)",
      "excerpt": {
        "first": "و بی تردید الیاس از پیامبران بود.۱۲۳ t",
        "last": "دهیم.۱۳۱بی تردید او از بندگان مؤمن ما بود.۱۳۲"
      },
      "lines": [
        "p037-l0008"
      ]
    },
    {
      "id": "p037-s0009",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(7)",
      "excerpt": {
        "first": "و بی تردید لوط از پیامبران بود.۱۳۳[یاد کن]",
        "last": "می کنید،۱۳۷و نیز شبانگاهان، آیا تعقّل نمی کنید؟۱۳۸"
      },
      "lines": [
        "p037-l0009"
      ]
    },
    {
      "id": "p037-s0010",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(8)",
      "excerpt": {
        "first": "و یونس از پیامبران بود.۱۳۹[یاد کن] هنگامی را",
        "last": "نعمت ها و مواهب خود] بهره مند کردیم.۱۴۸"
      },
      "lines": [
        "p037-l0010"
      ]
    }
  ],
