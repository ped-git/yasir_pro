  "underlines": [
    {
      "id": "p037-u0001",
      "text": "سوگند به صف بستگان [مانند فرشتگان، نمازگزاران و جهادگران] که صفی [منظم و استوار] بسته اند،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(1)",
      "textHash": "607ee3df1a937e299d3e4a218b0dec24098db1120881c424feb833b00106eab9",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 1,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 105,
      "end": 195,
      "groups": [
        "p037-textual-coordination-61ead7323a"
      ],
      "sourceText": "وَالصَّافَّاتِ صَفًّا"
    },
    {
      "id": "p037-u0002",
      "text": "و به بازدارندگان که [انسان را از گناهان] به شدت باز می دارند،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(2)",
      "textHash": "a37a257a26c2e263927925c79c4981bc0318650078d3d8528e8a837bab72a17c",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 2,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 203,
      "end": 265,
      "groups": [
        "p037-textual-coordination-61ead7323a"
      ],
      "sourceText": "فَالزَّاجِرَاتِ زَجْرًا"
    },
    {
      "id": "p037-u0003",
      "text": "و به تلاوت کنندگان وحی،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(3)",
      "textHash": "cae91ef6767cc69187d05684246f9e27a3e60e64d5470a3f52e1e6fee9fec9c7",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 3,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 273,
      "end": 296,
      "groups": [
        "p037-textual-coordination-61ead7323a"
      ],
      "sourceText": "فَالتَّالِيَاتِ ذِكْرًا"
    },
    {
      "id": "p037-u0004",
      "text": "پروردگار آسمان ها وزمین وآنچه میان آنهاست، و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4)",
      "textHash": "b9d4630898f773a705d65696e3525bcd24e5e7dcd5499834d7a98c630e3979fa",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 337,
      "end": 381,
      "groups": [
        "p037-textual-coordination-b7cf869ab5"
      ],
      "sourceText": "رَّبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا"
    },
    {
      "id": "p037-u0005",
      "text": "آسمان ها",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4) > span:nth-of-type(1)",
      "textHash": "611d647d85e34d618cbb1935fcfbdd8c6320efa364c1cef3af3cbcea306b1c53",
      "appearance": {
        "signature": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed ul-color-gray-220",
        "structure": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": "p037-u0004",
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 345,
      "end": 355,
      "groups": [
        "p037-textual-coordination-6f3e46779f"
      ],
      "betaEditorialReason": "The heavens and earth are coordinated neutral objects of lordship, not independently good acts.",
      "betaSemanticRole": "neutral",
      "sourceText": "السَّمَاوَاتِ"
    },
    {
      "id": "p037-u0006",
      "text": "وزمین وآنچه",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "9fd1756734a2d4f212377e5f26fc07b94f886579a4945f45c99cef0d09ed1060",
      "appearance": {
        "signature": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed ul-color-gray-220",
        "structure": "ul-sides-open ul-pad-y-0px ul-pad-x-0px ul-thickness-1px ul-pattern-dashed",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": "p037-u0004",
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 355,
      "end": 366,
      "groups": [
        "p037-textual-coordination-6f3e46779f"
      ],
      "betaEditorialReason": "The heavens and earth are coordinated neutral objects of lordship, not independently good acts.",
      "betaSemanticRole": "neutral",
      "sourceText": "الْأَرْضِ"
    },
    {
      "id": "p037-u0007",
      "text": "میان آنهاست، و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4) > span:nth-of-type(3)",
      "textHash": "d41a4e2f1c0c6b061857df6de150ccef7c94c81f8ec75dd254767546a16c3178",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": "p037-u0004",
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 367,
      "end": 381,
      "groups": [
        "p037-textual-coordination-6f3e46779f"
      ],
      "sourceText": "مَا بَيْنَهُمَا"
    },
    {
      "id": "p037-u0008",
      "text": "پروردگار مشرق ها،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(5)",
      "textHash": "fc890f02983f1e8abccae20a80d0e4affe5564b1c33a59b126661c1b1341a282",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 382,
      "end": 399,
      "groups": [
        "p037-textual-coordination-b7cf869ab5"
      ],
      "sourceText": "رَبُّ الْمَشَارِقِ"
    },
    {
      "id": "p037-u0009",
      "text": "مشرق ها،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "b1ba9ac50c12df89bef6f7b47d601ba772565fabdf3d471a5728f9bd934d361b",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 1,
      "parentId": "p037-u0008",
      "sectionId": null,
      "contextId": "p037-c1",
      "start": 390,
      "end": 399,
      "groups": [
        "p037-u0009-individual"
      ],
      "sourceText": "الْمَشَارِقِ"
    },
    {
      "id": "p037-u0010",
      "text": "کنی و آنان مسخره می کنند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "68f9e53458181c0a52de81037d7b81a08d2fcbf2b8b99453287def2505dbdca0",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 12,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c2",
      "start": 1113,
      "end": 1139,
      "groups": [
        "p037-textual-coordination-e934a57f9b"
      ],
      "sourceText": "يَسْخَرُونَ"
    },
    {
      "id": "p037-u0011",
      "text": "هنگامی که به آنان تذکر، می دهند متذکّر نمی شوند؛",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(2)",
      "textHash": "7881e7b3cbb2e973f989be0618e31b950169a6379f346aba4c8452b7820b7c44",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 13,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c2",
      "start": 1143,
      "end": 1193,
      "groups": [
        "p037-textual-coordination-e934a57f9b"
      ],
      "sourceText": "إِذَا ذُكِّرُوا لَا يَذْكُرُونَ"
    },
    {
      "id": "p037-u0012",
      "text": "معجزه ای را می بینند به شدت مسخره می کنند [و دیگران را هم به مسخره وامی دارند،]",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > span:nth-of-type(3)",
      "textHash": "ef80c9ca658277dba8d1374cf6a4920a4261d0ff620b2d17eed474c4d5ada2bd",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 14,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c2",
      "start": 1200,
      "end": 1284,
      "groups": [
        "p037-textual-coordination-e934a57f9b"
      ],
      "sourceText": "إِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ"
    },
    {
      "id": "p037-u0013",
      "text": "ستمکاران و هم ردیفان آنان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "513d9fb7b0d02296db94892a5f6d77e715c169ee441d31bed85636651b53c8ed",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c3",
      "start": 1973,
      "end": 1999,
      "groups": [
        "p037-textual-coordination-af05808048"
      ],
      "sourceText": "الَّذِينَ ظَلَمُوا"
    },
    {
      "id": "p037-u0014",
      "text": "معبودهایی را که همواره",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(7) > span:nth-of-type(4)",
      "textHash": "2851358972c49c612d735e01625ba1a4126221af4e5f78871d409a78934154e8",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c3",
      "start": 2001,
      "end": 2024,
      "groups": [
        "p037-textual-coordination-af05808048"
      ],
      "sourceText": "أَزْوَاجَهُمْ"
    },
    {
      "id": "p037-u0015",
      "text": "به جای خدا می پرستیدند، گرد آورید.۲۲پس همه را به",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(7) > span:nth-of-type(5)",
      "textHash": "f603ee6afef45f4a02a25528b4ddfd29f43aae54dc53977570f4771d1394411a",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c3",
      "start": 2025,
      "end": 2074,
      "groups": [
        "p037-textual-coordination-af05808048"
      ],
      "sourceText": "مَا كَانُوا يَعْبُدُونَ۲۲ مِن دُونِ اللَّهِ"
    },
    {
      "id": "p037-u0016",
      "text": "زیرا آنان چنین بودند که هر زمان به آنان می گفتند: معبودی جز خدا نیست، تکبّر می کردند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(14) > span:nth-of-type(1)",
      "textHash": "86eedce69adb8453abe250d624309862f0b292de87baa04387be07e6f7cfae47",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 35,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c4",
      "start": 3132,
      "end": 3219,
      "groups": [
        "p037-textual-coordination-4fad725895"
      ],
      "sourceText": "إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَـٰهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ"
    },
    {
      "id": "p037-u0017",
      "text": "[همواره] می گفتند: آیا باید به خاطر شاعری دیوانه معبودان خود را رها کنیم؟!",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(14) > span:nth-of-type(2)",
      "textHash": "94a0f3abbf7d6414568c486e5a4654e00e6b5e2c6cc78accc51c87b29f454fff",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 36,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p037-s0001",
      "contextId": "p037-c4",
      "start": 3223,
      "end": 3298,
      "groups": [
        "p037-textual-coordination-4fad725895"
      ],
      "sourceText": "يَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَّجْنُونٍ"
    },
    {
      "id": "p037-u0018",
      "text": "و در میان آیندگان برای او نام نیک به جا گذاشتیم؛۷۸ سلام بر نوح در میان جهانیان.۷۹به راستی ما نیکوکاران را این گونه پاداش می دهیم.۸۰بی تردید او از بندگان مؤمن ما بود.۸۱",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "27b8b368e0a2c9afcace7c0ddeba1b66e2ae8c7ac972e35dc5fd76a876c4a970",
      "appearance": {
        "signature": "ul-sides-open ul-thickness-1px ul-pattern-solid ul-color-gray-100 ul-pad-y-2px",
        "structure": "ul-sides-open ul-thickness-1px ul-pattern-solid ul-pad-y-2px",
        "colorFamily": "gray"
      },
      "verse": 78,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": "p037-s0005",
      "contextId": "p037-c5",
      "start": 6452,
      "end": 6630,
      "groups": [
        "p037-u0018-individual"
      ],
      "betaEditorialReason": "Preserve the existing annotated semantic role but remove unpaired comparison color; gray is group identity only. Separate the newly nested underline levels so their different patterns remain visible.",
      "betaSemanticRole": "good",
      "sourceText": "وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ۷۸ سَلَامٌ عَلَىٰ نُوحٍ فِي الْعَالَمِينَ۷۹ إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ۸۰ إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ۸۱"
    },
    {
      "id": "p037-u0019",
      "text": "l",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(4) > p:nth-of-type(16) > span:nth-of-type(1) > span:nth-of-type(1)",
