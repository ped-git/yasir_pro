        "p068-textual-coordination-9faec5aa46"
      ],
      "sourceText": "سَتُبْصِرُ"
    },
    {
      "id": "p068-u0004",
      "text": "[منکران هم] می بینند،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "be6d5cbdafcfe282e574a6b3c30dd232fc8f16d23c6572b3c65ac4090af82564",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 2,
