      "end": 364,
      "groups": [
        "p068-textual-coordination-9faec5aa46"
      ],
      "sourceText": "يُبْصِرُونَ"
    },
    {
      "id": "p068-u0005",
      "text": "بهتر می داند چه کسی از راه او گمراه",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "f8f9bfebc9cafab9fef655d580c08394e77bcde2a49e9bea3cb933ec831d7f89",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 7,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": null,
      "contextId": "p068-c3",
      "start": 432,
      "end": 470,
      "groups": [
        "p068-paired-contrast-16ce7b0508"
      ],
      "sourceText": "هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِ"
    },
    {
      "id": "p068-u0006",
      "text": "و او به راه یافتگان داناتر است.….",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "825dabe7382b53f5ff61daaae63c900a2d6f703ac8c2103725aa24fda96a2343",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 7,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": null,
      "contextId": "p068-c3",
      "start": 474,
      "end": 508,
      "groups": [
        "p068-paired-contrast-16ce7b0508"
      ],
      "sourceText": "هُوَ أَعْلَمُ بِالْمُهْتَدِينَ"
    },
    {
      "id": "p068-u0007",
      "text": "تکذیب کنندگان",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "6586d453bc111bfeb77b29072ad7051b911058a547cc64aeb577c826afe51348",
      "appearance": {
