      "sourceText": "مَا يَسْطُرُونَ"
    },
    {
      "id": "p068-u0003",
      "text": "به زودی می بینی و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(1)",
