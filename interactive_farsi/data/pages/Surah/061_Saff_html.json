      "sectionId": "p061-s0001",
      "contextId": "p061-c4",
      "start": 901,
      "end": 957,
      "groups": [
        "p061-textual-coordination-6c96aaf1a8"
      ],
      "sourceText": "مُّصَدِّقًا لِّمَا بَيْنَ يَدَيَّ مِنَ التَّوْرَاةِ"
    },
    {
      "id": "p061-u0008",
      "text": "که بعد از من می آید و نامش « احمد » است، مژده می دهم. پس",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4)",
      "textHash": "c6e3f828e1c72322cfa0dcd8f4b1f11ac199a0461e356130e146e60232bf736c",
      "appearance": {
