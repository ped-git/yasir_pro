      "groups": [
        "p061-exact-normalized-text-eb39e16be0"
      ],
      "sourceText": "رَسُولُ اللَّهِ إِلَيْكُم"
    },
    {
      "id": "p061-u0007",
      "text": "تورات را که پیش از من بوده، تصدیق می کنم، و به پیامبری",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(3)",
