        "p061-textual-coordination-73cb20a934",
        "p061-local-underline-pattern-79c88fb280"
      ],
      "sourceText": "يَغْفِرْ لَكُمْ ذُنُوبَكُمْ"
    },
    {
      "id": "p061-u0022",
      "text": "را در بهشت هایی که از زیرِ [درختانِ] آن نهرها جاری است و خانه های پاکیزه در بهشت های جاویدان،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(7)",
      "textHash": "864f5642416c7198a9f369c2b0b096fcabdc195fcda6409e222e2c4ce90bb0d2",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-3px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-3px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 12,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p061-c8",
      "start": 1863,
      "end": 1957,
      "groups": [
        "p061-textual-coordination-73cb20a934",
        "p061-local-underline-pattern-79c88fb280"
      ],
      "sourceText": "يُدْخِلْكُمْ جَنَّاتٍ تَجْرِي مِن تَحْتِهَا الْأَنْهَارُ وَمَسَاكِنَ طَيِّبَةً فِي جَنَّاتِ عَدْنٍ"
    },
    {
      "id": "p061-u0023",
      "text": "هایی که از زیرِ [درختانِ] آن نهرها جاری است",
