    },
    {
      "id": "p061-u0021",
      "text": "تا گناهتان را بیامرزد، و شما",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(6)",
      "textHash": "ab0ed6ede6a7d4b789f39da045b136f6e103f404c0bb4d1fbdcb2aaaf057c43b",
      "appearance": {
