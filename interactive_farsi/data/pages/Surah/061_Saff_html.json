      "contextId": "p061-c3",
      "start": 725,
      "end": 778,
      "groups": [
        "p061-u0005-individual"
      ],
      "sourceText": "وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ"
    },
    {
      "id": "p061-u0006",
      "text": "من فرستاده خدا به سوی شمایم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(2)",
      "textHash": "bcf8f626fa4f06b47983613a7f3e07e09d1a90abab3c964b238794c46b6abb70",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-double ul-sides-open ul-thickness-0p8mm",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-double ul-sides-open ul-thickness-0p8mm",
        "colorFamily": "gray"
      },
      "verse": 6,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p061-s0001",
      "contextId": "p061-c4",
      "start": 872,
