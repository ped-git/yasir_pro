        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 6,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p061-s0001",
      "contextId": "p061-c4",
      "start": 958,
      "end": 1017,
      "groups": [
        "p061-textual-coordination-6c96aaf1a8"
      ],
      "sourceText": "مُبَشِّرًا بِرَسُولٍ يَأْتِي مِن بَعْدِي اسْمُهُ أَحْمَدُ"
    },
    {
      "id": "p061-u0009",
      "text": "و خدا مردم ستمکار را هدایت نمی کند.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(2)",
      "textHash": "15d877e5730748f1f0f4e1bddf8500d5cd676d20aec23c39e8ad9a1182c992fb",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 7,
