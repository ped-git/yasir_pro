    },
    {
      "id": "p061-u0005",
      "text": "هدایت] منحرف کرد، و خدا مردم فاسق را هدایت نمی کند.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(3)",
      "textHash": "0a24b665f226f52575ae1a56e6f931627fe56db3d6433ff1ace00d6bb74baeb7",
