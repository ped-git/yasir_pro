      "contextId": "p061-c2",
      "start": 387,
      "end": 493,
      "groups": [
        "p061-u0003-individual"
      ],
      "sourceText": "إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُم بُنْيَانٌ مَّرْصُوصٌ۴"
    },
    {
      "id": "p061-u0004",
      "text": "خدا به سوی شما هستم؟ پس هنگامی",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(2)",
