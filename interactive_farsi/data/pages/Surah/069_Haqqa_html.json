        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 7,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": "p069-s0001",
      "contextId": "p069-c3",
      "start": 515,
      "end": 537,
      "groups": [
        "p069-textual-coordination-e88bc0faca"
      ],
      "sourceText": "ثَمَانِيَةَ أَيَّامٍ"
    },
    {
      "id": "p069-u0008",
      "text": "آیا از آنان هیچ باقی مانده ای می بینی؟۸",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(4) > span:nth-of-type(1)",
      "textHash": "a7d764adf6755f120026da4d00abe977b61ab29ace0d07546063a0e990de70fe",
      "appearance": {
        "signature": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-color-currentcolor ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "structure": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "colorFamily": null
      },
      "verse": 8,
      "blockIndex": 4,
      "parentId": null,
