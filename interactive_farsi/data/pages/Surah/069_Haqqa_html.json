    },
    {
      "id": "p069-u0027",
      "text": "[فرمان آید] او را",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(3)",
      "textHash": "4c6ca9703355353b818e07ae1d278532a93817abb9b5560cf22399af832e18e7",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-black ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 30,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2627,
      "end": 2645,
      "groups": [
        "p069-textual-coordination-a71efc41df",
        "p069-local-underline-pattern-e3550c308c"
      ],
      "sourceText": "خُذُوهُ"
    },
    {
      "id": "p069-u0028",
      "text": "و در غل و زنجیرش کشید،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(4)",
      "textHash": "d07c182c90b7c24699f3da44b9c24f3ef327c41910c849d8d10ffec225ff197f",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-black ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 30,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2652,
      "end": 2674,
      "groups": [
        "p069-textual-coordination-a71efc41df",
        "p069-local-underline-pattern-e3550c308c"
      ],
      "sourceText": "غُلُّوهُ"
    },
    {
      "id": "p069-u0029",
      "text": "دراندازید،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(5)",
      "textHash": "056bbfd1f2b23f24f6a10c27be8cac7c8391dea8de9750775e8b8a3126f23c9c",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-black ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 31,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2692,
      "end": 2702,
      "groups": [
        "p069-local-underline-pattern-e3550c308c"
      ],
      "sourceText": "صَلُّوهُ"
    },
    {
      "id": "p069-u0030",
      "text": "بند کشید،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(6)",
      "textHash": "fdbfdd1cc6b83270a3c22520e7ca7adb995ea812264315ec13fad96bb6ac5577",
      "appearance": {
        "signature": "ul-color-currentcolor ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-stops-white-black ul-thickness-1px",
        "structure": "ul-gradient-to-left ul-image-gradient ul-image-slice-1 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": null
      },
      "verse": 32,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2748,
      "end": 2758,
      "groups": [
        "p069-local-underline-pattern-e3550c308c"
      ],
      "sourceText": "اسْلُكُوهُ"
    },
    {
      "id": "p069-u0031",
      "text": "به خدای بزرگ ایمان نمی آورده",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(7)",
      "textHash": "9b64c9cd59d23c0c6530e34205e8605036e9bc7aa44b01e58c76b03f9ee873bd",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 33,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2767,
      "end": 2797,
      "groups": [
        "p069-textual-coordination-05e36b056d"
      ],
      "sourceText": "كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ"
    },
    {
      "id": "p069-u0032",
      "text": "مردم را به اطعام نیازمندان تشویق نمی کرده.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(8)",
      "textHash": "ad3ebabaafd6d3c4370b80b9244bf7a2c376ce4ff1e820d34f7a3462d8dd8f70",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-2px",
        "colorFamily": "gray"
      },
      "verse": 34,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2801,
      "end": 2844,
      "groups": [
        "p069-textual-coordination-05e36b056d"
      ],
      "sourceText": "لَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ"
    },
    {
      "id": "p069-u0033",
      "text": "امروز او را در اینجا دوست مهربان و حمایت گری نیست؛",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(9)",
      "textHash": "4cb37f68450a7d0dc317aeca1492e6056f514d3a18743711e24cac9f0f79bfc9",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 35,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2849,
      "end": 2899,
      "groups": [
        "p069-textual-coordination-f877ec8b62"
      ],
      "sourceText": "لَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ"
    },
    {
      "id": "p069-u0034",
      "text": "غذایی مگر چرکاب و کثافات [ی از بدن اهل دوزخ!]",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(10)",
      "textHash": "cb33a2c9d9afd622a1f8f4fa8baf13341b18798382362ae0c02b6fbd06cda26c",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 36,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c10",
      "start": 2905,
      "end": 2952,
      "groups": [
        "p069-textual-coordination-f877ec8b62"
      ],
      "sourceText": "لَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"
    },
    {
      "id": "p069-u0035",
      "text": "[از محسوسات] می بینید،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(1)",
      "textHash": "b02b0dbc24e2b0b6c544ed8dc2189b9cbc989e60ee6dc771b2860f70d234ba1b",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 38,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c11",
      "start": 3048,
      "end": 3072,
      "groups": [
        "p069-textual-coordination-a9587131bd"
      ],
      "sourceText": "مَا تُبْصِرُونَ"
    },
    {
      "id": "p069-u0036",
      "text": "آنچه [از غیر محسوسات] نمی بینید،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "35eb90ef740f5cfff5d67ad474f08e842c92257f5bfccbfa9e619d1b4a85b234",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 39,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c11",
      "start": 3076,
      "end": 3109,
      "groups": [
        "p069-textual-coordination-a9587131bd"
      ],
      "sourceText": "مَا لَا تُبْصِرُونَ"
    },
    {
      "id": "p069-u0037",
      "text": "جز اندکی",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(3)",
      "textHash": "f81de421461c3ccbd4b056a2b02ec83a0ed85395ac792a95af3d1647d0965fdf",
