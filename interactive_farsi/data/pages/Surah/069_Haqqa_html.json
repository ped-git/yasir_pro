      "groups": [
        "p069-textual-coordination-62c93830f8"
      ],
      "sourceText": "اشْرَبُوا"
    },
    {
      "id": "p069-u0024",
      "text": "ام را دریافت نمی کردم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(3)",
      "textHash": "2e8877301c060376e045a4822c6cead34143f93676ad8633aad02712dae4ac87",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 25,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c9",
      "start": 2350,
      "end": 2374,
      "groups": [
        "p069-textual-coordination-c35f4861a7"
      ],
      "sourceText": "لَمْ أُوتَ كِتَابِيَهْ"
    },
    {
      "id": "p069-u0025",
      "text": "نمی دانستم حساب من چیست؟",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(4)",
      "textHash": "e59b2b3afcfea43957849f21c1f03618d3730b0fd8d2d2797af20230fc7bcfca",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 26,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": null,
      "contextId": "p069-c9",
      "start": 2378,
      "end": 2403,
      "groups": [
        "p069-textual-coordination-c35f4861a7"
      ],
      "sourceText": "لَمْ أَدْرِ مَا حِسَابِيَهْ"
    },
    {
      "id": "p069-u0026",
      "text": "l",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(1) > p:nth-of-type(3) > span:nth-of-type(1) > span:nth-of-type(1)",
