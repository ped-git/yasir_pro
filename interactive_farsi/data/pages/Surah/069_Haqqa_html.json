    },
    {
      "id": "p069-u0023",
      "text": "گویند:] بخورید",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(4)",
