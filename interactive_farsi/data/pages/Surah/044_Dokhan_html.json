        "colorFamily": "gray"
      },
      "verse": 38,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": null,
      "contextId": "p044-c8",
      "start": 3418,
      "end": 3431,
      "groups": [
        "p044-textual-coordination-17f7eeea32",
        "p044-exact-normalized-text-0982d63ff9"
      ],
      "sourceText": "مَا بَيْنَهُمَا"
    },
    {
      "id": "p044-u0027",
      "text": "که هیچ دوستی چیزی از عذاب را از دوستش دفع نمی کند، و چون [آلوده",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(1)",
      "textHash": "cf779449fa94a66a45d84285ab40a9a314c968d8541b0babd02b820402a18ea3",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 41,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p044-s0002",
      "contextId": "p044-c9",
      "start": 3678,
      "end": 3742,
      "groups": [
        "p044-textual-coordination-fa1edf9e3f"
      ],
      "sourceText": "لَا يُغْنِي مَوْلًى عَن مَّوْلًى شَيْئًا"
    },
    {
      "id": "p044-u0028",
      "text": "به شرک و کفرند] یاری نمی شوند؛",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(1) > span:nth-of-type(2)",
