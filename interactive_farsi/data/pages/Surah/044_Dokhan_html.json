  "sections": [
    {
      "id": "p044-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "و همانا پیش از آنان قوم فرعون را",
        "last": "که در آن آزمایشی آشکار بود، عطا کردیم.۳۳"
      },
      "lines": [
        "p044-l0001"
      ]
    },
    {
      "id": "p044-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "بی تردید روز جدایی [حق از باطل، مؤمن",
        "last": "پروردگار تو، [و] این همان کامیابی بزرگ است.۵۷"
      },
      "lines": [
        "p044-l0002"
      ]
    },
    {
      "id": "p044-s0003",
      "parentId": "p044-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3)",
      "excerpt": {
        "first": "همانا درخت زقّوم،۴۳خوراک گنهکار است،۴۴مانند مس گداخته شده",
