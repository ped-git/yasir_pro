      "sourceText": "الْأَرْضَ"
    },
    {
      "id": "p044-u0026",
      "text": "است، به بازی",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "309b541a4ecb98267d96014dbfc646cfed2f96c037f7d147b18e87273ab056ad",
