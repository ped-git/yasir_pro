      "sourceText": "سُندُسٍ"
    },
    {
      "id": "p044-u0032",
      "text": "می پوشند در حالی",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4) > p:nth-of-type(1) > span:nth-of-type(2)",
