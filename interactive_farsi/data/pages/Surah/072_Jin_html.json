      "start": 1002,
      "end": 1009,
      "groups": [
        "p072-textual-coordination-d8f8913043"
      ],
      "sourceText": "الْإِنسُ"
    },
    {
      "id": "p072-u0006",
      "text": "بر خدا",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(3)",
      "textHash": "056d4dda4b02a3a74d1ca9fb5c5105c783f4bf20ea7affa8485f0e7647fa568b",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 5,
      "blockIndex": 3,
