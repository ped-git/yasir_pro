      "end": 700,
      "groups": [
        "p072-local-underline-pattern-f71d1463d9"
      ],
      "sourceText": "صَاحِبَةً"
    },
    {
      "id": "p072-u0004",
      "text": "نگرفته است،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(3)",
      "textHash": "2fdd9bbeaef53cc07b1797f371c30cf454789ea75a3e501e4b89f8f041c72a95",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 3,
      "blockIndex": 2,
      "parentId": null,
