      "contextId": "p072-c2",
      "start": 714,
      "end": 726,
      "groups": [
        "p072-local-underline-pattern-f71d1463d9"
      ],
      "sourceText": "وَلَدًا"
    },
    {
      "id": "p072-u0005",
      "text": "انس و",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(2)",
      "textHash": "9577576eed46ef4eb6d9f12e1a67d5b3bf2261bced4a2e7300bcff962b2c3967",
