        "structure": "ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 14,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c9",
      "start": 2756,
      "end": 2815,
      "groups": [
        "p072-red-green-pair-3e339bcc43",
        "p072-red-green-pair-77f0837565"
      ],
      "sourceText": "مَنْ أَسْلَمَ فَأُولَـٰئِكَ تَحَرَّوْا رَشَدًا"
    },
    {
      "id": "p072-u0020",
      "text": "منحرفان هیزم دوزخ اند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(5)",
      "textHash": "b49f35635b9b4bd9b66dc3c78891839688dafa56e1fc5cecb768b3393541d4bf",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 15,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c9",
      "start": 2821,
      "end": 2843,
      "groups": [
        "p072-red-green-pair-77f0837565"
      ],
      "sourceText": "الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًا"
    },
    {
      "id": "p072-u0021",
      "text": "را می پرستم،",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(3)",
      "textHash": "0365fe4c99f566a887d58e2948e2e5cefbfff0ab7df0542dcb5e72671da94702",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 20,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c10",
      "start": 3500,
      "end": 3515,
      "groups": [
        "p072-textual-coordination-4c8de3833e"
      ],
      "sourceText": "أَدْعُو رَبِّي"
    },
    {
      "id": "p072-u0022",
      "text": "هیچ کس را شریک او قرار نمی دهم.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(4) > span:nth-of-type(4)",
      "textHash": "0910e980527d64b74e45b0bf43bfeb04ba5d4bc99f31bdae93d5dcc30950a824",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 20,
      "blockIndex": 10,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c10",
      "start": 3517,
      "end": 3549,
      "groups": [
        "p072-textual-coordination-4c8de3833e"
      ],
      "sourceText": "لَا أُشْرِكُ بِهِ أَحَدًا"
    },
    {
      "id": "p072-u0023",
      "text": "را برای",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(3)",
      "textHash": "58b270b188ac3c54130cab411f85adc1a488d74fbb2c15b9a21adefe60bca997",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c11",
      "start": 3605,
      "end": 3613,
      "groups": [
        "p072-local-underline-pattern-88a0d4d3ba"
      ],
      "sourceText": "ضَرًّا"
    },
    {
      "id": "p072-u0024",
      "text": "ندارم.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(5) > span:nth-of-type(4)",
      "textHash": "26484ad434fab6e5ae398287426d85d71878c30162aa515a3859060d7d93fad9",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 21,
      "blockIndex": 11,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c11",
      "start": 3617,
      "end": 3624,
      "groups": [
        "p072-local-underline-pattern-88a0d4d3ba"
      ],
      "sourceText": "رَشَدًا"
    },
    {
      "id": "p072-u0025",
      "text": "نافرمانی کنم] هرگز کسی در برابر [عذاب] خدا مرا",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(3)",
      "textHash": "5f801f2d975c67f6ff281aa03e64ded35e289a707325ba41cdbf1d4345c40af9",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 12,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3667,
      "end": 3714,
      "groups": [
        "p072-textual-coordination-1f90150227"
      ],
      "sourceText": "لَن يُجِيرَنِي مِنَ اللَّهِ أَحَدٌ"
    },
    {
      "id": "p072-u0026",
      "text": "پناه نمی دهد، و هرگز پناهگاهی غیر او نمی یابم.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(4)",
      "textHash": "ab53a57305e05a14b627677ad797045cc3c9467eccd4deb1eedf1a0ef70caf6b",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 22,
      "blockIndex": 12,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3715,
      "end": 3763,
      "groups": [
        "p072-textual-coordination-1f90150227"
      ],
      "sourceText": "لَنْ أَجِدَ مِن دُونِهِ مُلْتَحَدًا"
    },
    {
      "id": "p072-u0027",
      "text": "[وظیفه من] فقط رساندن [برنامه های سعادت بخش] از سوی خدا و [رساندن] پیام های اوست. و آنان که از خدا و پیامبرش نافرمانی کنند، مسلماً آتش دوزخ برای آنان است و در آن جاودانه و همیشگی اند.۲۳[اینان همواره شما را ضعیف و ناتوان و بی یار می شمارند] تا زمانی که آنچه را [از عذاب] وعده داده می شوند ببینند، پس به زودی آگاه می شوند چه کسی یاورش ناتوان تر و نفراتش کمتر است؟۲۴",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5)",
      "textHash": "bc86ce6408e980b59d52f0e16d7b11de342b8fe228b294b9b335cdef45ac25cd",
      "appearance": {
        "signature": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-color-currentcolor ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "structure": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "colorFamily": null
      },
      "verse": 23,
      "blockIndex": 12,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3772,
      "end": 4138,
      "groups": [
        "p072-u0027-individual"
      ],
      "sourceText": "إِلَّا بَلَاغًا مِّنَ اللَّهِ وَرِسَالَاتِهِ ۚ وَمَن يَعْصِ اللَّهَ وَرَسُولَهُ فَإِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا۲۳ حَتَّىٰ إِذَا رَأَوْا مَا يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ أَضْعَفُ نَاصِرًا وَأَقَلُّ عَدَدًا۲۴"
    },
    {
      "id": "p072-u0028",
      "text": "فقط رساندن [برنامه های سعادت",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "22c395213b61b25214bfa406b1cdd2076e475cac02d93ea136a960e914408e56",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3782,
      "end": 3812,
      "groups": [
        "p072-textual-coordination-3480618869"
      ],
      "sourceText": "بَلَاغًا مِّنَ اللَّهِ"
    },
    {
      "id": "p072-u0029",
      "text": "از سوی خدا و [رساندن]",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "b67058a8fdb1c58842074f6ec9e984af2d79d0a83b284d54319828afc9de45d4",
      "appearance": {
