      "end": 475,
      "groups": [
        "p072-textual-coordination-cea308e1d2"
      ],
      "sourceText": "آمَنَّا بِهِ"
    },
    {
      "id": "p072-u0002",
      "text": "هرگز احدی را شریک پروردگارمان قرار نخواهیم داد،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(1) > span:nth-of-type(3)",
      "textHash": "7ce9f7281d84c5ddaeb2596174becc4921c8c9ea878518a57af22267302ffd38",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 2,
      "blockIndex": 1,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c1",
      "start": 478,
      "end": 525,
      "groups": [
        "p072-textual-coordination-cea308e1d2"
      ],
      "sourceText": "لَن نُّشْرِكَ بِرَبِّنَا أَحَدًا"
    },
    {
      "id": "p072-u0003",
      "text": "او هرگز برای خود",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(2) > span:nth-of-type(2)",
      "textHash": "842e1e930a3098f8f6d3df768e1fae7c174951d2b994716f3b795e1d177baaba",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 3,
      "blockIndex": 2,
