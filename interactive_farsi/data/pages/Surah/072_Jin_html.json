        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3816,
      "end": 3838,
      "groups": [
        "p072-textual-coordination-3480618869"
      ],
      "sourceText": "رِسَالَاتِهِ"
    },
    {
      "id": "p072-u0030",
      "text": "و آنان که",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(3)",
      "textHash": "7048e66e9a7515ff671cbafd3d17362c54bf2a34e67174d1ba47b353d7b37510",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3853,
      "end": 3863,
      "groups": [
        "p072-textual-coordination-d910ec8e58"
      ],
      "sourceText": "اللَّهَ"
    },
    {
      "id": "p072-u0031",
      "text": "خدا و پیامبرش",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(4)",
      "textHash": "78b6f15ce6249f164149519a05983f4ccea41dc474b49627a873d0f733ad2b90",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0mm ul-pad-y-1px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 23,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 3867,
      "end": 3881,
      "groups": [
        "p072-textual-coordination-d910ec8e58"
      ],
      "sourceText": "رَسُولَهُ"
    },
    {
      "id": "p072-u0032",
      "text": "پس به زودی آگاه می شوند چه کسی",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(5)",
      "textHash": "72548811080d8f7ccdc66aa0fe7dceea1c5295307dd51c698ca668c21411183e",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 24,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 4069,
      "end": 4101,
      "groups": [
        "p072-textual-coordination-8d0fb45456"
      ],
      "sourceText": "أَضْعَفُ نَاصِرًا"
    },
    {
      "id": "p072-u0033",
      "text": "ناتوان تر و نفراتش کمتر است؟",
      "selector": "body:nth-of-type(1) > p:nth-of-type(6) > span:nth-of-type(5) > span:nth-of-type(6)",
      "textHash": "b50709bcad6bb9f8b72340003e91f51694bb2a9cb504a95f6d60d52fd95c78ae",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dotted ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 24,
      "blockIndex": 12,
      "parentId": "p072-u0027",
      "sectionId": null,
      "contextId": "p072-c12",
      "start": 4107,
      "end": 4136,
      "groups": [
        "p072-textual-coordination-8d0fb45456"
      ],
      "sourceText": "أَقَلُّ عَدَدًا"
    },
    {
      "id": "p072-u0034",
      "text": "وعده داده می شوید نزدیک است یا",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "accaead25cc04b7a0641fbb1ec5ec5740e5c582dcc57061db523bda8444eb597",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 25,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4191,
      "end": 4223,
      "groups": [
        "p072-textual-coordination-aa600d142a"
      ],
      "sourceText": "قَرِيبٌ مَّا تُوعَدُونَ"
    },
    {
      "id": "p072-u0035",
      "text": "برای آن زمانی طولانی قرار خواهد داد؟",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(4)",
      "textHash": "771749f508a315817f19e6ab35702ea568875f47e7c660f50fb967f828796db9",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 25,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4232,
      "end": 4269,
      "groups": [
        "p072-textual-coordination-aa600d142a"
      ],
      "sourceText": "يَجْعَلُ لَهُ رَبِّي أَمَدًا"
    },
    {
      "id": "p072-u0036",
      "text": "[او] دانای غیب است و هیچ کس را بر غیب خود آگاه نمی کند؛۲۶مگر پیامبرانی را که [برای آگاه شدن از غیب] برگزیده است، پس نگهبانانی [برای محافظت از آنان] از پیش رو و پشت سرشان می گمارد۲۷تا مشخص کند که پیام های پروردگارشان را [به طور کامل به مردم] رسانده اند و او به آنچه نزد آنان است احاطه دارد، و همه چیز را از جهت عدد، شماره و احصا کرده است.۲۸",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5)",
      "textHash": "8e906e4d7de1f5ccbb8a5350a2d92fcd21bb18bbb0c04f19ccd2b620530c7ef5",
      "appearance": {
        "signature": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-color-currentcolor ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "structure": "ul-border-left-1px-dotted-gray-100 ul-border-right-1px-dotted-gray-100 ul-border-top-0 ul-pad-x-0p264583mm ul-pad-y-0px ul-pattern-none ul-thickness-0",
        "colorFamily": null
      },
      "verse": 26,
      "blockIndex": 13,
      "parentId": null,
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4278,
      "end": 4619,
      "groups": [
        "p072-u0036-individual"
      ],
      "sourceText": "عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِهِ أَحَدًا۲۶ إِلَّا مَنِ ارْتَضَىٰ مِن رَّسُولٍ فَإِنَّهُ يَسْلُكُ مِن بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ رَصَدًا۲۷ لِّيَعْلَمَ أَن قَدْ أَبْلَغُوا رِسَالَاتِ رَبِّهِمْ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَىٰ كُلَّ شَيْءٍ عَدَدًا۲۸"
    },
    {
      "id": "p072-u0037",
      "text": "[برای محافظت از آنان]",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5) > span:nth-of-type(1)",
      "textHash": "a72e05f8fa7a67a581256b4988b330df46a2e3d2a998aad9c127be87c289ca1b",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 27,
      "blockIndex": 13,
      "parentId": "p072-u0036",
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4404,
      "end": 4427,
      "groups": [
        "p072-textual-coordination-f38deb3c9b"
      ],
      "sourceText": "مِن بَيْنِ يَدَيْهِ"
    },
    {
      "id": "p072-u0038",
      "text": "پیش رو و پشت سرشان",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5) > span:nth-of-type(2)",
      "textHash": "b74dd74bcc48e078c4b8ca593d4c48affe1f11572305e21301800d61fc7934b5",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 27,
      "blockIndex": 13,
      "parentId": "p072-u0036",
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4430,
      "end": 4448,
      "groups": [
        "p072-textual-coordination-f38deb3c9b"
      ],
      "sourceText": "مِنْ خَلْفِهِ"
    },
    {
      "id": "p072-u0039",
      "text": "مشخص کند که پیام های پروردگارشان را [به طور کامل به مردم] رسانده اند و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5) > span:nth-of-type(3)",
      "textHash": "876010b7fcdefb3080ae6421b03ba2d133a79daf0285e5b0c9a6185144bea645",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 13,
      "parentId": "p072-u0036",
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4463,
      "end": 4534,
      "groups": [
        "p072-textual-coordination-ff55452f72"
      ],
      "sourceText": "يَعْلَمَ أَن قَدْ أَبْلَغُوا رِسَالَاتِ رَبِّهِمْ"
    },
    {
      "id": "p072-u0040",
      "text": "به آنچه نزد آنان است احاطه دارد، و",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5) > span:nth-of-type(4)",
      "textHash": "672774603c36ff16f9775f3430188f3b6fbe2c73f7c078c11895f67c24bcee30",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 13,
      "parentId": "p072-u0036",
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4537,
      "end": 4572,
      "groups": [
        "p072-textual-coordination-ff55452f72"
      ],
      "sourceText": "أَحَاطَ بِمَا لَدَيْهِمْ"
    },
    {
      "id": "p072-u0041",
      "text": "چیز را از جهت عدد، شماره و احصا کرده است.",
      "selector": "body:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(5) > span:nth-of-type(5)",
      "textHash": "c87860b970630aa4f49f7e65e54b000b8fd00550bac7c4cd137efbb9b982902a",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 28,
      "blockIndex": 13,
      "parentId": "p072-u0036",
      "sectionId": null,
      "contextId": "p072-c13",
      "start": 4576,
      "end": 4617,
      "groups": [
        "p072-textual-coordination-ff55452f72"
      ],
      "sourceText": "أَحْصَىٰ كُلَّ شَيْءٍ عَدَدًا"
    }
