      "start": 1011,
      "end": 1018,
      "groups": [
        "p072-textual-coordination-d8f8913043"
      ],
      "sourceText": "الْجِنُّ"
    },
    {
      "id": "p072-u0007",
      "text": "نیرومند و تیرهای",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(2)",
      "textHash": "88d991e4fe53f5ea982a045c07ea605dc049e6f68f59e20f2fdfaf0742c9c345",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 8,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c4",
      "start": 1523,
      "end": 1541,
      "groups": [
        "p072-textual-coordination-6d036b9ae8"
      ],
      "sourceText": "حَرَسًا شَدِيدًا"
    },
    {
      "id": "p072-u0008",
      "text": "یافتیم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(7) > span:nth-of-type(3)",
      "textHash": "111002c473d06216a93dcda27ae1aa65860c257656552372668a8d807dc195bc",
      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 8,
      "blockIndex": 4,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c4",
      "start": 1545,
      "end": 1553,
      "groups": [
        "p072-textual-coordination-6d036b9ae8"
      ],
      "sourceText": "شُهُبًا"
    },
    {
      "id": "p072-u0009",
      "text": "کسانی که در زمین هستند گزند و شری خواسته",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(9) > span:nth-of-type(2)",
      "textHash": "df15e060d2f89c638ab82bf790838b8b7602a3db4cfb6f5426a888ce98753043",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 10,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c5",
      "start": 1894,
      "end": 1935,
      "groups": [
        "p072-textual-coordination-f1a40c3da4"
      ],
      "sourceText": "شَرٌّ أُرِيدَ بِمَن فِي الْأَرْضِ"
    },
    {
      "id": "p072-u0010",
      "text": "یا پروردگارشان برای آنان هدایت خواسته است؟",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(9) > span:nth-of-type(3)",
      "textHash": "51225f709f39791a8f2884271ad6c880e6cd9d327f2c8b3e64ef619fb35d13e1",
      "appearance": {
        "signature": "ul-color-gray-100 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 10,
      "blockIndex": 5,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c5",
      "start": 1940,
      "end": 1982,
      "groups": [
        "p072-textual-coordination-f1a40c3da4"
      ],
      "sourceText": "أَرَادَ بِهِمْ رَبُّهُمْ رَشَدًا"
    },
    {
      "id": "p072-u0011",
      "text": "ما برخی شایسته وبرخی غیر",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(10) > span:nth-of-type(2)",
      "textHash": "d49bd2bfdb5b307a033534abeffe74d307857124aded45a3447ad33f4939fe28",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 11,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c6",
      "start": 2067,
      "end": 2091,
      "groups": [
        "p072-red-green-pair-b4e92d512d"
      ],
      "sourceText": "مِنَّا الصَّالِحُونَ"
    },
    {
      "id": "p072-u0012",
      "text": "شایسته اند، [و] ما بر",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(10) > span:nth-of-type(3)",
      "textHash": "69c74bfd98122eb187aa266c5169ed594096da4d7c8860e6163f18de90128dc4",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 11,
      "blockIndex": 6,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c6",
      "start": 2092,
      "end": 2114,
      "groups": [
        "p072-red-green-pair-b4e92d512d"
      ],
      "sourceText": "مِنَّا دُونَ ذَٰلِكَ"
    },
    {
      "id": "p072-u0013",
      "text": "توانیم خدا را در زمین عاجز و درمانده کنیم و هرگز نمی توانیم [با",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(11) > span:nth-of-type(2)",
      "textHash": "a627477bd39ea813db977cbb865f0393bb398cacfc8cc33421d8510eef645c3b",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 12,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c7",
      "start": 2253,
      "end": 2317,
      "groups": [
        "p072-textual-coordination-224d59f5e4"
      ],
      "sourceText": "لَّن نُّعْجِزَ اللَّهَ فِي الْأَرْضِ"
    },
    {
      "id": "p072-u0014",
      "text": "گریختن و فرار] از دسترس قدرت او بیرون رویم،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(11) > span:nth-of-type(3)",
      "textHash": "819a618e7e53a48eef07b795f4228bfd5784fad574c8dacd93b94e616a2c561f",
      "appearance": {
        "signature": "ul-color-gray-180 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 12,
      "blockIndex": 7,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c7",
      "start": 2318,
      "end": 2361,
      "groups": [
        "p072-textual-coordination-224d59f5e4"
      ],
      "sourceText": "لَن نُّعْجِزَهُ هَرَبًا"
    },
    {
      "id": "p072-u0015",
      "text": "سختی و مشقت",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(12) > span:nth-of-type(2)",
      "textHash": "43c0ea89c2d43dbf58a81fed11cff998e2b4b22743e327f58f8411c8497ee39d",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 13,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c8",
      "start": 2576,
      "end": 2588,
      "groups": [
        "p072-local-underline-pattern-e7e3833a07"
      ],
      "sourceText": "بَخْسًا"
    },
    {
      "id": "p072-u0016",
      "text": "را احاطه کند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(12) > span:nth-of-type(3)",
      "textHash": "2d6099d3e1db92f39a0bc10e04c0cb1ad51a2c5880d67e2012b4693a84a6ea87",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 13,
      "blockIndex": 8,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c8",
      "start": 2597,
      "end": 2610,
      "groups": [
        "p072-local-underline-pattern-e7e3833a07"
      ],
      "sourceText": "رَهَقًا"
    },
    {
      "id": "p072-u0017",
      "text": "از ما تسلیم [فرمان ها و",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(2)",
      "textHash": "7c70cf30fc0fde2db5cb9c2728f26a09693f3eaeb65023d7ef5d5b2550717e49",
      "appearance": {
        "signature": "ul-color-green-100-180-100 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "green"
      },
      "verse": 14,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c9",
      "start": 2698,
      "end": 2723,
      "groups": [
        "p072-paired-contrast-6f828358bd",
        "p072-red-green-pair-3e339bcc43",
        "p072-red-green-pair-77f0837565"
      ],
      "sourceText": "مِنَّا الْمُسْلِمُونَ"
    },
    {
      "id": "p072-u0018",
      "text": "خدایند، و برخی منحرف",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(3)",
      "textHash": "acca592c2a6dd438098ee4b05049646df171fedd43f5b2a1a4a1cb50440c6614",
      "appearance": {
        "signature": "ul-color-red-220-150-150 ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "red"
      },
      "verse": 14,
      "blockIndex": 9,
      "parentId": null,
      "sectionId": "p072-s0001",
      "contextId": "p072-c9",
      "start": 2729,
      "end": 2751,
      "groups": [
        "p072-paired-contrast-6f828358bd",
        "p072-red-green-pair-3e339bcc43",
        "p072-red-green-pair-77f0837565"
      ],
      "sourceText": "مِنَّا الْقَاسِطُونَ"
    },
    {
      "id": "p072-u0019",
      "text": "پس کسانی که تسلیم شدند در صدد یافتن حقیقت و راه مستقیم اند،",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(13) > span:nth-of-type(4)",
      "textHash": "351ecb0b4ccad1ef6c3193518378b11cf527ba126e5ff0c7cea2a72cfbaba933",
      "appearance": {
