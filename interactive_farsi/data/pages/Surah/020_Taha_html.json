    },
    {
      "id": "p020-u0020",
      "text": "پایه آن در پاداش دادن و کیفر",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(4) > p:nth-of-type(4) > span:nth-of-type(3)",
