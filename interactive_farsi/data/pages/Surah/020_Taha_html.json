      "appearance": {
        "signature": "ul-color-gray-220 ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-solid ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 10,
      "blockIndex": 2,
      "parentId": null,
      "sectionId": "p020-s0002",
      "contextId": "p020-c2",
      "start": 949,
      "end": 985,
      "groups": [
        "p020-textual-coordination-faace2a275"
      ],
      "sourceText": "أَجِدُ عَلَى النَّارِ هُدًى"
    },
    {
      "id": "p020-u0011",
      "text": "بر آن تکیه می زنم، و با آن",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(5) > span:nth-of-type(3)",
