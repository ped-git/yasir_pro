      "end": 5370,
      "groups": [
        "p020-local-underline-pattern-acbb86ce09"
      ],
      "sourceText": "لَّا يَضِلُّ"
    },
    {
      "id": "p020-u0021",
      "text": "کند و نه از یاد می برد.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(4) > p:nth-of-type(4) > span:nth-of-type(4)",
