      "contextId": "p020-c3",
      "start": 1717,
      "end": 1751,
      "groups": [
        "p020-textual-coordination-8bf6b1b197"
      ],
      "sourceText": "أَهُشُّ بِهَا عَلَىٰ غَنَمِي"
    },
    {
      "id": "p020-u0013",
      "text": "و مرا در آن نیازهای دیگری هم هست.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(5) > span:nth-of-type(5)",
      "textHash": "ab4279d05be6cb5ac595f4e7e71f3813ab15ee5255c57ce19ee6b61e7a650cb6",
      "appearance": {
        "signature": "ul-color-gray-200 ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "structure": "ul-pad-x-0px ul-pad-y-0px ul-pattern-dashed ul-sides-open ul-thickness-1px",
        "colorFamily": "gray"
      },
      "verse": 18,
      "blockIndex": 3,
      "parentId": null,
      "sectionId": "p020-s0002",
      "contextId": "p020-c3",
      "start": 1755,
      "end": 1789,
      "groups": [
        "p020-textual-coordination-8bf6b1b197"
      ],
      "sourceText": "لِيَ فِيهَا مَآرِبُ أُخْرَىٰ"
    },
    {
      "id": "p020-u0014",
      "text": "حق] با سخت گیری و شکنجه بر [ضد] ما پیشی",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(11) > span:nth-of-type(4)",
