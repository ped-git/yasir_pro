      "start": 584,
      "end": 597,
      "groups": [
        "p020-textual-coordination-78b8018bd4"
      ],
      "sourceText": "أَخْفَى"
    },
    {
      "id": "p020-u0009",
      "text": "از آن را برایتان بیاورم یا نزد",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(2) > span:nth-of-type(3)",
