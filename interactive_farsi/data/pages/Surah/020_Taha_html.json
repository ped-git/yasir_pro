    },
    {
      "id": "p020-u0012",
      "text": "درختان را برای گوسفندانم فرو می",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(5) > span:nth-of-type(4)",
      "textHash": "c665a2ba3b25414c04ea7a90d45406c442ff809dc2217f4d42624b3cf9598a2f",
