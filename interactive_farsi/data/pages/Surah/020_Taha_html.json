    },
    {
      "id": "p020-u0010",
      "text": "[برای پیدا کردن راه] راهنمایی بیابم.",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > p:nth-of-type(2) > span:nth-of-type(4)",
