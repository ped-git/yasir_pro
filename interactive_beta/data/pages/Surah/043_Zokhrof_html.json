  "sections": [
    {
      "id": "p043-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "o بَلْ قَالُوا إِنَّا وَجَدْنَا آبَاءَنَا عَلَىٰ أُمَّةٍ",
        "last": "الْحَقُّ o قَالُوا هَـٰذَا سِحْرٌ وَإِنَّا بِهِ كَافِرُونَ۳۰"
      },
      "lines": [
        "p043-l0001"
      ]
    },
    {
      "id": "p043-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "o وَقَالُوا لَوْلَا نُزِّلَ هَـٰذَا الْقُرْآنُ عَلَىٰ رَجُلٍ",
        "last": "مَتَاعُ الْحَيَاةِ الدُّنْيَا ۚ وَالْآخِرَةُ عِندَ رَبِّكَ لِلْمُتَّقِينَ۳۵"
      },
      "lines": [
        "p043-l0002"
      ]
    },
    {
      "id": "p043-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَمَن يَعْشُ عَن ذِكْرِ الرَّحْمَـٰنِ نُقَيِّضْ لَهُ شَيْطَانًا",
        "last": "يَنفَعَكُمُ الْيَوْمَ إِذ ظَّلَمْتُمْ أَنَّكُمْ فِي الْعَذَابِ مُشْتَرِكُونَ۳۹"
      },
      "lines": [
        "p043-l0003"
      ]
    },
    {
      "id": "p043-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "أَفَأَنتَ تُسْمِعُ الصُّمَّ أَوْ تَهْدِي الْعُمْيَ وَمَن كَانَ",
        "last": "مِن رُّسُلِنَا أَجَعَلْنَا مِن دُونِ الرَّحْمَـٰنِ آلِهَةً يُعْبَدُونَ۴۵"
      },
      "lines": [
        "p043-l0004"
      ]
    },
    {
      "id": "p043-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(6)",
      "excerpt": {
        "first": "وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِآيَاتِنَا إِلَىٰ فِرْعَوْنَ وَمَلَئِهِ p",
        "last": "انتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ۵۵ فَجَعَلْنَاهُمْ سَلَفًا وَمَثَلًا لِّلْآخِرِينَ۵۶"
      },
      "lines": [
        "p043-l0005"
      ]
    },
    {
      "id": "p043-s0006",
      "parentId": null,
