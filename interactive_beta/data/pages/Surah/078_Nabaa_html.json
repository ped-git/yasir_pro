      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "إِنَّ لِلْمُتَّقِينَ مَفَازًا۳۱ حَدَائِقَ وَأَعْنَابًا۳۲ وَكَوَاعِبَ أَتْرَابًا۳۳ وَكَأْسًا",
        "last": "لَغْوًا وَلَا كِذَّابًا۳۵ جَزَاءً مِّن رَّبِّكَ عَطَاءً حِسَابًا۳۶"
      },
      "lines": [
