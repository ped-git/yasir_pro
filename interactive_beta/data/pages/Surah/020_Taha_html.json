  "sections": [
    {
      "id": "p020-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(1)",
      "excerpt": {
        "first": "وَهَلْ أَتَاكَ حَدِيثُ مُوسَىٰ۹ إِذْ رَأَىٰ نَارًا n",
        "last": "إِلَـٰهَ إِلَّا هُوَ ۚ وَسِعَ كُلَّ شَيْءٍ عِلْمًا۹۸"
      },
      "lines": [
        "p020-l0001"
      ]
    },
    {
      "id": "p020-s0002",
      "parentId": "p020-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "إِذْ رَأَىٰ نَارًا n فَقَالَ لِأَهْلِهِ امْكُثُوا إِنِّي",
        "last": "أُوحِيَ إِلَيْنَا أَنَّ الْعَذَابَ عَلَىٰ مَن كَذَّبَ وَتَوَلَّىٰ۴۸"
      },
      "lines": [
        "p020-l0002"
      ]
    },
    {
      "id": "p020-s0003",
      "parentId": "p020-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "o قَالَ فَمَن رَّبُّكُمَا يَا مُوسَىٰ۴۹ n قَالَ",
        "last": "الْيَمِّ مَا غَشِيَهُمْ۷۸ وَأَضَلَّ فِرْعَوْنُ قَوْمَهُ وَمَا هَدَىٰ۷۹"
      },
      "lines": [
        "p020-l0003"
      ]
    },
    {
      "id": "p020-s0004",
      "parentId": "p020-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "f يَا بَنِي إِسْرَائِيلَ قَدْ أَنجَيْنَاكُم مِّنْ عَدُوِّكُمْ",
        "last": "إِلَـٰهَ إِلَّا هُوَ ۚ وَسِعَ كُلَّ شَيْءٍ عِلْمًا۹۸"
      },
      "lines": [
        "p020-l0004"
      ]
    },
    {
      "id": "p020-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَلَقَدْ عَهِدْنَا إِلَىٰ آدَمَ مِن قَبْلُ فَنَسِيَ وَلَمْ",
        "last": "يُؤْمِن بِآيَاتِ رَبِّهِ ۚ وَلَعَذَابُ الْآخِرَةِ أَشَدُّ وَأَبْقَىٰ۱۲۷"
      },
      "lines": [
        "p020-l0005"
      ]
    }
  ]
