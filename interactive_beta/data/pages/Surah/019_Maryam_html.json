      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَاذْكُرْ فِي الْكِتَابِ مَرْيَمَ إِذِ انتَبَذَتْ مِنْ أَهْلِهَا",
        "last": "اللَّهَ رَبِّي وَرَبُّكُمْ فَاعْبُدُوهُ ۚ هَـٰذَا صِرَاطٌ مُّسْتَقِيمٌ۳۶"
      },
      "lines": [
        "p019-l0004"
      ]
    },
    {
      "id": "p019-s0005",
      "parentId": "p019-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(5)",
      "excerpt": {
        "first": "وَاذْكُرْ فِي الْكِتَابِ إِبْرَاهِيمَ ۚ إِنَّهُ كَانَ صِدِّيقًا",
        "last": "لَهُم مِّن رَّحْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِيًّا۵۰"
      },
      "lines": [
        "p019-l0005"
      ]
    },
    {
