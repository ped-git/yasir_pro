      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَاذْكُرْ فِي الْكِتَابِ مَرْيَمَ إِذِ انتَبَذَتْ مِنْ أَهْلِهَا",
        "last": "إِنَّا نَحْنُ نَرِثُ الْأَرْضَ وَمَنْ عَلَيْهَا وَإِلَيْنَا يُرْجَعُونَ۴۰"
      },
      "lines": [
        "p019-l0003"
