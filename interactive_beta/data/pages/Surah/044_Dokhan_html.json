  "sections": [
    {
      "id": "p044-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَاءَهُمْ رَسُولٌ كَرِيمٌ۱۷",
        "last": "الْعَالَمِينَ۳۲ وَآتَيْنَاهُم مِّنَ الْآيَاتِ مَا فِيهِ بَلَاءٌ مُّبِينٌ۳۳"
      },
      "lines": [
        "p044-l0001"
      ]
    },
    {
      "id": "p044-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ۴۰ يَوْمَ لَا يُغْنِي",
        "last": "فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ۵۷"
      },
      "lines": [
        "p044-l0002"
      ]
    },
    {
      "id": "p044-s0003",
      "parentId": "p044-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3)",
      "excerpt": {
        "first": "إِنَّ شَجَرَتَ الزَّقُّومِ۴۳ طَعَامُ الْأَثِيمِ۴۴ كَالْمُهْلِ يَغْلِي فِي",
        "last": "الْعَزِيزُ الْكَرِيمُ۴۹ إِنَّ هَـٰذَا مَا كُنتُم بِهِ تَمْتَرُونَ۵۰"
      },
      "lines": [
        "p044-l0003"
      ]
    },
    {
      "id": "p044-s0004",
      "parentId": "p044-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4)",
      "excerpt": {
        "first": "إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ۵۱ فِي جَنَّاتٍ وَعُيُونٍ۵۲",
        "last": "فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ۵۷"
      },
      "lines": [
        "p044-l0004"
      ]
    }
  ]
