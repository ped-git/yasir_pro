  "sections": [
    {
      "id": "p037-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "بَلْ عَجِبْتَ وَيَسْخَرُونَ۱۲ وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ۱۳ وَإِذَا",
        "last": "الْعَذَابِ الْأَلِيمِ۳۸ وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ۳۹"
      },
      "lines": [
        "p037-l0001"
      ]
    },
    {
      "id": "p037-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ۴۰ أُولَـٰئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ۴۱",
        "last": "هَـٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ۶۰ لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ الْعَامِلُونَ۶۱"
      },
      "lines": [
        "p037-l0002"
      ]
    },
    {
      "id": "p037-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ الزَّقُّومِ۶۲ إِنَّا جَعَلْنَاهَا",
        "last": "كَيْفَ كَانَ عَاقِبَةُ الْمُنذَرِينَ۷۳ إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ۷۴"
      },
      "lines": [
        "p037-l0003"
      ]
    },
    {
      "id": "p037-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ۷۵ وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ",
        "last": "مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ۱۴۷ فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَىٰ حِينٍ۱۴۸"
      },
      "lines": [
        "p037-l0004"
      ]
    },
    {
      "id": "p037-s0005",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ۷۵ وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ",
        "last": "الْمُحْسِنِينَ۸۰ إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ۸۱ ثُمَّ أَغْرَقْنَا الْآخَرِينَ۸۲"
      },
      "lines": [
        "p037-l0005"
      ]
    },
    {
      "id": "p037-s0006",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَإِنَّ مِن شِيعَتِهِ لَإِبْرَاهِيمَ۸۳ إِذْ جَاءَ رَبَّهُ بِقَلْبٍ",
        "last": "إِسْحَاقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِ مُبِينٌ۱۱۳"
      },
      "lines": [
        "p037-l0006"
      ]
    },
    {
      "id": "p037-s0007",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(5)",
      "excerpt": {
        "first": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَارُونَ۱۱۴ وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ",
        "last": "إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ۱۲۱ إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ۱۲۲"
      },
      "lines": [
        "p037-l0007"
      ]
    },
    {
      "id": "p037-s0008",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(6)",
      "excerpt": {
        "first": "وَإِنَّ إِلْيَاسَ لَمِنَ الْمُرْسَلِينَ۱۲۳ t إِذْ قَالَ لِقَوْمِهِ",
        "last": "إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ۱۳۱ إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ۱۳۲"
      },
      "lines": [
        "p037-l0008"
      ]
    },
    {
      "id": "p037-s0009",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(7)",
      "excerpt": {
        "first": "وَإِنَّ لُوطًا لَّمِنَ الْمُرْسَلِينَ۱۳۳ إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ۱۳۴",
        "last": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ۱۳۷ وَبِاللَّيْلِ ۗ أَفَلَا تَعْقِلُونَ۱۳۸"
      },
      "lines": [
        "p037-l0009"
      ]
    },
    {
      "id": "p037-s0010",
      "parentId": "p037-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(8)",
      "excerpt": {
        "first": "وَإِنَّ يُونُسَ لَمِنَ الْمُرْسَلِينَ۱۳۹ إِذْ أَبَقَ إِلَى الْفُلْكِ",
        "last": "مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ۱۴۷ فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَىٰ حِينٍ۱۴۸"
      },
      "lines": [
