  "sections": [
    {
      "id": "p017-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَآتَيْنَا مُوسَى الْكِتَابَ وَجَعَلْنَاهُ هُدًى لِّبَنِي إِسْرَائِيلَ أَلَّا",
        "last": "الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا۱۰"
      },
      "lines": [
        "p017-l0001"
      ]
    },
    {
      "id": "p017-s0002",
      "parentId": "p017-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَآتَيْنَا مُوسَى الْكِتَابَ وَجَعَلْنَاهُ هُدًى لِّبَنِي إِسْرَائِيلَ أَلَّا",
        "last": "وَإِنْ عُدتُّمْ عُدْنَا ۘ وَجَعَلْنَا جَهَنَّمَ لِلْكَافِرِينَ حَصِيرًا۸"
      },
      "lines": [
        "p017-l0002"
      ]
    },
    {
      "id": "p017-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَيَدْعُ الْإِنسَانُ بِالشَّرِّ دُعَاءَهُ بِالْخَيْرِ ۖ وَكَانَ الْإِنسَانُ",
        "last": "عَلَىٰ بَعْضٍ ۚ وَلَلْآخِرَةُ أَكْبَرُ دَرَجَاتٍ وَأَكْبَرُ تَفْضِيلًا۲۱"
      },
      "lines": [
        "p017-l0003"
      ]
    },
    {
      "id": "p017-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "— لَّا تَجْعَلْ مَعَ اللَّهِ إِلَـٰهًا آخَرَ فَتَقْعُدَ",
        "last": "اللَّهِ إِلَـٰهًا آخَرَ فَتُلْقَىٰ فِي جَهَنَّمَ مَلُومًا مَّدْحُورًا۳۹"
      },
      "lines": [
        "p017-l0004"
      ]
    },
    {
      "id": "p017-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "q وَقَالُوا أَإِذَا كُنَّا عِظَامًا وَرُفَاتًا أَإِنَّا لَمَبْعُوثُونَ",
        "last": "يَدْعُوكُمْ فَتَسْتَجِيبُونَ بِحَمْدِهِ وَتَظُنُّونَ إِن لَّبِثْتُمْ إِلَّا قَلِيلًا۵۲"
      },
      "lines": [
        "p017-l0005"
      ]
    },
    {
      "id": "p017-s0006",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(7)",
      "excerpt": {
        "first": "وَإِن كَادُوا لَيَفْتِنُونَكَ عَنِ الَّذِي أَوْحَيْنَا إِلَيْكَ لِتَفْتَرِيَ",
        "last": "الْحَقُّ وَزَهَقَ الْبَاطِلُ ۚ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا۸۱"
      },
      "lines": [
        "p017-l0006"
      ]
    },
    {
      "id": "p017-s0007",
      "parentId": "p017-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(7) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَإِن كَادُوا لَيَفْتِنُونَكَ عَنِ الَّذِي أَوْحَيْنَا إِلَيْكَ لِتَفْتَرِيَ",
        "last": "قَبْلَكَ مِن رُّسُلِنَا ۖ وَلَا تَجِدُ لِسُنَّتِنَا تَحْوِيلًا۷۷"
      },
      "lines": [
        "p017-l0007"
      ]
    },
    {
      "id": "p017-s0008",
      "parentId": "p017-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(7) > div:nth-of-type(4)",
      "excerpt": {
        "first": "أَقِمِ الصَّلَاةَ لِدُلُوكِ الشَّمْسِ إِلَىٰ غَسَقِ اللَّيْلِ وَقُرْآنَ",
        "last": "الْحَقُّ وَزَهَقَ الْبَاطِلُ ۚ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا۸۱"
      },
      "lines": [
        "p017-l0008"
      ]
    },
    {
      "id": "p017-s0009",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(8)",
      "excerpt": {
        "first": "وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِّلْمُؤْمِنِينَ",
        "last": "عَلَىٰ شَاكِلَتِهِ فَرَبُّكُمْ أَعْلَمُ بِمَنْ هُوَ أَهْدَىٰ سَبِيلًا۸۴"
      },
      "lines": [
        "p017-l0009"
      ]
    },
    {
      "id": "p017-s0010",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(9)",
      "excerpt": {
        "first": "وَيَسْأَلُونَكَ عَنِ الرُّوحِ ۖ t قُلِ الرُّوحُ مِنْ",
        "last": "مِن كُلِّ مَثَلٍ فَأَبَىٰ أَكْثَرُ النَّاسِ إِلَّا كُفُورًا۸۹"
      },
      "lines": [
        "p017-l0010"
      ]
    },
    {
      "id": "p017-s0011",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(10)",
      "excerpt": {
        "first": "q وَقَالُوا لَن نُّؤْمِنَ لَكَ حَتَّىٰ - تَفْجُرَ",
        "last": "أَجَلًا لَّا رَيْبَ فِيهِ فَأَبَى الظَّالِمُونَ إِلَّا كُفُورًا۹۹"
      },
      "lines": [
        "p017-l0011"
      ]
    },
    {
      "id": "p017-s0012",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(11)",
      "excerpt": {
        "first": "وَلَقَدْ آتَيْنَا مُوسَىٰ تِسْعَ آيَاتٍ بَيِّنَاتٍ ۖ فَاسْأَلْ",
        "last": "الْأَرْضَ فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ جِئْنَا بِكُمْ لَفِيفًا۱۰۴"
      },
      "lines": [
        "p017-l0012"
      ]
    },
    {
      "id": "p017-s0013",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(12)",
      "excerpt": {
        "first": "وَبِالْحَقِّ أَنزَلْنَاهُ وَبِالْحَقِّ نَزَلَ ۗ وَمَا أَرْسَلْنَاكَ إِلَّا",
        "last": "رَبِّنَا لَمَفْعُولًا۱۰۸ وَيَخِرُّونَ لِلْأَذْقَانِ يَبْكُونَ وَيَزِيدُهُمْ خُشُوعًا ۩۱۰۹"
      },
      "lines": [
        "p017-l0013"
      ]
    }
  ]
}
