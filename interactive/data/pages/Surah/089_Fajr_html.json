      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "كَلَّا إِذَا دُكَّتِ الْأَرْضُ دَكًّا دَكًّا۲۱ وَجَاءَ رَبُّكَ",
        "last": "رَبِّكِ رَاضِيَةً مَّرْضِيَّةً۲۸ فَادْخُلِي فِي عِبَادِي۲۹ وَادْخُلِي جَنَّتِي۳۰"
      },
