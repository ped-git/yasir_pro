  "sections": [
    {
      "id": "p015-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "الر ۚ تِلْكَ آيَاتُ الْكِتَابِ وَقُرْآنٍ مُّبِينٍ۱ رُّبَمَا",
        "last": "لَقَالُوا إِنَّمَا سُكِّرَتْ أَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ۱۵"
      },
      "lines": [
        "p015-l0001"
      ]
    },
    {
      "id": "p015-s0002",
      "parentId": "p015-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3)",
      "excerpt": {
        "first": "الر ۚ تِلْكَ آيَاتُ الْكِتَابِ وَقُرْآنٍ مُّبِينٍ۱ رُّبَمَا",
        "last": "مُّنظَرِينَ۸ إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ۹"
      },
      "lines": [
        "p015-l0002"
      ]
    },
    {
      "id": "p015-s0003",
      "parentId": "p015-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِي شِيَعِ الْأَوَّلِينَ۱۰ وَمَا",
        "last": "لَقَالُوا إِنَّمَا سُكِّرَتْ أَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ۱۵"
      },
      "lines": [
        "p015-l0003"
      ]
    },
    {
      "id": "p015-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "— وَلَقَدْ جَعَلْنَا فِي السَّمَاءِ بُرُوجًا وَزَيَّنَّاهَا لِلنَّاظِرِينَ۱۶",
        "last": "وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ ۚ إِنَّهُ حَكِيمٌ عَلِيمٌ۲۵"
      },
      "lines": [
        "p015-l0004"
      ]
    },
    {
      "id": "p015-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَلَقَدْ خَلَقْنَا الْإِنسَانَ مِن صَلْصَالٍ مِّنْ حَمَإٍ مَّسْنُونٍ۲۶",
        "last": "لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ۴۸"
      },
      "lines": [
        "p015-l0005"
      ]
    },
    {
      "id": "p015-s0006",
      "parentId": "p015-s0005",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(3)",
      "excerpt": {
        "first": "l وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا",
        "last": "لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ۴۸"
      },
      "lines": [
        "p015-l0006"
      ]
    },
    {
      "id": "p015-s0007",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَاهِيمَ۵۱ إِذْ دَخَلُوا عَلَيْهِ v",
        "last": "فَاصْفَحِ الصَّفْحَ الْجَمِيلَ۸۵ إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ۸۶"
      },
      "lines": [
        "p015-l0007"
      ]
    },
    {
      "id": "p015-s0008",
      "parentId": "p015-s0007",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَاهِيمَ۵۱ إِذْ دَخَلُوا عَلَيْهِ v",
        "last": "وَإِنَّهَا لَبِسَبِيلٍ مُّقِيمٍ۷۶ إِنَّ فِي ذَٰلِكَ لَآيَةً لِّلْمُؤْمِنِينَ۷۷"
      },
      "lines": [
        "p015-l0008"
      ]
    },
    {
      "id": "p015-s0009",
      "parentId": "p015-s0007",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَإِن كَانَ أَصْحَابُ الْأَيْكَةِ لَظَالِمِينَ۷۸",
        "last": "فَانتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ۷۹"
      },
      "lines": [
        "p015-l0009"
      ]
    },
    {
      "id": "p015-s0010",
      "parentId": "p015-s0007",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(5)",
      "excerpt": {
        "first": "وَلَقَدْ كَذَّبَ أَصْحَابُ الْحِجْرِ الْمُرْسَلِينَ۸۰ وَآتَيْنَاهُمْ آيَاتِنَا فَكَانُوا",
        "last": "الصَّيْحَةُ مُصْبِحِينَ۸۳ فَمَا أَغْنَىٰ عَنْهُم مَّا كَانُوا يَكْسِبُونَ۸۴"
      },
      "lines": [
        "p015-l0010"
      ]
    },
    {
      "id": "p015-s0011",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(6)",
      "excerpt": {
        "first": "وَلَقَدْ آتَيْنَاكَ سَبْعًا مِّنَ الْمَثَانِي وَالْقُرْآنَ الْعَظِيمَ۸۷ –",
        "last": "وَكُن مِّنَ السَّاجِدِينَ۹۸ وَاعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ الْيَقِينُ۹۹"
      },
      "lines": [
        "p015-l0011"
      ]
    }
  ]
