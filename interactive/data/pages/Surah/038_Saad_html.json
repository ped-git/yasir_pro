  "sections": [
    {
      "id": "p038-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "اصْبِرْ عَلَىٰ مَا يَقُولُونَ — وَاذْكُرْ عَبْدَنَا دَاوُودَ",
        "last": "اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ بِمَا نَسُوا يَوْمَ الْحِسَابِ۲۶"
      },
      "lines": [
        "p038-l0001"
      ]
    },
    {
      "id": "p038-s0002",
      "parentId": "p038-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3)",
      "excerpt": {
        "first": "— وَاذْكُرْ عَبْدَنَا دَاوُودَ ذَا الْأَيْدِ ۖ إِنَّهُ",
        "last": "اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ بِمَا نَسُوا يَوْمَ الْحِسَابِ۲۶"
      },
      "lines": [
        "p038-l0002"
      ]
    },
    {
      "id": "p038-s0003",
      "parentId": "p038-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(3)",
      "excerpt": {
        "first": "— وَاذْكُرْ عَبْدَنَا دَاوُودَ ذَا الْأَيْدِ ۖ إِنَّهُ",
        "last": "اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ بِمَا نَسُوا يَوْمَ الْحِسَابِ۲۶"
      },
      "lines": [
        "p038-l0003"
      ]
    },
    {
      "id": "p038-s0004",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا بَاطِلًا ۚ",
        "last": "أَنزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِّيَدَّبَّرُوا آيَاتِهِ وَلِيَتَذَكَّرَ أُولُو الْأَلْبَابِ۲۹"
      },
      "lines": [
        "p038-l0004"
      ]
    },
    {
      "id": "p038-s0005",
      "parentId": "p038-s0004",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا بَاطِلًا ۚ",
        "last": "أَنزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِّيَدَّبَّرُوا آيَاتِهِ وَلِيَتَذَكَّرَ أُولُو الْأَلْبَابِ۲۹"
      },
      "lines": [
        "p038-l0005"
      ]
    },
    {
      "id": "p038-s0006",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَوَهَبْنَا لِدَاوُودَ سُلَيْمَانَ ۚ نِعْمَ الْعَبْدُ ۖ إِنَّهُ",
        "last": "إِسْمَاعِيلَ وَالْيَسَعَ وَذَا الْكِفْلِ ۖ وَكُلٌّ مِّنَ الْأَخْيَارِ۴۸"
      },
      "lines": [
        "p038-l0006"
      ]
    },
    {
      "id": "p038-s0007",
      "parentId": "p038-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَوَهَبْنَا لِدَاوُودَ سُلَيْمَانَ ۚ نِعْمَ الْعَبْدُ ۖ إِنَّهُ",
        "last": "بِغَيْرِ حِسَابٍ۳۹ وَإِنَّ لَهُ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَآبٍ۴۰"
      },
      "lines": [
        "p038-l0007"
      ]
    },
    {
      "id": "p038-s0008",
      "parentId": "p038-s0007",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(2) > div:nth-of-type(2)",
      "excerpt": {
        "first": "وَوَهَبْنَا لِدَاوُودَ سُلَيْمَانَ ۚ نِعْمَ الْعَبْدُ ۖ إِنَّهُ",
        "last": "بِغَيْرِ حِسَابٍ۳۹ وَإِنَّ لَهُ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَآبٍ۴۰"
      },
      "lines": [
        "p038-l0008"
      ]
    },
    {
      "id": "p038-s0009",
      "parentId": "p038-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(3)",
      "excerpt": {
        "first": "— وَاذْكُرْ عَبْدَنَا أَيُّوبَ n إِذْ نَادَىٰ رَبَّهُ",
        "last": "وَجَدْنَاهُ صَابِرًا ۚ نِّعْمَ الْعَبْدُ ۖ إِنَّهُ أَوَّابٌ۴۴"
      },
      "lines": [
        "p038-l0009"
      ]
    },
    {
      "id": "p038-s0010",
      "parentId": "p038-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(4)",
      "excerpt": {
        "first": "— وَاذْكُرْ عِبَادَنَا إِبْرَاهِيمَ وَإِسْحَاقَ وَيَعْقُوبَ أُولِي الْأَيْدِي",
        "last": "بِخَالِصَةٍ ذِكْرَى الدَّارِ۴۶ وَإِنَّهُمْ عِندَنَا لَمِنَ الْمُصْطَفَيْنَ الْأَخْيَارِ۴۷"
      },
      "lines": [
        "p038-l0010"
      ]
    },
    {
      "id": "p038-s0011",
      "parentId": "p038-s0006",
      "selector": "body:nth-of-type(1) > div:nth-of-type(4) > div:nth-of-type(5)",
      "excerpt": {
        "first": "— وَاذْكُرْ إِسْمَاعِيلَ وَالْيَسَعَ وَذَا",
        "last": "الْكِفْلِ ۖ وَكُلٌّ مِّنَ الْأَخْيَارِ۴۸"
      },
      "lines": [
        "p038-l0011"
      ]
    },
    {
      "id": "p038-s0012",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(5)",
      "excerpt": {
        "first": "هَـٰذَا ذِكْرٌ ۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَآبٍ۴۹ جَنَّاتِ",
        "last": "عَنْهُمُ الْأَبْصَارُ۶۳ إِنَّ ذَٰلِكَ لَحَقٌّ تَخَاصُمُ أَهْلِ النَّارِ۶۴"
      },
      "lines": [
        "p038-l0012"
      ]
    },
    {
      "id": "p038-s0013",
      "parentId": "p038-s0012",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(3)",
      "excerpt": {
        "first": "هَـٰذَا ذِكْرٌ ۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَآبٍ۴۹ جَنَّاتِ",
        "last": "الْحِسَابِ۵۳ إِنَّ هَـٰذَا لَرِزْقُنَا مَا لَهُ مِن نَّفَادٍ۵۴"
      },
      "lines": [
        "p038-l0013"
      ]
    },
    {
      "id": "p038-s0014",
      "parentId": "p038-s0012",
      "selector": "body:nth-of-type(1) > div:nth-of-type(5) > div:nth-of-type(4)",
      "excerpt": {
        "first": "هَـٰذَا ۚ وَإِنَّ لِلطَّاغِينَ لَشَرَّ مَآبٍ۵۵ جَهَنَّمَ يَصْلَوْنَهَا",
        "last": "عَنْهُمُ الْأَبْصَارُ۶۳ إِنَّ ذَٰلِكَ لَحَقٌّ تَخَاصُمُ أَهْلِ النَّارِ۶۴"
      },
      "lines": [
        "p038-l0014"
      ]
    },
    {
      "id": "p038-s0015",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(6)",
      "excerpt": {
        "first": "l إِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا",
        "last": "أَقُولُ۸۴ لَأَمْلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنْهُمْ أَجْمَعِينَ۸۵"
      },
      "lines": [
        "p038-l0015"
