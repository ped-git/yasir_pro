  "sections": [
    {
      "id": "p036-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "يس۱ وَالْقُرْآنِ الْحَكِيمِ۲ إِنَّكَ لَمِنَ الْمُرْسَلِينَ۳ عَلَىٰ صِرَاطٍ",
        "last": "وَآثَارَهُمْ ۚ وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ فِي إِمَامٍ مُّبِينٍ۱۲"
      },
      "lines": [
        "p036-l0001"
      ]
    },
    {
      "id": "p036-s0002",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "وَاضْرِبْ لَهُم مَّثَلًا أَصْحَابَ الْقَرْيَةِ إِذْ جَاءَهَا الْمُرْسَلُونَ۱۳",
        "last": "إِن كَانَتْ إِلَّا صَيْحَةً وَاحِدَةً فَإِذَا هُمْ خَامِدُونَ۲۹"
      },
      "lines": [
        "p036-l0002"
      ]
    },
    {
      "id": "p036-s0003",
      "parentId": "p036-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3)",
      "excerpt": {
        "first": "إِذْ أَرْسَلْنَا إِلَيْهِمُ اثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثٍ n",
        "last": "ۚ أَئِن ذُكِّرْتُم ۚ بَلْ أَنتُمْ قَوْمٌ مُّسْرِفُونَ۱۹"
      },
      "lines": [
        "p036-l0003"
      ]
    },
    {
      "id": "p036-s0004",
      "parentId": "p036-s0002",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَجَاءَ مِنْ أَقْصَى الْمَدِينَةِ رَجُلٌ يَسْعَىٰ u قَالَ",
        "last": "يَعْلَمُونَ۲۶ بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ الْمُكْرَمِينَ۲۷"
      },
      "lines": [
        "p036-l0004"
      ]
    },
    {
      "id": "p036-s0005",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(4)",
      "excerpt": {
        "first": "o وَيَقُولُونَ مَتَىٰ هَـٰذَا الْوَعْدُ إِن كُنتُمْ صَادِقِينَ۴۸",
        "last": "أَفْوَاهِهِمْ وَتُكَلِّمُنَا أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُوا يَكْسِبُونَ۶۵"
      },
      "lines": [
        "p036-l0005"
      ]
    }
  ]
