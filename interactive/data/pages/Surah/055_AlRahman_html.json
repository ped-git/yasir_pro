    {
      "id": "p055-s0001",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(2)",
      "excerpt": {
        "first": "الرَّحْمَـٰنُ۱ عَلَّمَ الْقُرْآنَ۲ خَلَقَ الْإِنسَانَ۳ عَلَّمَهُ الْبَيَانَ۴ الشَّمْسُ",
        "last": "نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ۳۵ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۳۶"
      },
      "lines": [
        "p055-l0001"
      ]
    },
    {
      "id": "p055-s0002",
      "parentId": "p055-s0001",
      "selector": "body:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3)",
      "excerpt": {
        "first": "سَنَفْرُغُ لَكُمْ أَيُّهَ الثَّقَلَانِ۳۱ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۳۲",
        "last": "نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ۳۵ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۳۶"
      },
      "lines": [
        "p055-l0002"
      ]
    },
    {
      "id": "p055-s0003",
      "parentId": null,
      "selector": "body:nth-of-type(1) > div:nth-of-type(3)",
      "excerpt": {
        "first": "فَإِذَا انشَقَّتِ السَّمَاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ۳۷ فَبِأَيِّ آلَاءِ",
        "last": "رَفْرَفٍ خُضْرٍ وَعَبْقَرِيٍّ حِسَانٍ۷۶ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۷۷"
      },
      "lines": [
        "p055-l0003"
      ]
    },
    {
      "id": "p055-s0004",
      "parentId": "p055-s0003",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3)",
      "excerpt": {
        "first": "يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ۴۱ فَبِأَيِّ آلَاءِ",
        "last": "بَيْنَهَا وَبَيْنَ حَمِيمٍ آنٍ۴۴ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۴۵"
      },
      "lines": [
        "p055-l0004"
      ]
    },
    {
      "id": "p055-s0005",
      "parentId": "p055-s0003",
      "selector": "body:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4)",
      "excerpt": {
        "first": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ۴۶ فَبِأَيِّ آلَاءِ رَبِّكُمَا",
        "last": "رَفْرَفٍ خُضْرٍ وَعَبْقَرِيٍّ حِسَانٍ۷۶ فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ۷۷"
      },
      "lines": [
        "p055-l0005"
      ]
    }
  ]
